#!/usr/bin/env bash
# gamescope-session-plus — portable gamescope session driver
#
# Usage: gamescope-session-plus <session-name>
#
# Sources /usr/share/gamescope-session-plus/sessions.d/<session-name> (which
# must export CLIENTCMD), applies ~/.config/environment.d/*.conf overrides,
# then execs gamescope in embedded fullscreen mode.
#
# This is a ShaniOS reimplementation of the ChimeraOS gamescope-session-plus
# framework (MIT). Shani is not SteamOS: there is no steamos-session-select,
# no bootstraplinux tarball, no frzr immutable-etc, and no device-quirks
# package, so those ChimeraOS-specific pieces are deliberately absent.
set -euo pipefail

SESSION_NAME="${1:-steam}"
SESSION_DIR="${GAMESCOPE_SESSION_DIR:-/usr/share/gamescope-session-plus/sessions.d}"
SESSION_FILE="${SESSION_DIR}/${SESSION_NAME}"

if [[ ! -f "$SESSION_FILE" ]]; then
    echo "gamescope-session-plus: unknown session '${SESSION_NAME}'" >&2
    echo "Available sessions:" >&2
    for f in "$SESSION_DIR"/*; do
        [[ -f "$f" ]] && echo "  $(basename "$f")" >&2
    done
    exit 1
fi

# Source the session definition (exports CLIENTCMD and optional helpers).
# shellcheck disable=SC1090
source "$SESSION_FILE"

if [[ -z "${CLIENTCMD:-}" ]]; then
    echo "gamescope-session-plus: session '${SESSION_NAME}' did not set CLIENTCMD" >&2
    exit 1
fi

# Apply per-user environment overrides from ~/.config/environment.d/*.conf,
# mirroring the ChimeraOS framework. These can set SCREEN_WIDTH/HEIGHT,
# INTERNAL_WIDTH/HEIGHT, ADAPTIVE_SYNC, DRM_MODE, CLIENTCMD overrides, etc.
ENV_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
if [[ -d "$ENV_DIR" ]]; then
    for conf in "$ENV_DIR"/*.conf; do
        [[ -f "$conf" ]] || continue
        # shellcheck disable=SC1090
        source "$conf"
    done
fi

# Unpack the pre-downloaded Steam client on first boot. SteamOS/Bazzite ship a
# bootstrap archive in the image; without it the first launch downloads ~600 MB
# before the login screen appears. The archive is built at image-build time by
# image_profiles/gamescope/gamescope-customization.sh.
bootstrap_steam() {
    local archive="/usr/share/gamescope-session-plus/bootstrap_steam.tar.zst"
    [[ -f "$archive" ]] || return 0

    local steam_data="${XDG_DATA_HOME:-$HOME/.local/share}/Steam"
    local prefix="$HOME/.var/app/com.valvesoftware.Steam"
    if [[ -d "$prefix" || "$CLIENTCMD" == *"com.valvesoftware.Steam"* ]]; then
        # The Steam Flatpak redirects XDG dirs to
        # ~/.var/app/com.valvesoftware.Steam (FLATPAK_STEAM_XDG_DIRS_PREFIX).
        steam_data="$prefix/.local/share/Steam"
        mkdir -p "$prefix/.local/share"
        ln -sfn .local/share/Steam "$prefix/.steam"
    fi

    if [[ ! -f "$steam_data/package/steam_client_steamrt64.installed" ]]; then
        echo "gamescope-session-plus: unpacking the Steam bootstrap into $steam_data" >&2
        mkdir -p "$steam_data"
        tar --use-compress-program="zstd -d" -xf "$archive" -C "$steam_data" --strip-components=1
    fi
}
bootstrap_steam

# Gamescope is a Wayland compositor, but Steam's UI is X11; SteamOS and
# ChimeraOS both run the session as an X11 session so the client's gamescope
# integration works. Keep the environment consistent for the Flatpak Steam.
export XDG_SESSION_TYPE=x11
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd $(env | grep '^XDG_' | cut -d = -f 1) 2>/dev/null || true
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user set-environment XDG_DESKTOP_PORTAL_DIR="" 2>/dev/null || true
    systemctl --user unset-environment DISPLAY XAUTHORITY 2>/dev/null || true
fi

# Steam's "Automatically Set Resolution" option and gamescope's mode/EDID
# caches live in the user's home, so they persist across boots.
export GAMESCOPE_MODE_SAVE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/modes.cfg"
export GAMESCOPE_PATCHED_EDID_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gamescope/edid.bin"
mkdir -p "$(dirname "$GAMESCOPE_MODE_SAVE_FILE")"
touch "$GAMESCOPE_MODE_SAVE_FILE" "$GAMESCOPE_PATCHED_EDID_FILE"

# Steam's gamescope WSI layer (HDR/VRR/fps limiter integration).
export ENABLE_GAMESCOPE_WSI=1

# Resolve output (display) vs. internal (render) dimensions.
SCREEN_WIDTH="${SCREEN_WIDTH:-}"
SCREEN_HEIGHT="${SCREEN_HEIGHT:-}"
INTERNAL_WIDTH="${INTERNAL_WIDTH:-$SCREEN_WIDTH}"
INTERNAL_HEIGHT="${INTERNAL_HEIGHT:-$SCREEN_HEIGHT}"

# --steam is gamescope's Steam integration (short form -e); --xwayland-count 2
# gives the Steam UI and a game separate XWayland servers, matching SteamOS.
GAMESCOPE_ARGS=(--steam -f --xwayland-count 2)
if [[ -n "$SCREEN_WIDTH" && -n "$SCREEN_HEIGHT" ]]; then
    GAMESCOPE_ARGS+=(-W "$SCREEN_WIDTH" -H "$SCREEN_HEIGHT")
fi
if [[ -n "$INTERNAL_WIDTH" && -n "$INTERNAL_HEIGHT" ]]; then
    GAMESCOPE_ARGS+=(-w "$INTERNAL_WIDTH" -h "$INTERNAL_HEIGHT")
fi
if [[ "${ADAPTIVE_SYNC:-0}" == "1" ]]; then
    GAMESCOPE_ARGS+=(--adaptive-sync)
fi
if [[ -n "${DRM_MODE:-}" ]]; then
    GAMESCOPE_ARGS+=(--generate-drm-mode "$DRM_MODE")
fi
if [[ "${ENABLE_GAMESCOPE_HDR:-0}" == "1" ]]; then
    GAMESCOPE_ARGS+=(--hdr-enabled --hdr-itm-enabled \
        --hdr-sdr-content-nits "${GAMESCOPE_HDR_NITS:-400}" \
        --hdr-itm-sdr-nits "${GAMESCOPE_HDR_NITS:-400}")
fi

# If the caller gave an explicit gamescope command, use it verbatim.
if [[ -n "${GAMESCOPECMD:-}" ]]; then
    exec $GAMESCOPECMD
fi

exec gamescope "${GAMESCOPE_ARGS[@]}" -- $CLIENTCMD