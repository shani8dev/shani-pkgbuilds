# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
# Hunspell dictionary for Gujarati (gu_IN), sourced from the
# LibreOffice dictionaries project, which ships no versioned release:
# the source is pinned to a full commit hash instead (bump pkgrel
# whenever _commit changes — see README.md "Updating a pinned-commit
# package"). Part of the Indian-language set, which also includes
# Marathi (hunspell-mr_in) and Tamil (hunspell-ta_in).
pkgname=hunspell-gu_in
pkgver=1.0
_commit=4f1df64b2e8e14751aa7c2205d170ca016071315
pkgrel=1
pkgdesc="Gujarati hunspell dictionary"
arch=('any')
url="https://github.com/LibreOffice/dictionaries/tree/master/gu_IN"
license=('GPL-2.0-or-later')
depends=('hunspell')
source=("gu_IN.dic::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/gu_IN/gu_IN.dic"
        "gu_IN.aff::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/gu_IN/gu_IN.aff")
sha256sums=('6039093a92e927a1ff08b756bd5cb5a8ad50700254f6d07bb81d7f2ac50ac364'
            '79e7588cd644906e55b5cff8b78a47f285d94091f8d7d0e2855678caee4fdb26')

package() {
  install -Dm644 "$srcdir/gu_IN.dic" "$pkgdir/usr/share/hunspell/gu_IN.dic"
  install -Dm644 "$srcdir/gu_IN.aff" "$pkgdir/usr/share/hunspell/gu_IN.aff"
}
