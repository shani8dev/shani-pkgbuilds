# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
# Hunspell dictionary for Marathi (mr_IN), sourced from the
# LibreOffice dictionaries project, which ships no versioned release:
# the source is pinned to a full commit hash instead (bump pkgrel
# whenever _commit changes — see README.md "Updating a pinned-commit
# package").
pkgname=hunspell-mr_in
pkgver=1.0
_commit=4f1df64b2e8e14751aa7c2205d170ca016071315
pkgrel=1
pkgdesc="Marathi hunspell dictionary"
arch=('any')
url="https://github.com/LibreOffice/dictionaries/tree/master/mr_IN"
license=('GPL-2.0-only')
depends=('hunspell')
source=("mr_IN.dic::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/mr_IN/mr_IN.dic"
        "mr_IN.aff::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/mr_IN/mr_IN.aff")
sha256sums=('fe1112d88208b928dc2cca76f18bc3161b99c67b483778ed67fe5877461eb25a'
            'f870dde7dc0e50b15467b159c3c4c893c339936f1aa3642a4ab3303a13510ed9')

package() {
  install -Dm644 "$srcdir/mr_IN.dic" "$pkgdir/usr/share/hunspell/mr_IN.dic"
  install -Dm644 "$srcdir/mr_IN.aff" "$pkgdir/usr/share/hunspell/mr_IN.aff"
}
