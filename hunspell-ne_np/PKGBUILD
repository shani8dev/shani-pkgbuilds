# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
# Hunspell dictionary for Nepali (ne_NP), sourced from the
# LibreOffice dictionaries project, which ships no versioned release:
# the source is pinned to a full commit hash instead (bump pkgrel
# whenever _commit changes — see README.md "Updating a pinned-commit
# package"). Marathi (mr_IN) and Tamil (ta_IN) are not included in
# this set of packages.
pkgname=hunspell-ne_np
pkgver=1.0
_commit=4f1df64b2e8e14751aa7c2205d170ca016071315
pkgrel=1
pkgdesc="Nepali hunspell dictionary"
arch=('any')
url="https://github.com/LibreOffice/dictionaries/tree/master/ne_NP"
license=('LGPL-2.1-only')
depends=('hunspell')
source=("ne_NP.dic::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/ne_NP/ne_NP.dic"
        "ne_NP.aff::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/ne_NP/ne_NP.aff")
sha256sums=('f3e8877d0f7f12c3ab7ef812388a77c20a9fcd3f8cc24d973709ec517150598d'
            'ab53d76a82da5229d484ce0d4c892f6c1ffba5fddeb7bac73685cbf590ae130d')

package() {
  install -Dm644 "$srcdir/ne_NP.dic" "$pkgdir/usr/share/hunspell/ne_NP.dic"
  install -Dm644 "$srcdir/ne_NP.aff" "$pkgdir/usr/share/hunspell/ne_NP.aff"
}
