# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
# Hunspell dictionary for Sinhala (si_LK), sourced from the
# LibreOffice dictionaries project, which ships no versioned release:
# the source is pinned to a full commit hash instead (bump pkgrel
# whenever _commit changes — see README.md "Updating a pinned-commit
# package"). Part of the Indian-language set, which also includes
# Marathi (hunspell-mr_in) and Tamil (hunspell-ta_in).
pkgname=hunspell-si_lk
pkgver=1.0
_commit=4f1df64b2e8e14751aa7c2205d170ca016071315
pkgrel=1
pkgdesc="Sinhala hunspell dictionary"
arch=('any')
url="https://github.com/LibreOffice/dictionaries/tree/master/si_LK"
license=('GPL-3.0-or-later')
depends=('hunspell')
source=("si_LK.dic::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/si_LK/si_LK.dic"
        "si_LK.aff::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/si_LK/si_LK.aff")
sha256sums=('d6ce8cef2bbf184459bb3073d2ddc246afa914efaf8fc438b32e8d7724abfcfd'
            'd188ccc49f06ce50ccb80ab9f3d08808dfb5caeb039c09cde55c8664ca6d8643')

package() {
  install -Dm644 "$srcdir/si_LK.dic" "$pkgdir/usr/share/hunspell/si_LK.dic"
  install -Dm644 "$srcdir/si_LK.aff" "$pkgdir/usr/share/hunspell/si_LK.aff"
}
