# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
# Hunspell dictionary for Tamil (ta_IN), sourced from the
# LibreOffice dictionaries project, which ships no versioned release:
# the source is pinned to a full commit hash instead (bump pkgrel
# whenever _commit changes — see README.md "Updating a pinned-commit
# package").
pkgname=hunspell-ta_in
pkgver=1.0
_commit=4f1df64b2e8e14751aa7c2205d170ca016071315
pkgrel=1
pkgdesc="Tamil hunspell dictionary"
arch=('any')
url="https://github.com/LibreOffice/dictionaries/tree/master/ta_IN"
license=('MPL-1.1')
depends=('hunspell')
source=("ta_IN.dic::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/ta_IN/ta_IN.dic"
        "ta_IN.aff::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/ta_IN/ta_IN.aff")
sha256sums=('4c079bde24d3232d4195e78bd33bbe5fcb887ceb6363065574cec048d04bc756'
            'e05c53e643a141efc1e9c00c5f6532a6fd8ac547b998e1347aa8aea5817f2e15')

package() {
  install -Dm644 "$srcdir/ta_IN.dic" "$pkgdir/usr/share/hunspell/ta_IN.dic"
  install -Dm644 "$srcdir/ta_IN.aff" "$pkgdir/usr/share/hunspell/ta_IN.aff"
}
