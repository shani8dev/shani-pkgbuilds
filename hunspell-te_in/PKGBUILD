# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
# Hunspell dictionary for Telugu (te_IN), sourced from the
# LibreOffice dictionaries project, which ships no versioned release:
# the source is pinned to a full commit hash instead (bump pkgrel
# whenever _commit changes — see README.md "Updating a pinned-commit
# package"). Marathi (mr_IN) and Tamil (ta_IN) are not included in
# this set of packages.
pkgname=hunspell-te_in
pkgver=1.0
_commit=4f1df64b2e8e14751aa7c2205d170ca016071315
pkgrel=1
pkgdesc="Telugu hunspell dictionary"
arch=('any')
url="https://github.com/LibreOffice/dictionaries/tree/master/te_IN"
license=('GPL-2.0-or-later')
depends=('hunspell')
source=("te_IN.dic::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/te_IN/te_IN.dic"
        "te_IN.aff::https://raw.githubusercontent.com/LibreOffice/dictionaries/${_commit}/te_IN/te_IN.aff")
sha256sums=('d8f2eb5301199b1e8874545c9ffc5058fc1d2cc76ea1fdf0765338501906b719'
            '24883e46a03ebb381f40ce2c0ae59c30c6e3e14808de224c0005935bf3565b1e')

package() {
  install -Dm644 "$srcdir/te_IN.dic" "$pkgdir/usr/share/hunspell/te_IN.dic"
  install -Dm644 "$srcdir/te_IN.aff" "$pkgdir/usr/share/hunspell/te_IN.aff"
}
