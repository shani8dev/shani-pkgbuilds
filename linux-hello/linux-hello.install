post_install() {
    cat <<'MSG'
Face sign-in: Settings > Account > Sign in faster turns it on and sets up your
face, on a computer with an infrared camera. It stays off until then.
(Its own `linux-hello enable` rewrites /etc/pam.d/system-auth - not needed here.)
MSG
}
post_upgrade() {
    systemctl daemon-reload 2>/dev/null
    systemctl try-restart linux-hello.service 2>/dev/null || true
}
pre_remove() {
    systemctl disable --now linux-hello.service 2>/dev/null || true
}
