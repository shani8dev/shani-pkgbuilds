index 3bf5b25..b08f5cb 100644
--- a/crates/linux-hellod/src/main.rs
+++ b/crates/linux-hellod/src/main.rs
@@ -106,6 +106,26 @@ fn main() -> Result<(), Box<dyn std::error::Error>> {
 
 
 
+/// Whether the process at the other end of the socket may make this request: the
+/// socket is open to every local user (PAM runs in the screen locker as the user),
+/// so a request naming a user is served only for root or that same user. Without
+/// this, anyone could enroll their own face as another account - root included.
+fn peer_may_ask(stream: &UnixStream, req: &Request) -> bool {
+    use nix::sys::socket::{getsockopt, sockopt::PeerCredentials};
+    let username = match req {
+        Request::Authenticate { username, .. } | Request::Enroll { username, .. } => username,
+        Request::Status => return true,
+    };
+    let uid = match getsockopt(stream, PeerCredentials) {
+        Ok(cred) => cred.uid(),
+        Err(_) => return false,
+    };
+    if uid == 0 {
+        return true;
+    }
+    matches!(nix::unistd::User::from_name(username), Ok(Some(user)) if user.uid.as_raw() == uid)
+}
