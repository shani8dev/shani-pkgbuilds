# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=os-installer-git
pkgver=0.6.14
pkgrel=1
pkgdesc='ShaniOS operating system installer (GTK4/libadwaita), git snapshot'
url='https://github.com/shani8dev/os-installer'
# Tracks the fork's main. Pinned to a commit rather than a branch so the
# package is reproducible and check-skip-checksums.sh can accept the SKIP:
# bump _commit (and pkgrel) to pick up new commits. All ShaniOS fixes are
# commits in that repo — this PKGBUILD applies no patches.
_commit='fab1a75cd189bc75b34ad31bc79a72d91e45720f'
source=("git+${url}.git#commit=$_commit")
sha256sums=('SKIP')
arch=('x86_64')
license=('GPL-3.0-or-later')
provides=('os-installer')
conflicts=('os-installer')
makedepends=('git' 'meson' 'appstream-glib' 'blueprint-compiler')
depends=('gnome-desktop-4' 'gtk4' 'libadwaita' 'libgweather-4' 'python-yaml' 'udisks2' 'vte4' 'python-gobject')
optdepends=('epiphany: online assistance'
            'gnome-disk-utility: manual disk partitioning'
            'gnome-control-center: Wi-Fi setup')

build () {
	cd "$srcdir/os-installer"
	meson setup --prefix=/usr build
}

package() {
	cd "$srcdir/os-installer"
	meson install -C build --destdir "$pkgdir"
}
