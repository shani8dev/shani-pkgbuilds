# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=os-installer
pkgver=0.6.13
pkgrel=1
pkgdesc='ShaniOS operating system installer (GTK4/libadwaita)'
url='https://github.com/shani8dev/os-installer'
# First-party fork; the ShaniOS fixes that used to live in *.patch files here
# are ordinary commits in that repo. Pinned to the commit tag v0.6.13 points
# at (resolved via `git ls-remote --tags`): an annotated tag object can be
# force-moved upstream without this PKGBUILD ever changing, and
# check-skip-checksums.sh correctly treats a bare `#tag=` git+ source with
# SKIP as unverified.
_commit='d3fc4ce567e390aa2101daf07081c23f22da204c'
source=("git+${url}.git#commit=$_commit")
sha256sums=('SKIP')
arch=('x86_64')
license=('GPL-3.0-or-later')
makedepends=('git' 'meson' 'appstream-glib' 'blueprint-compiler')
depends=('gnome-desktop-4' 'gtk4' 'libadwaita' 'libgweather-4' 'python-yaml' 'udisks2' 'vte4' 'python-gobject')
optdepends=('epiphany: online assistance'
            'gnome-disk-utility: manual disk partitioning'
            'gnome-control-center: Wi-Fi setup')

build () {
	cd "$srcdir/$pkgname"
	meson setup --prefix=/usr build
}

package() {
	cd "$srcdir/$pkgname"
	meson install -C build --destdir "$pkgdir"
}
