# shani-backup.install

post_install() {
    # Compile GSettings schemas
    glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 || true
}

post_upgrade() {
    post_install "$1"
}

pre_remove() {
    # Stop and disable the scheduler service if it exists
    systemctl stop shani-backup-scheduler.service >/dev/null 2>&1 || true
    systemctl disable shani-backup-scheduler.service >/dev/null 2>&1 || true
}

post_remove() {
    post_install "$1"
}