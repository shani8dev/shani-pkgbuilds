	depends = espeak-ng
	depends = libsecret
	depends = psmisc
	depends = i2c-tools
	depends = polkit
	depends = bluez
	optdepends = ollama: run the language model on this computer
	optdepends = whisper-cpp: voice input (speech recognition)
	optdepends = rhvoice-language-english: a more natural voice than espeak-ng (with a rhvoice-voice-* such as rhvoice-voice-slt)
	optdepends = rhvoice-voice-slt: an English RHVoice voice
	optdepends = python-numpy: wake-word activation (with python-openwakeword)
	optdepends = python-mcp: shani-chronoa-mcp, Chronoa skills as an MCP server
