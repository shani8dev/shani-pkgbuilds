pkgbase = shani-chronoa
	pkgdesc = Chronoa - the Shanios voice and text assistant (local-first)
	pkgver = 0.1.0
	pkgrel = 55
	url = https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-chronoa
	arch = any
	license = GPL-3.0-only
	makedepends = git
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	depends = python-httpx
	depends = python-symengine
	depends = bc
	depends = pipewire
	depends = wireplumber
	depends = libnotify
	depends = upower
	depends = bubblewrap
	depends = tesseract
	depends = tesseract-data-eng
	depends = whisper-cpp
	depends = llama-cpp
	depends = ggml-vulkan
	depends = espeak-ng
	depends = libsecret
	depends = psmisc
	depends = i2c-tools
	depends = polkit
	depends = bluez
	depends = bluez-utils
	depends = wl-clipboard
	depends = pciutils
	depends = usbutils
	depends = smartmontools
	depends = power-profiles-daemon
	depends = udisks2
	depends = cups
	depends = sane
	depends = nmap
	depends = networkmanager
	optdepends = python-polars: learning.py reads tool_calls.log into dataframes; absent, it reads json per line
	optdepends = sox: speak - pitch, tempo and rate (tts.py apply_timbre)
	optdepends = soundtouch: soundstretch, which shifts each sung note to its own pitch (prosody.apply_song; sox cannot do this)
	optdepends = rubberband: the higher-quality pitch shifter, used when soundtouch is absent (prosody.apply_song)
	optdepends = libpulse: pactl, for bridging the audio of a Bluetooth call to this computer (bluetooth_call)
	optdepends = rtl-sdr: rtl_fm, which receives FM from an RTL2832U DVB-T dongle (fm_radio)
	optdepends = bluez-obex: obexd - send and receive files, phone contacts, call history and text messages over plain Bluetooth (no app on the phone)
	optdepends = geoclue: where this computer is, for get_location and local weather (GNOME’s location service)
	optdepends = gpsd: a GPS receiver’s fix for get_location, when one is attached
	optdepends = ollama: an alternative local model server (Chronoa prefers it when running; llama-cpp is the default)
	optdepends = rhvoice-language-english: a more natural voice than espeak-ng (with a rhvoice-voice-* such as rhvoice-voice-slt)
	optdepends = rhvoice-voice-slt: an English RHVoice voice
	optdepends = python-mcp: shani-chronoa-mcp, Chronoa skills as an MCP server
	optdepends = translate-shell: translate_text runs locally on trans instead of falling back to sending the text to a web service
	optdepends = ffmpeg: convert_media - audio and video conversion
	optdepends = imagemagick: edit_image - resize, compress, crop and convert pictures
	optdepends = poppler: read_document - text out of PDFs (pdftotext); office_document pdf_images (pdfimages)
	optdepends = git: the git sense and git_inspect
	optdepends = flatpak: install_app and cleanup_report
	optdepends = plocate: find_files - instant file-name search
	optdepends = tealdeer: explain_command - short examples for a command (tldr)
	optdepends = btrfs-progs: the snapshots sense
	optdepends = firewalld: the firewall sense (firewall-cmd)
	optdepends = nftables: the firewall sense, for rules set outside firewalld
	optdepends = binutils: readelf, which inspect_binary uses to read a program and binary_hardening uses to report whether it is hardened
	optdepends = mesa-utils: glxinfo, which reports the OpenGL renderer string (graphics_stack)
	optdepends = nethogs: nethogs, which reports per-program network traffic (network_activity)
	optdepends = iptables: the firewall sense, legacy rules
	optdepends = ethtool: the network sense - link speed and driver
	optdepends = ddcutil: set_brightness on an external monitor
	optdepends = liquidctl: the hwmon sense - liquid coolers and fan controllers
	optdepends = vnstat: data_usage - how much the network moved
	optdepends = tailscale: tailscale_status
	optdepends = xorg-setxkbmap: set_keyboard_layout in an X11 session
	optdepends = kconfig: set_theme on Plasma (kreadconfig6)
	optdepends = plasma-workspace: set_theme on Plasma 6 (plasma-apply-colorscheme)
	optdepends = libkscreen: set_scaling on Plasma (kscreen-doctor)
	optdepends = pacman-contrib: check_updates - pending updates without touching the sync database (checkupdates)
	optdepends = android-tools: android_device - a phone over USB debugging (adb)
	optdepends = zbar: qr_code - read QR codes and barcodes (zbarimg)
	optdepends = qrencode: qr_code - make QR codes
	optdepends = at-spi2-core: ui_elements - buttons, fields and menus of other apps over AT-SPI
	optdepends = webkitgtk-6.0: the in-app browser, and attaching a page to the conversation
	optdepends = python-onnxruntime-cpu: remove_background for any object (u2net), not only people
	optdepends = avahi: discover_hosts - devices that announce themselves by name (avahi-browse)
	optdepends = iproute2: check_internet and neighbour_table - the route and the ARP cache (ip neigh)
	optdepends = fwupd: firmware_updates - which firmware this machine is running (fwupdmgr get-devices)
	source = git+https://github.com/shani8dev/shani-chronoa.git#commit=d077ede6996b26980466d1d79be878d6ca3b29c3
	sha256sums = SKIP

pkgname = shani-chronoa
