# shani-chronoa PKGBUILD
# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>

pkgname=shani-chronoa
pkgver=0.1.0
pkgrel=53
pkgdesc="Chronoa - the Shanios voice and text assistant (local-first)"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-chronoa"
license=('GPL-3.0-only')
depends=(
    'python'
    'python-gobject'
    'gtk4'
    'libadwaita'
    'python-httpx'
    # solve_math.py's two engines, both required for it to be more than a
    # calculator: symengine does the exact algebra (derivative, series,
    # expand, factor, prime_factors, is_prime, linear solve) and bc runs the
    # exact rational arithmetic Matrix.solve cannot do (symengine's solve
    # segfaults, so the Gaussian elimination is done over Fractions in bc).
    # Without either it says which package to install instead of guessing.
    'python-symengine'
    'bc'
    'pipewire'
    'wireplumber'
    'libnotify'
    'upower'
    'bubblewrap'
    'tesseract'
    'tesseract-data-eng'
    'whisper-cpp' # whisper-cpp: voice input (speech recognition)
    # The on-machine language model (local_llm.py): llama.cpp's llama-server.
    # ggml-vulkan lets it use any GPU with a Vulkan driver (Intel, AMD, NVIDIA)
    # and costs nothing on a CPU-only machine, where ggml runs on the processor.
    'llama-cpp'
    'ggml-vulkan'
    'espeak-ng'
    'libsecret'

    # The machine-state senses shell out to these. Declared because this
    # package uses them, not because the image is missing them: psmisc and
    # polkit are preinstalled in the ShaniOS base images (confirmed by
    # slot-test's dep-present-* assertions passing on a base-image slot with
    # no chronoa package installed) and all four resolve from the Arch repos -
    # psmisc 23.7-2 in core, polkit/i2c-tools/bluez in extra. Declaring them
    # keeps the package correct on a minimal Arch, and pacman treats an
    # already-satisfied dep as satisfied.
    #
    # Why they matter: without one, its sense degrades to reporting UNKNOWN
    # rather than a fact, which is honest but much less useful. `fuser` is the
    # sharpest case - the contention sense previously swallowed its absence
    # and reported every microphone and camera as free, which is the exact
    # inverse of the thing it exists to report.
    'psmisc'      # fuser - device holder lookup
    'i2c-tools'   # i2cdetect - thermal-array probe
    'polkit'      # pkexec - opt-in root scan for the same
    'bluez'       # the Bluetooth daemon the device inventory talks to
    'bluez-utils' # bluetoothctl itself. Arch ships it apart from bluez, so
                  # declaring only bluez left bluetooth, bluetooth_devices and
                  # toggle_bluetooth working only because the image pulled
                  # bluez-utils in by another route (cli_matrix --audit-packaging,
                  # 2026-10-01: bluetoothctl is owned by bluez-utils on both images).
    'wl-clipboard' # wl-copy/wl-paste - every clipboard skill on a Wayland desktop,
                  # which is all three Shanios desktops; xclip/xsel are X11 only.
    'pciutils'    # lspci - PCI and GPU inventory. Was declared nowhere at all,
                  # so the devices and gpu senses degraded to UNKNOWN on every
                  # install rather than reporting a fact.
    'usbutils'    # lsusb - the USB half of the device inventory
    'smartmontools' # smartctl - drive health. Was only in the image manifest,
                  # so a user installing the package on plain Arch got a sense
                  # that could never read a drive.
      'power-profiles-daemon' # powerprofilesctl - the power-profile skill
      # The actuators added after the senses above. Same reasoning: this package
      # invokes them, so declaring them is what keeps it correct on a minimal
      # Arch. `systemd` is deliberately absent - systemctl, journalctl,
      # timedatectl and udevadm come from it and no real install lacks it, so
      # declaring it would be noise rather than a constraint.
      'udisks2'       # udisksctl - manage_mount. Not optional in the way the
                      # others are: the skill deliberately has no bare-`mount`
                      # fallback, because that would bypass the polkit rules
                      # which are the only reason it is safe to offer. Without
                      # udisksctl it can never work, and says so rather than
                      # quietly escalating. Named udisks2, not udisks -
                      # confirmed by listing the cached 2.11.2-1 tarball, which
                      # ships usr/bin/udisksctl.
      'cups'          # lpstat - the printing sense
      'sane'          # scanimage - the scan half of printing. Arch renamed
                      # this from sane-utils; confirmed by listing the cached
                      # sane-1.4.0-4 tarball, which ships usr/bin/scanimage.
      'nmap'          # nmap - scan_network
      'networkmanager' # nmcli - Wi-Fi listing and connection
)

optdepends=(
    # The learning engine (learning.py) is standard library only by design -
    # "polars is optional and used for nothing but reading the log faster",
    # in its own words. Declared so that what it can use is visible; the
    # standard-library path is what actually runs without it.
    'python-polars: learning.py reads tool_calls.log into dataframes; absent, it reads json per line'
    # Pitch, tempo and rate are sox's job, applied once after whichever engine
    # produced the WAV (tts.py apply_timbre). tts.py calls it an optdepend and
    # never a hard one: without it speak says which transform was skipped.
    'sox: speak - pitch, tempo and rate (tts.py apply_timbre)'
    # **The singing path, which sox alone cannot do.** `prosody.apply_song()`
    # cuts and joins the notes in Python and hands each one to a transposer to
    # move it by its own number of semitones; `_best_transposer()` looks for
    # `soundstretch` then `rubberband`. Without either, `apply_song` raises
    # `SingingUnsupported` naming both packages, so `sing` cannot put a melody
    # on one syllable at a time - which is the whole difference between singing
    # and intonation, and the property `tests/test_prosody.py` measures.
    # sox is not a substitute: `sox` pitch shifts a whole file in one go, which is
    # the intonation path the per-syllable design replaced.
    #
    # Declared here and missing until now, while `DEBIAN/control` has carried
    # both since it was written - so on every Arch install `sing` refused for a
    # reason nobody could act on. Package names read out of pacman's own file
    # database (`chronoa-matrix.json`: `/usr/bin/soundstretch` -> `soundtouch`,
    # `/usr/bin/rubberband` -> `rubberband`), not guessed.
    # No apostrophes: these sit inside single quotes and one `'` closes the
    # string early, which is a syntax error that stops the whole PKGBUILD
    # parsing - the mistake `bash -n` is the only guard against.
    'soundtouch: soundstretch, which shifts each sung note to its own pitch (prosody.apply_song; sox cannot do this)'
    'rubberband: the higher-quality pitch shifter, used when soundtouch is absent (prosody.apply_song)'
    # `bluetooth_call`'s audio half. The profile switch needs only wpctl, which
    # wireplumber already provides, but bridging the call's voice to this
    # computer's speakers and back from the microphone needs pactl to load
    # PipeWire's loopback and echo-cancel modules. Without it the skill still
    # dials, answers and hangs up, and says by name that the audio cannot be
    # bridged - which is the whole point of it being an optdepend rather than
    # either a hard dependency or silently absent.
    # No apostrophe in these descriptions: they sit inside single quotes, and
    # one `'` closes the string early - which is a *syntax error*, so the whole
    # PKGBUILD stops parsing and makepkg cannot build the package at all.
    'libpulse: pactl, for bridging the audio of a Bluetooth call to this computer (bluetooth_call)'
    # `fm_radio` receives FM through an RTL2832U DVB-T dongle, and the tool it
    # shells to is `rtl_fm` - which is not in a package called rtl_fm. It ships
    # in `rtl-sdr`, the same shape as `bluetoothctl` in bluez-utils and `wpctl`
    # in wireplumber, and the package name was read out of pacman's own file
    # database rather than guessed (which is what `files._PACKAGE_HINTS` carries
    # and what `tests/test_package_names_match_arch.py` now checks against the
    # matrix). Measured: rtl-sdr 1:2.0.3-1 in extra, ships /usr/bin/rtl_fm.
    #
    # An optdepend rather than a hard one, because the dongle is hardware not
    # every machine has, and `fm_radio` reports by name that the receiver is
    # absent rather than failing silently - the same discipline as pactl for
    # bluetooth_call above. `shani-peripherals` now carries rtl-sdr as a
    # depends, so on every profile that installs both, it is already there; this
    # entry is what makes the requirement visible from HERE, so a change to that
    # package's dependency list cannot break fm_radio without a named cause.
    # No apostrophe in the description: it sits inside single quotes, and one '
    # closes the string early - a syntax error that stops the whole PKGBUILD
    # parsing, which is the mistake the comments above record.
    'rtl-sdr: rtl_fm, which receives FM from an RTL2832U DVB-T dongle (fm_radio)'
    'bluez-obex: obexd - send and receive files, phone contacts, call history and text messages over plain Bluetooth (no app on the phone)'
    'geoclue: where this computer is, for get_location and local weather (GNOME’s location service)'
    'gpsd: a GPS receiver’s fix for get_location, when one is attached'
    'ollama: an alternative local model server (Chronoa prefers it when running; llama-cpp is the default)'
    'rhvoice-language-english: a more natural voice than espeak-ng (with a rhvoice-voice-* such as rhvoice-voice-slt)'
    'rhvoice-voice-slt: an English RHVoice voice'
      'python-mcp: shani-chronoa-mcp, Chronoa skills as an MCP server'
      'translate-shell: translate_text runs locally on trans instead of falling back to sending the text to a web service'
      # Found by tools/cli_matrix.py --audit-packaging --strict (2026-10-01): each
      # is run by a skill or sense, and was declared nowhere - it worked only
      # because the image happened to pull it in by another route.
      'ffmpeg: convert_media - audio and video conversion'
      'imagemagick: edit_image - resize, compress, crop and convert pictures'
      'poppler: read_document - text out of PDFs (pdftotext); office_document pdf_images (pdfimages)'
      'git: the git sense and git_inspect'
      'flatpak: install_app and cleanup_report'
      'plocate: find_files - instant file-name search'
      'tealdeer: explain_command - short examples for a command (tldr)'
      'btrfs-progs: the snapshots sense'
      'firewalld: the firewall sense (firewall-cmd)'
      'nftables: the firewall sense, for rules set outside firewalld'
      'iptables: the firewall sense, legacy rules'
      'ethtool: the network sense - link speed and driver'
      'ddcutil: set_brightness on an external monitor'
      'liquidctl: the hwmon sense - liquid coolers and fan controllers'
      'vnstat: data_usage - how much the network moved'
      'tailscale: tailscale_status'
      'xorg-setxkbmap: set_keyboard_layout in an X11 session'
      'kconfig: set_theme on Plasma (kreadconfig6)'
      'plasma-workspace: set_theme on Plasma 6 (plasma-apply-colorscheme)'
      'libkscreen: set_scaling on Plasma (kscreen-doctor)'
      'pacman-contrib: check_updates - pending updates without touching the sync database (checkupdates)'
      # Surface harvest 2026-10-02 (CHRONOA-HARVEST.md Part 6); each found unused on both images by the matrix
      'android-tools: android_device - a phone over USB debugging (adb)'
      'zbar: qr_code - read QR codes and barcodes (zbarimg)'
      'qrencode: qr_code - make QR codes'
      'at-spi2-core: ui_elements - buttons, fields and menus of other apps over AT-SPI'
      # The in-app browser (Ctrl+Shift+U, app.open-browser). Optional by design:
      # without WebKitGTK the action is insensitive and says which package is
      # missing; nothing else about the assistant changes. `gui/browser.py` asks
      # gi for the GTK4 namespace WebKit 6.0, which is `webkitgtk-6.0`
      # (usr/lib/girepository-1.0/WebKit-6.0.typelib). This used to name
      # webkit2gtk-4.1, which is the GTK3 build and ships only WebKit2-4.1 - it
      # cannot load into a GTK4 process, so the browser never started with it.
      # Checked against both packages in the pacman cache, 2026-10-08.
      'webkitgtk-6.0: the in-app browser, and attaching a page to the conversation'
      # Background removal for objects (u2net) rather than people (PP-HumanSeg,
      # which needs only the OpenCV extra setup installs). Without it
      # remove_background says exactly what is missing instead of quietly
      # falling back to the people-only model, which would return a wrong
      # cut-out for any subject that is not a person.
      'python-onnxruntime-cpu: remove_background for any object (u2net), not only people'
      # Matrix enrichments 2026-10-10; package names read out of BOTH images'
      # matrices, which carry pacman's own file database (they agree on every
      # one): `/usr/bin/avahi-browse` is in `avahi`, `ip` in `iproute2`,
      # `fwupdmgr` in `fwupd`. Offered, never required - each skill degrades to
      # an answer that names the missing tool, which is what their tests assert.
      #
      # `avahi` was NEWLY missing: discover_hosts' mDNS half had never been
      # offered the package that ships it, so it refused with a reason nobody
      # could act on. `iproute2` and `fwupd` had been missing since the skills
      # that use them were written - the same defect, only older.
      'avahi: discover_hosts - devices that announce themselves by name (avahi-browse)'
      'iproute2: check_internet and neighbour_table - the route and the ARP cache (ip neigh)'
      'fwupd: firmware_updates - which firmware this machine is running (fwupdmgr get-devices)'
  )
makedepends=('git')
source=("git+https://github.com/shani8dev/shani-chronoa.git#commit=8a0b2afc550ad522139d1d610dcef8fb30db2ac7")
# git+ pinned to a commit: makepkg ignores checksums for VCS sources, so
# the pin is the anchor (what check-skip-checksums.sh checks).
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 usr/bin/shani-chronoa "$pkgdir/usr/bin/shani-chronoa"
    install -Dm755 usr/bin/shani-chronoa-mcp "$pkgdir/usr/bin/shani-chronoa-mcp"
    install -Dm755 usr/bin/shani-chronoa-sense "$pkgdir/usr/bin/shani-chronoa-sense"
    install -Dm755 usr/bin/shani-chronoa-search "$pkgdir/usr/bin/shani-chronoa-search"
    install -Dm755 usr/bin/shani-chronoa-daemon "$pkgdir/usr/bin/shani-chronoa-daemon"
    install -Dm755 usr/bin/shani-chronoa-bridge "$pkgdir/usr/bin/shani-chronoa-bridge"
    # The lab_network_* skills' privileged half: lab_network.py runs
    # `pkexec /usr/bin/shani-chronoa-lab-network` for the namespace/NAT work
    # and the polkit rule in shani-settings authorises exactly this path. A
    # skill that invokes a binary the package does not install reports "not
    # installed" on every machine.
    install -Dm755 usr/bin/shani-chronoa-lab-network "$pkgdir/usr/bin/shani-chronoa-lab-network"
    # Background mode: installed, never enabled by default (the Settings switch enables it)
    install -Dm644 usr/lib/systemd/user/shani-chronoa-daemon.service \
        "$pkgdir/usr/lib/systemd/user/shani-chronoa-daemon.service"
    install -Dm644 usr/lib/systemd/user/shani-chronoa-llm.service \
        "$pkgdir/usr/lib/systemd/user/shani-chronoa-llm.service"
    install -Dm644 "usr/lib/systemd/user/shani-chronoa-model@.service" \
        "$pkgdir/usr/lib/systemd/user/shani-chronoa-model@.service"
    # Desktop search: GNOME Shell overview + Plasma KRunner, one D-Bus activated service
    install -Dm644 usr/share/dbus-1/services/dev.shani.chronoa.SearchProvider.service \
        "$pkgdir/usr/share/dbus-1/services/dev.shani.chronoa.SearchProvider.service"
    install -Dm644 usr/share/gnome-shell/search-providers/shani-chronoa.ini \
        "$pkgdir/usr/share/gnome-shell/search-providers/shani-chronoa.ini"
    install -Dm644 usr/share/krunner/dbusplugins/shani-chronoa.desktop \
        "$pkgdir/usr/share/krunner/dbusplugins/shani-chronoa.desktop"
    install -d "$pkgdir/usr/lib"
    cp -r usr/lib/shani-chronoa "$pkgdir/usr/lib/"
    # Window operations on GNOME (windows/gnome.py): Mutter exposes no window
    # list to clients, so this Shell extension exports a fixed D-Bus interface
    # for list/focus/close/arrange. Installed system-wide; the user enables it.
    install -Dm644 usr/share/gnome-shell/extensions/chronoa-windows@shani.dev/extension.js \
        "$pkgdir/usr/share/gnome-shell/extensions/chronoa-windows@shani.dev/extension.js"
    install -Dm644 usr/share/gnome-shell/extensions/chronoa-windows@shani.dev/metadata.json \
        "$pkgdir/usr/share/gnome-shell/extensions/chronoa-windows@shani.dev/metadata.json"
    install -Dm644 usr/share/applications/shani-chronoa.desktop "$pkgdir/usr/share/applications/shani-chronoa.desktop"
    install -Dm644 usr/share/glib-2.0/schemas/org.shani.chronoa.gschema.xml \
        "$pkgdir/usr/share/glib-2.0/schemas/org.shani.chronoa.gschema.xml"
    install -Dm644 usr/share/pixmaps/shani-chronoa.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/shani-chronoa.svg"
    # The capability list, so a person reading the installed package can see
    # every skill and the switch each one needs without a checkout. It is
    # generated (tools/gen_capabilities.py) from the same _GROUPS table the
    # Help window renders, and `tests/check_capabilities_doc.py` fails if the
    # committed file stops matching what that generator produces.
    install -Dm644 CAPABILITIES.md "$pkgdir/usr/share/doc/shani-chronoa/CAPABILITIES.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/shani-chronoa/README.md"
    find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} +
    # `__pycache__` is the directory; a stray `.pyc` can also arrive outside
    # one (a build that byte-compiled in place, a copied file). Both are
    # removed explicitly rather than relying on the directory rule alone.
    find "$pkgdir" -type f -name '*.pyc' -delete
    find "$pkgdir/usr/lib/shani-chronoa" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/lib/shani-chronoa" -type f -exec chmod 644 {} +
    # schemas, icon cache, desktop database: Arch's own pacman hooks
}
