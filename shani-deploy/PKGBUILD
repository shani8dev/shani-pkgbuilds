# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=shani-deploy
pkgver=0.0.1
pkgrel=100
# NOT a5867ac, which is the config-validation commit. At a5867ac the bundled
# scripts/shani-deploy.sh.sha256 is STALE: it records fbc1614f... while
# shani-deploy.sh itself hashes to 202695f8..., because re-signing runs in CI
# (.github/workflows/sign-deploy-script.yml) and lands as a follow-up commit.
# The re-sign is a CI follow-up commit (sign-deploy-script.yml), so the pin is
# always one commit behind the newest script until CI lands its .sha256/.asc.
# Nothing verifies the script against its own signature at runtime - every
# verify_sha256/verify_gpg inside it checks a DOWNLOADED artifact - so a
# mid-cycle pin ships a package whose bundled .sha256 describes the previous
# script. Wrong metadata, not a failed check.
#
# Stated precisely, since the first version of this comment overstated it:
# nothing verifies the script against its own bundled signature at runtime. The
# .sha256/.asc are produced by sign-deploy-script.sh and consumed only by that
# CI workflow; every verify_sha256/verify_gpg call in shani-deploy.sh checks a
# DOWNLOADED artifact (update image, gen-efi), not itself. So pinning a5867ac
# would not fail a check on an installed machine. What it would ship is a
# package whose bundled shani-deploy.sh.sha256 does not describe the bundled
# shani-deploy - wrong metadata, in a file whose whole job is to describe it.
_commit='8232355fa3c7be35a7664a84ddee923d9bbcde2c'   # Replace with the specific commit hash
pkgdesc="Safe transactional deployment system for Shani OS"
url="https://github.com/shani8dev/shani-deploy"
arch=('any')
license=('GPL-3.0-only')
depends=(
    'btrfs-progs'
    'zstd'
    'sbsigntools'
    'efitools'
    'dracut'
    'systemd'
    'jq'
    'zsync'
    'zsync2'
    'wget'
    'flatpak'
    'yad'
    'duperemove'
    'compsize'
    'bees'
    # chattr -i is required to unlink LoaderEntry* EFI variables: efivarfs
    # nodes are S_IMMUTABLE unless allowlisted (ed8b0de), and rm alone returns
    # EPERM. Without this the deploy's clearing is a guaranteed no-op.
    'e2fsprogs'
)
source=("git+https://github.com/shani8dev/$pkgname.git#commit=$_commit")
# A git+ source pinned to a commit: makepkg ignores checksums for VCS
# sources, so the pin IS the integrity anchor (check-skip-checksums.sh
# agrees). The previous real hash here described nothing makepkg ever
# checked, and described the OLD pin besides.
sha256sums=('SKIP')
makedepends=('git')

package() {
  # Create destination directories
  install -d "$pkgdir/usr/lib/systemd/system"
  install -d "$pkgdir/usr/lib/systemd/user"
  install -d "$pkgdir/usr/local/bin"
  install -d "$pkgdir/etc/xdg/autostart"

  # Install systemd unit files
  cp -r "$srcdir/$pkgname/systemd/system/"* "$pkgdir/usr/lib/systemd/system/"
  cp -r "$srcdir/$pkgname/systemd/user/"* "$pkgdir/usr/lib/systemd/user/"


  # Install scripts with executable permissions, removing the .sh extension
  for script in "$srcdir/$pkgname/scripts/"*; do
    base=$(basename "$script")
    target="${base%.sh}"  # Remove the .sh extension
    install -Dm755 "$script" "$pkgdir/usr/local/bin/$target"
  done
}

install="$pkgname.install"
