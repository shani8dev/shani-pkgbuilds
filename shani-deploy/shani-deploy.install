post_install() {
    post_upgrade
}

post_upgrade() {
    # Boot counting / health tracking
    systemctl enable mark-boot-in-progress.service   # WantedBy=local-fs.target
    systemctl enable mark-boot-success.service        # WantedBy=multi-user.target
    systemctl enable bless-boot.service               # WantedBy=multi-user.target
    systemctl enable check-boot-failure.timer         # WantedBy=timers.target + emergency.target
    systemctl enable shani-auto-rollback.timer        # WantedBy=timers.target + emergency.target

    # User setup (path unit activates the service — only enable the path)
    systemctl enable shani-user-setup.path            # WantedBy=multi-user.target

    # Bees deduplication
    systemctl enable beesd-setup.service              # WantedBy=multi-user.target

    # System-wide Flatpak (timer activates the service — only enable the timer)
    systemctl enable flatpak-update-system.timer      # WantedBy=timers.target

    # User-scope units (timer activates the service — only enable the timer)
    systemctl --global enable flatpak-update-user.timer   # WantedBy=timers.target

    # shani-update was retired 2026-09-25: Shani Cassini's
    # shani-cassini-agent.timer notifies about updates and boot failures.
    # An upgrade from an older install still has the retired units enabled
    # globally, so turn them off here. On a fresh install they never existed
    # and systemctl says so on stderr — `2>/dev/null` drops exactly that
    # expected message, `|| true` keeps the already-disabled/absent state from
    # failing the hook. Nothing else in this hook is silenced.
    systemctl --global disable shani-update.timer 2>/dev/null || true
    systemctl --global disable shani-update-tray.service 2>/dev/null || true

    # shani-download-only.timer is intentionally NOT enabled here — it's an
    # opt-in convenience for fleets that want updates pre-staged ahead of a
    # maintenance window. Enable explicitly with:
    #   systemctl enable --now shani-download-only.timer
}
