# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=shani-desktop-gamescope
pkgver=1.0
pkgrel=16
pkgdesc="ShaniOS gaming console: gamescope + Steam Big Picture, with a sway maintenance desktop and the Shani Control Center"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-desktop-gamescope"
license=('GPL-3.0-only')
depends=(
	# --- Login: greetd starts the gamescope session directly (no greeter) ---
	greetd
	# --- Gamescope compositor (from Arch [extra]) ---
	gamescope
	# --- Gamescope session framework (ShaniOS reimplementation of
	#     ChimeraOS's gamescope-session-plus, MIT) ---
	gamescope-session-plus
	# --- Vulkan overlay (from Arch [extra]) ---
	mangohud
	# --- Performance profile (TDP) and hybrid GPU switching ---
	power-profiles-daemon
	switcheroo-control
	# --- Audio/video stack for gaming ---
	pipewire
	pipewire-alsa
	pipewire-jack
	pipewire-pulse
	pipewire-v4l2
	# --- Desktop portal / session plumbing ---
	xdg-desktop-portal-gtk
	xdg-user-dirs
	xdg-utils
	gsettings-desktop-schemas
	# --- The maintenance desktop (sway + Waybar + Fuzzel + Mako). This is the
	#     console's "desktop mode": the same one the packages below configure
	#     through /etc/sway/config.d/90-shani-gamescope.conf ---
	sway
	swaybg
	swaylock
	swayidle
	foot
	grim
	slurp
	wl-clipboard
	brightnessctl
	waybar
	fuzzel
	mako
	playerctl
	pavucontrol
	thunar
	blueman
	wdisplays
	# --- The Shani Control Center (GTK4/libadwaita) and everything it calls ---
	gtk4
	libadwaita
	python-gobject
	python-evdev
	networkmanager
	# --- The polkit agent: without one, pkexec has nowhere to show its
	#     password prompt, and the console's update and factory-reset flows
	#     would fail with "authorization cancelled" instead of asking ---
	polkit-gnome
	# --- Everyday tools the console's maintenance desktop offers ---
	btop
	fastfetch
	yazi
	helix
	gnome-disk-utility
	qalculate-gtk
	cliphist
	libnotify
	wf-recorder
	syncthing
	# on-screen keyboard (shani-osk; dconf reads the owner's choice)
	squeekboard
	dconf
	swappy
	kanshi
	# --- Look and feel ---
	shani-fonts
	papirus-icon-theme
	adw-gtk-theme
	ttf-jetbrains-mono-nerd
	# --- Tuning, monitoring and diagnostics: the layer a gamer actually
	#     reaches for when a game runs hot, a fan is noisy or a GPU is not
	#     hitting the expected frame rate ---
	#     lm_sensors  - `sensors` (temps, RPM) and `fancontrol` (pwm curves)
	#     thermald    - CPU boost/thermal tuning daemon
	#     nvtop       - live GPU utilisation, VRAM, clocks, encoder use
	#     mesa-utils  - glxinfo/eglinfo for the GL/EGL stack
	#     vulkan-tools- vulkaninfo for the Vulkan stack
	#     vkmark      - Vulkan (GPU) benchmark
	#     glmark2     - OpenGL benchmark
	#     stress-ng   - CPU/RAM/IO stress test
	#     smartmontools/nvme-cli - drive health (SMART) for the game drive
	#     usbutils    - lsusb, for enumerating pads and dongles
	#     evtest      - raw controller button/axis test
	lm_sensors
	thermald
	nvtop
	mesa-utils
	vulkan-tools
	vkmark
	glmark2
	stress-ng
	smartmontools
	nvme-cli
	usbutils
	evtest
	# --- Filesystem helpers for game libraries ---
	gvfs
	gvfs-gphoto2
	gvfs-mtp
	gvfs-nfs
	gvfs-smb
	ntfs-3g
	exfat-utils
	btrfs-progs
)
install="$pkgname.install"
source=()
md5sums=()

package() {
    # Ensure necessary directories exist
    install -d "$pkgdir/etc/"
    install -d "$pkgdir/usr/"
    # Everything the console is made of ships here: the greetd initial_session
    # config and its systemd drop-in, the two session units that create the
    # console user and seed its home from /etc/skel, the sway/waybar/mako/
    # fuzzel/swaylock configuration, the Control Center and the screenshot
    # helper, the console-password helper and its boot prompt, the native
    # settings panels, the controller support and its on-screen keyboard,
    # desktop mode's keyboard toggle (shani-osk) and controller pointer
    # (pad-pointer), the Steam library hook with its launcher's reaper, and
    # the desktop entry and the Wayland session file that name them.
    cp -r "$startdir/etc" "$pkgdir/" 2>/dev/null || true
    cp -r "$startdir/usr" "$pkgdir/" 2>/dev/null || true
    # bytecode from a local run of the Python helpers never ships
    find "$pkgdir" -name __pycache__ -type d -prune -exec rm -rf {} +
}
