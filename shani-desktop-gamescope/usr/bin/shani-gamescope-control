#!/usr/bin/env python3
"""Shani Control Center — the gamescope maintenance desktop's big-button UI.

Runs in the sway session. Big buttons for what a console owner does between
games: update the system, watch the hardware, drive the power state, and (with
a typed confirmation) reset the machine.

The update flow uses the exact contract Shani Cassini uses:
``shani-deploy --status --check --json`` for the read-only state and
``shani-deploy`` for the deploy itself, so this UI and Cassini can never
disagree about what the machine thinks its state is.
"""
import json
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from gi.repository import Adw, Gdk, GLib, Gtk  # noqa: E402

try:
    import evdev
    from evdev import ecodes

    HAVE_EVDEV = True
except Exception:
    HAVE_EVDEV = False


# Absolute paths, so the polkit grant that backs them is a path grant and not
# a PATH lookup (polkit matches the program as it was invoked).
DEPLOY = "/usr/local/bin/shani-deploy"
RESET = "/usr/local/bin/shani-reset"
SESSION_SELECT = "/usr/bin/gamescope-session-select"
POWERPROFILESCTL = "/usr/bin/powerprofilesctl"

# The privileged operations go through polkit (pkexec) — the same path Shani
# Cassini uses, and the one shani-settings' 99-shani.rules governs:
# shani-deploy is AUTH_SELF (the user's own password), shani-reset is
# AUTH_ADMIN (wheel + an administrator credential), and the session switch is
# YES for an active local session (the console's own rule,
# 50-shani-gamescope.rules).
#
# pkexec's exit codes: 126 = the authentication dialog was dismissed, 127 =
# the caller is not authorized.
PKEXEC_CANCELLED = 126
PKEXEC_DENIED = 127


def pkexec_message(rc, out):
    """A message for a failed privileged call, or None when it succeeded."""
    if rc == 0:
        return None
    if rc == PKEXEC_CANCELLED:
        return "Authorization was cancelled"
    if rc == PKEXEC_DENIED:
        return ("Not authorized. The console user needs a password for this — "
                "set one with 'passwd' in a terminal, then try again.")
    detail = (out or "").strip().splitlines()
    return detail[-1] if detail else f"Failed (exit {rc})"


if HAVE_EVDEV:
    import threading

    class GamepadNav:
        """Map a connected controller to GTK focus/activate/close.

        D-pad / left stick -> move focus; A -> activate; B/Start/Select ->
        close. Runs in a daemon thread and pushes actions to the GTK main
        loop with GLib.idle_add.
        """

        def __init__(self, window):
            self.window = window
            self.dev = None
            for path in evdev.list_devices():
                try:
                    d = evdev.InputDevice(path)
                    keys = d.capabilities().get(ecodes.EV_KEY, [])
                    if ecodes.BTN_A in keys or getattr(ecodes, "BTN_SOUTH", -1) in keys:
                        self.dev = d
                        break
                except OSError:
                    continue
            self.thread = None
            if self.dev:
                self.thread = threading.Thread(target=self._run, daemon=True)
                self.thread.start()

        def _run(self):
            try:
                for ev in self.dev.read_loop():
                    if ev.type == ecodes.EV_KEY and ev.value == 1:
                        GLib.idle_add(self._key, ev.code)
            except OSError:
                pass

        def _key(self, code):
            if code in (ecodes.BTN_DPAD_UP, ecodes.KEY_UP):
                self._focus(Gtk.DirectionType.TAB_BACKWARD)
            elif code in (ecodes.BTN_DPAD_DOWN, ecodes.KEY_DOWN):
                self._focus(Gtk.DirectionType.TAB_FORWARD)
            elif code in (ecodes.BTN_DPAD_LEFT, ecodes.KEY_LEFT):
                self._focus(Gtk.DirectionType.LEFT)
            elif code in (ecodes.BTN_DPAD_RIGHT, ecodes.KEY_RIGHT):
                self._focus(Gtk.DirectionType.RIGHT)
            elif code in (ecodes.BTN_A, getattr(ecodes, "BTN_SOUTH", ecodes.BTN_A)):
                self._activate()
            elif code in (
                ecodes.BTN_B,
                getattr(ecodes, "BTN_EAST", ecodes.BTN_B),
                ecodes.BTN_START,
                ecodes.BTN_SELECT,
            ):
                self.window.close()
            return False

        def _focus(self, direction):
            w = self.window.get_focus()
            if w:
                w.child_focus(direction)
            return False

        def _activate(self):
            w = self.window.get_focus()
            if w and hasattr(w, "activate"):
                w.activate()
            return False


def spawn(cmd, terminal=False):
    """Start a command, or a terminal running it.

    A missing binary is a warning, not a traceback: the console's own actions
    all have their packages installed, but a user who removed one should see
    "foot is not installed" in the journal rather than a Python exception in
    the middle of a click handler.
    """
    try:
        if terminal:
            subprocess.Popen(["foot", "-e", "bash", "-lc", cmd])
        else:
            subprocess.Popen(["bash", "-lc", cmd])
    except OSError as exc:
        print(f"shani-gamescope-control: {cmd.split()[0]}: {exc}", file=sys.stderr)


def run_async(argv, on_done, on_line=None):
    """Run argv off the GTK thread.

    on_done(rc, output) is called on the GTK main loop when the process
    exits; on_line(line) is called for every output line as it arrives (only
    when on_line is given — otherwise the output is collected and handed over
    in one piece).
    """

    def worker():
        try:
            proc = subprocess.Popen(
                argv,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors="replace",
            )
        except OSError as exc:
            GLib.idle_add(on_done, 127, str(exc))
            return
        lines = []
        if on_line is None:
            lines = proc.stdout.read().splitlines()
        else:
            for line in proc.stdout:
                line = line.rstrip("\n")
                lines.append(line)
                GLib.idle_add(on_line, line)
        proc.wait()
        GLib.idle_add(on_done, proc.returncode, "\n".join(lines))

    threading.Thread(target=worker, daemon=True).start()


def output_view():
    """A read-only monospace log view, returned as (scrolled_window, view).

    The view is returned, not just its buffer: scrolling to the end is the
    view's job (scroll_to_iter), and the buffer has no such method.
    """
    view = Gtk.TextView()
    view.set_editable(False)
    view.set_monospace(True)
    view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
    view.set_left_margin(8)
    view.set_right_margin(8)
    view.set_top_margin(6)
    view.set_bottom_margin(6)
    scroll = Gtk.ScrolledWindow()
    scroll.set_child(view)
    scroll.set_min_content_height(170)
    scroll.set_max_content_height(280)
    scroll.set_vexpand(True)
    return scroll, view


def section_label(text):
    label = Gtk.Label(label=text)
    label.add_css_class("title-3")
    label.set_halign(Gtk.Align.START)
    return label


def install_glass_css():
    """Make the windows translucent, so the blurred wallpaper reads through.

    sway has no compositor-level blur, so the frosted look is made the way it
    can be made on vanilla sway: the wallpaper behind the windows is blurred
    (shani-sway-blur), and the windows themselves are translucent. Adwaita's
    own colours are named colours, so alpha() over them keeps the window
    following the light/dark scheme instead of hard-coding a tone.
    """
    css = """
    window.shani-glass {
      background-color: alpha(@window_bg_color, 0.88);
    }

    /* A tile: the icon sits in a round chip, and the tile itself is glass —
       translucent, so the blurred wallpaper reads through it. */
    button.shani-tile {
      background-color: alpha(@card_bg_color, 0.45);
      border: 1px solid alpha(@borders, 0.22);
      border-radius: 18px;
      padding: 14px;
      transition: background-color 160ms ease;
    }
    button.shani-tile:hover {
      background-color: alpha(@accent_bg_color, 0.26);
      border-color: alpha(@accent_color, 0.55);
    }
    button.shani-tile:active {
      background-color: alpha(@accent_bg_color, 0.38);
    }
    button.shani-tile:focus {
      border-color: alpha(@accent_color, 0.8);
    }
    button.shani-tile-primary {
      background-color: alpha(@accent_bg_color, 0.22);
      border-color: alpha(@accent_color, 0.45);
    }
    button.shani-tile-primary:hover {
      background-color: alpha(@accent_bg_color, 0.32);
    }
    button.shani-tile-danger {
      background-color: alpha(@error_bg_color, 0.16);
      border-color: alpha(@error_color, 0.4);
    }
    button.shani-tile-danger:hover {
      background-color: alpha(@error_bg_color, 0.26);
    }

    /* The icon chip is neutral on a normal tile, so the accent on the
       primary tile is the only accent in the section. */
    .shani-chip {
      background-color: alpha(@window_fg_color, 0.09);
      border-radius: 9999px;
      padding: 9px;
      min-width: 24px;
      min-height: 24px;
    }
    button.shani-tile-primary .shani-chip {
      background-color: alpha(@accent_bg_color, 0.35);
    }
    button.shani-tile-danger .shani-chip {
      background-color: alpha(@error_bg_color, 0.3);
    }
    .shani-chip-label {
      background-color: alpha(@window_fg_color, 0.1);
      color: @window_fg_color;
      border-radius: 9999px;
      padding: 4px 12px;
      font-size: 0.9em;
      font-weight: bold;
    }
    .shani-chip-alert {
      background-color: alpha(@warning_bg_color, 0.3);
      color: @warning_color;
    }
    """.encode("utf-8")
    provider = Gtk.CssProvider()
    try:
        provider.load_from_data(css)
    except GLib.Error:
        return
    display = Gdk.Display.get_default()
    if display is not None:
        Gtk.StyleContext.add_provider_for_display(
            display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )


class UpdatesWindow(Adw.Window):
    """Updates: read the deploy state, install an update, roll back.

    The read-only half (``--status --check --json``) needs no privileges, so
    the page is populated before anything is installed. The installing half is
    the deploy script itself, through polkit (AUTH_SELF: the console user's own
    password), with its output streamed into the log view.
    """

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        self.set_title("Updates")
        self.set_default_size(640, 620)
        self.add_css_class("shani-glass")
        self.busy = False

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        self.banner = Adw.Banner(title="", button_label="")
        self.banner.set_button_label("Check")
        self.banner.set_revealed(False)
        self.banner.connect("button-clicked", lambda _b: self.refresh())
        content.append(self.banner)

        status = Adw.PreferencesGroup(title="System status")
        self.rows = {}
        for key, label in (
            ("version", "Installed version"),
            ("channel", "Update channel"),
            ("slot", "Running slot"),
            ("remote", "Latest release"),
            ("reboot", "Reboot required"),
        ):
            row = Adw.ActionRow(title=label)
            row.set_subtitle("checking…")
            self.rows[key] = row
            status.add(row)
        content.append(status)

        actions = Adw.PreferencesGroup(title="Actions")

        row = Adw.ActionRow(
            title="Check for updates",
            subtitle="Ask the release channel what the newest image is",
        )
        self.check_button = Gtk.Button(label="Check")
        self.check_button.set_valign(Gtk.Align.CENTER)
        self.check_button.connect("clicked", lambda _b: self.refresh())
        row.add_suffix(self.check_button)
        actions.add(row)

        row = Adw.ActionRow(
            title="Install update",
            subtitle="Download, verify and install the newest image, then reboot",
        )
        self.install_button = Gtk.Button(label="Install")
        self.install_button.set_valign(Gtk.Align.CENTER)
        self.install_button.add_css_class("suggested-action")
        self.install_button.connect("clicked", lambda _b: self.start_update())
        row.add_suffix(self.install_button)
        actions.add(row)

        row = Adw.ActionRow(
            title="Go back to the previous system",
            subtitle="Switch to the other slot — the current one stays installed",
        )
        self.rollback_button = Gtk.Button(label="Roll back")
        self.rollback_button.set_valign(Gtk.Align.CENTER)
        self.rollback_button.connect("clicked", lambda _b: self.confirm_rollback())
        row.add_suffix(self.rollback_button)
        actions.add(row)

        content.append(actions)

        content.append(section_label("Output"))
        scroll, self.text_view = output_view()
        self.buffer = self.text_view.get_buffer()
        content.append(scroll)

        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page.set_child(content)
        outer.append(page)
        self.set_content(outer)

        self.refresh()

    # ------------------------------------------------------------------ read

    def refresh(self):
        if self.busy:
            return
        self.check_button.set_sensitive(False)
        self.check_button.set_label("Checking…")
        run_async(
            [DEPLOY, "--status", "--check", "--json"],
            self._status_done,
        )

    def _status_done(self, rc, out):
        self.check_button.set_sensitive(True)
        self.check_button.set_label("Check")
        if rc != 0:
            self.set_status("version", "shani-deploy did not answer")
            self.set_status("channel", "—")
            self.set_status("slot", "—")
            self.set_status("remote", "—")
            self.set_status("reboot", "—")
            self.append("shani-deploy --status --check --json failed:\n" + out)
            self.banner.set_title("Could not read the update status")
            self.banner.set_revealed(True)
            return
        try:
            st = json.loads(out)
        except json.JSONDecodeError as exc:
            self.append("shani-deploy answered with something that is not JSON:\n" + out)
            self.banner.set_title("Could not read the update status")
            self.banner.set_revealed(True)
            return

        self.set_status("version", st.get("version") or "unknown")
        self.set_status("channel", st.get("channel") or "unknown")
        slot = st.get("booted_slot") or st.get("current_slot") or "unknown"
        self.set_status("slot", f"@{slot}" if not str(slot).startswith("@") else str(slot))
        remote = st.get("remote") or {}
        latest = remote.get("latest") or "unknown"
        self.set_status("remote", latest)
        self.set_status("reboot", "yes — restart to start the new system"
                        if st.get("reboot_needed") else "no")

        if st.get("update_available"):
            self.banner.set_title(f"Update available: {latest}")
            self.banner.set_revealed(True)
            self.install_button.set_sensitive(True)
        else:
            self.banner.set_title("This system is up to date")
            self.banner.set_revealed(True)
            self.install_button.set_sensitive(True)

    def set_status(self, key, value):
        row = self.rows.get(key)
        if row:
            row.set_subtitle(str(value))

    # ----------------------------------------------------------------- write

    def append(self, text):
        if not text:
            return
        self.buffer.insert(self.buffer.get_end_iter(), text.rstrip("\n") + "\n")
        # scroll_to_iter is the VIEW's method; the buffer only holds text.
        self.text_view.scroll_to_iter(self.buffer.get_end_iter(), 0.0, False, 0.0, 1.0)

    def set_busy(self, busy):
        self.busy = busy
        self.check_button.set_sensitive(not busy)
        self.install_button.set_sensitive(not busy)
        self.rollback_button.set_sensitive(not busy)

    def start_update(self):
        if self.busy:
            return
        self.set_busy(True)
        self.append("── installing the update ──")
        run_async(
            ["pkexec", DEPLOY],
            self._update_done,
            on_line=self.append,
        )

    def _update_done(self, rc, out):
        self.set_busy(False)
        problem = pkexec_message(rc, out)
        if problem is None:
            self.append("── update finished. Restart to start the new system. ──")
        else:
            self.append(f"── {problem} ──")
        self.refresh()

    def confirm_rollback(self):
        dialog = Adw.AlertDialog(
            heading="Go back to the previous system?",
            body="Shanios will start from the other slot after a restart. "
                 "The current system stays installed, and your files and "
                 "settings are not affected.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("rollback", "Roll Back")
        dialog.set_response_appearance("rollback", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def responded(_d, response):
            if response != "rollback":
                return
            self.set_busy(True)
            self.append("── rolling back ──")
            run_async(["pkexec", DEPLOY, "--rollback"], self._update_done, on_line=self.append)

        dialog.connect("response", responded)
        dialog.present(self)


class ResetWindow(Adw.Window):
    """Factory reset: show what would go, then do it.

    ``shani-reset`` wipes the persistent state under /data (accounts, host
    settings, service state) and leaves the OS slots, the boot entries and
    /home alone. The dialog says so, offers a dry run first, and requires the
    word RESET before the destructive button unlocks.

    Both halves go through polkit, where shani-reset is AUTH_ADMIN (wheel plus
    an administrator credential) — the platform's own gate for an
    irreversible operation, not a sudo grant this console invented.
    """

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        self.set_title("Factory reset")
        self.set_default_size(640, 600)
        self.add_css_class("shani-glass")
        self.busy = False

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        warn = Adw.PreferencesGroup()
        row = Adw.ActionRow(
            title="Everything in /data is erased",
            subtitle="User accounts, host name, network and Bluetooth settings, "
                     "service state, and cached downloads. The OS slots, the boot "
                     "entries and your files in /home are NOT touched.",
        )
        row.set_subtitle_selectable(True)
        warn.add(row)
        content.append(warn)

        gate = Adw.PreferencesGroup(title="Confirm")
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Type RESET to unlock")
        self.entry.set_valign(Gtk.Align.CENTER)
        self.entry.set_hexpand(True)
        self.entry.connect("changed", lambda _e: self._sync_buttons())
        row = Adw.ActionRow(title="Type RESET")
        row.add_suffix(self.entry)
        gate.add(row)

        self.preview_button = Gtk.Button(label="Preview")
        self.preview_button.set_valign(Gtk.Align.CENTER)
        self.preview_button.connect("clicked", lambda _b: self.preview())
        row = Adw.ActionRow(title="Preview", subtitle="Show what a reset would remove")
        row.add_suffix(self.preview_button)
        gate.add(row)

        self.reset_button = Gtk.Button(label="Reset")
        self.reset_button.set_valign(Gtk.Align.CENTER)
        self.reset_button.add_css_class("destructive-action")
        self.reset_button.set_sensitive(False)
        self.reset_button.connect("clicked", lambda _b: self.confirm_reset())
        row = Adw.ActionRow(title="Factory reset", subtitle="Erase /data and restart")
        row.add_suffix(self.reset_button)
        gate.add(row)

        content.append(gate)

        content.append(section_label("Output"))
        scroll, self.text_view = output_view()
        self.buffer = self.text_view.get_buffer()
        content.append(scroll)

        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page.set_child(content)
        outer.append(page)
        self.set_content(outer)

    def append(self, text):
        if not text:
            return
        self.buffer.insert(self.buffer.get_end_iter(), text.rstrip("\n") + "\n")
        # scroll_to_iter is the VIEW's method; the buffer only holds text.
        self.text_view.scroll_to_iter(self.buffer.get_end_iter(), 0.0, False, 0.0, 1.0)

    def _sync_buttons(self):
        armed = self.entry.get_text().strip() == "RESET"
        self.reset_button.set_sensitive(armed and not self.busy)
        self.preview_button.set_sensitive(not self.busy)

    def set_busy(self, busy):
        self.busy = busy
        self._sync_buttons()

    def preview(self):
        self.set_busy(True)
        self.append("── preview ──")
        run_async(["pkexec", RESET, "--dry-run"], self._preview_done, on_line=self.append)

    def _preview_done(self, rc, out):
        self.set_busy(False)
        problem = pkexec_message(rc, out)
        if problem is not None:
            self.append(f"── {problem} ──")

    def confirm_reset(self):
        dialog = Adw.AlertDialog(
            heading="Erase everything and restart?",
            body="This removes every account and every system setting stored "
                 "on this machine. Your files in /home are kept. The machine "
                 "restarts when it is done.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reset", "Erase and restart")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def responded(_d, response):
            if response != "reset":
                return
            self.set_busy(True)
            self.append("── factory reset ──")
            run_async(["pkexec", RESET, "--yes"], self._reset_done, on_line=self.append)

        dialog.connect("response", responded)
        dialog.present(self)

    def _reset_done(self, rc, out):
        self.set_busy(False)
        problem = pkexec_message(rc, out)
        if problem is None:
            self.append("── done, restarting ──")
        else:
            self.append(f"── {problem} ──")


class PerformanceWindow(Adw.Window):
    """power-profiles-daemon: power saver, balanced, performance.

    The performance profile is what a gaming console runs on: it raises the
    CPU's sustained power limit, which is the difference between a laptop that
    throttles after ten minutes and one that does not.
    """

    MODES = (
        ("power-saver", "Power saver", "Lowest power, quiet fans"),
        ("balanced", "Balanced", "The default: enough power, sane temperatures"),
        ("performance", "Performance", "Sustained maximum power for gaming"),
    )

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        self.set_title("Performance")
        self.set_default_size(520, 320)
        self.add_css_class("shani-glass")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        group = Adw.PreferencesGroup(title="Power profile")
        self.buttons = {}
        first = None
        for mode, label, sub in self.MODES:
            btn = Gtk.CheckButton(label=label)
            btn.set_subtitle(sub) if hasattr(btn, "set_subtitle") else None
            btn.set_valign(Gtk.Align.CENTER)
            if first is None:
                first = btn
            else:
                btn.set_group(first)
            btn.connect("toggled", self._toggled, mode)
            self.buttons[mode] = btn
            row = Adw.ActionRow(title=label, subtitle=sub)
            row.add_prefix(btn)
            group.add(row)
        content.append(group)

        self.status = Gtk.Label(label="")
        self.status.add_css_class("dim-label")
        self.status.set_halign(Gtk.Align.START)
        content.append(self.status)

        outer.append(content)
        self.set_content(outer)
        self.refresh()

    def refresh(self):
        def done(rc, out):
            current = out.strip()
            if rc != 0 or not current:
                self.status.set_text("power-profiles-daemon did not answer")
                return
            self.status.set_text(f"Current profile: {current}")
            btn = self.buttons.get(current)
            if btn and not btn.get_active():
                btn.set_active(True)

        run_async([POWERPROFILESCTL, "get"], done)

    def _toggled(self, btn, mode):
        if not btn.get_active():
            return
        run_async(
            [POWERPROFILESCTL, "set", mode],
            lambda rc, out: self.status.set_text(
                f"Current profile: {mode}" if rc == 0 else f"Could not set {mode}"
            ),
        )


class WifiWindow(Adw.Window):
    """Wi-Fi: the console's network dialog.

    Steam's Big Picture has no network settings - SteamOS ships its own for
    exactly this reason - so this is how a console is brought online: pick a
    network, type the password, done. Every row is focusable and A activates
    it, so it works from the couch.

    nmcli is the backend: NetworkManager's polkit policy already lets an
    active local session control networking without a password
    (shani-settings' 99-shani.rules), so connecting needs no prompt.
    """

    FIELDS = "ACTIVE,SSID,SIGNAL,SECURITY"
    # nmcli reports an open network's security as one of these.
    OPEN = ("", "--", "NONE")

    def __init__(self, app=None, parent=None):
        # The application matters: a window that is not attached to one does
        # not count as a window of the app, so `--wifi` (which presents this
        # window as the app's only one) would exit immediately.
        super().__init__(application=app, transient_for=parent,
                         modal=parent is not None)
        self.set_title("Wi-Fi")
        self.set_default_size(640, 560)
        self.add_css_class("shani-glass")
        self.busy = False
        self.networks = Adw.PreferencesGroup(title="Networks")
        # The rows this window added. Adw.PreferencesGroup is a GtkListBox, so
        # get_first_child() returns its INTERNAL list box, not the rows:
        # removing that is a critical warning and never terminates. Rows are
        # tracked here and removed through the group's own API instead.
        self.rows = []

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        self.status = Gtk.Label(label="Looking for networks…")
        self.status.add_css_class("dim-label")
        self.status.set_halign(Gtk.Align.START)
        content.append(self.status)
        content.append(self.networks)

        actions = Adw.PreferencesGroup(title="Actions")
        row = Adw.ActionRow(title="Rescan", subtitle="Look for networks again")
        button = Gtk.Button(label="Rescan")
        button.set_valign(Gtk.Align.CENTER)
        button.connect("clicked", lambda _b: self.scan())
        row.add_suffix(button)
        actions.add(row)
        row = Adw.ActionRow(title="Advanced",
                            subtitle="nmtui - every NetworkManager setting")
        button = Gtk.Button(label="Open")
        button.set_valign(Gtk.Align.CENTER)
        button.connect("clicked", lambda _b: spawn("nmtui", terminal=True))
        row.add_suffix(button)
        actions.add(row)
        content.append(actions)

        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page.set_child(content)
        outer.append(page)
        self.set_content(outer)
        self.nav = GamepadNav(self) if HAVE_EVDEV else None
        self.scan()

    # ---------------------------------------------------------------- scan

    def _clear(self):
        for row in self.rows:
            self.networks.remove(row)
        self.rows = []

    @staticmethod
    def _split(line):
        """Split one nmcli --terse line.

        nmcli escapes a ':' inside a value as '\\:', so a plain split would
        cut an SSID like "Coffee: downstairs" in half.
        """
        fields, current, escaped = [], "", False
        for char in line:
            if escaped:
                current += char
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == ":":
                fields.append(current)
                current = ""
            else:
                current += char
        fields.append(current)
        return fields

    def scan(self):
        if self.busy:
            return
        self.busy = True
        self.status.set_text("Looking for networks…")
        self._clear()
        run_async(["nmcli", "-t", "-f", self.FIELDS, "dev", "wifi", "list"],
                  self._scanned)

    def _scanned(self, rc, out):
        self.busy = False
        if rc != 0:
            self.status.set_text("No Wi-Fi radio found")
            return
        # One row per SSID, strongest signal wins (a network is usually
        # listed once per band).
        seen = {}
        for line in out.splitlines():
            fields = self._split(line)
            if len(fields) < 4:
                continue
            active, ssid, signal, security = fields[0], fields[1], fields[2], fields[3]
            if not ssid:
                continue
            try:
                strength = int(signal)
            except ValueError:
                strength = 0
            current = seen.get(ssid)
            if current is None or strength > current[1]:
                seen[ssid] = (ssid, strength, security, active)
        if not seen:
            self.status.set_text("No networks in range")
            return
        self.status.set_text("Choose a network")
        for ssid, strength, security, active in sorted(seen.values(),
                                                       key=lambda n: -n[1]):
            row = self._row(ssid, strength, security, active)
            self.rows.append(row)
            self.networks.add(row)

    def _row(self, ssid, strength, security, active):
        secured = security not in self.OPEN
        bits = [f"{strength}% signal", "secured" if secured else "open"]
        if active in ("yes", "true"):
            bits.insert(0, "connected")
        row = Adw.ActionRow(title=ssid, subtitle=" · ".join(bits))
        if secured:
            row.add_suffix(Gtk.Image.new_from_icon_name("dialog-password-symbolic"))
        row.connect("activated", lambda _r, s=ssid, sec=security: self.connect_to(s, sec))
        return row

    # ------------------------------------------------------------- connect

    def connect_to(self, ssid, security):
        if self.busy:
            return
        if security in self.OPEN:
            self._do(["nmcli", "dev", "wifi", "connect", ssid])
            return
        dialog = Adw.MessageDialog(transient_for=self,
                                   heading=f"Connect to {ssid}",
                                   body="Enter the network password.")
        entry = Gtk.PasswordEntry()
        entry.set_placeholder_text("Password")
        entry.set_show_peek_icon(True)
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("connect", "Connect")
        dialog.set_default_response("connect")
        dialog.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)

        def responded(_d, response):
            if response != "connect":
                return
            password = entry.get_text()
            if not password:
                return
            # The password is an argument to nmcli, so it is visible in the
            # process table for the moment it takes to connect. The
            # alternative is NetworkManager's D-Bus API, which is a lot of
            # machinery for a dialog that runs on the owner's own console.
            self._do(["nmcli", "dev", "wifi", "connect", ssid,
                      "password", password])

        dialog.connect("response", responded)
        dialog.present(self)

    def _do(self, argv):
        self.busy = True
        self.status.set_text("Connecting…")
        run_async(argv, self._done)

    def _done(self, rc, out):
        self.busy = False
        if rc == 0:
            self.status.set_text("Connected")
            self.scan()
            return
        detail = (out or "").strip().splitlines()
        self.status.set_text(detail[-1] if detail else "Could not connect")


class ControlWindow(Adw.ApplicationWindow):
    """The console's maintenance UI.

    The design rules it follows, because a console is read from across a room
    and driven with a gamepad:

      * one primary action per view (here: back to the game), everything else
        is a peer;
      * a strict type scale — title-1 for the name, title-3 for a section,
        heading for a tile's name, dim-label for its one-line description;
      * an 8-pt spacing scale, so every gap is a multiple of the same unit;
      * every tile has the same anatomy: icon chip, name, one line of
        description. Nothing else;
      * colour carries meaning, not decoration: the accent marks the primary
        action, the warning colour marks the update state and the destructive
        colour marks the reset. Nothing else is coloured;
      * the columns follow the width, so the layout works on a phone-sized
        window and on a television.
    """

    # (icon, name, one-line description, action, tone)
    # tone: None (neutral), "primary" (the accent), "danger" (destructive)
    SECTIONS = (
        ("Play", (
            ("input-gaming", "Return to game mode", "Switch to Steam Big Picture",
             "switch_to_game_mode", "primary"),
            ("software-update-available", "Updates", "Install the newest ShaniOS",
             "updates", None),
            ("system-software-install", "Store", "Flatpak app store",
             "store", None),
        )),
        ("System", (
            ("network-workgroup", "Network", "Wi-Fi and Ethernet", "network", None),
            ("audio-volume-high", "Audio", "Volume and devices", "audio", None),
            ("bluetooth-active", "Bluetooth", "Controllers and audio", "bluetooth", None),
            ("video-display", "Display", "Resolution and scale", "display", None),
            ("speedometer", "Performance", "Power profile for gaming", "performance", None),
            ("utilities-system-monitor", "System", "CPU, memory, processes", "monitor", None),
            ("system-file-manager", "Files", "Browse the system", "files", None),
            ("drive-harddisk", "Storage", "Disks and partitions", "storage", None),
            ("text-x-generic", "Logs", "Boot and system logs", "logs", None),
            ("web-browser", "Browser", "Firefox", "browser", None),
        )),
        ("Gaming", (
            ("input-gamepad", "Controllers", "Map a pad to keys and mouse", "antimicrox", None),
            ("applications-graphics", "GPU control", "Fans, clocks, overclocking", "lact", None),
            ("audio-headphones", "Audio effects", "Headset surround and EQ", "easyeffects", None),
            ("applications-games", "Emulation", "RetroArch and its cores", "retroarch", None),
        )),
        # Kodi is the media center AND the Jellyfin client: the optional *arr
        # stack runs a Jellyfin server, and Kodi's add-on is how a console
        # talks to it.
        ("Media", (
            ("video-x-generic", "Kodi", "Movies, TV and music", "kodi", None),
            ("audio-x-generic", "Music", "Spotify", "spotify", None),
            ("folder-download", "Downloads", "Torrents and transfers", "qbittorrent", None),
        )),
        ("Maintain", (
            ("edit-delete", "Factory reset", "Erase this machine", "reset", "danger"),
        )),
    )

    # The action names above are resolved to a command here, so a tile's row
    # reads as data and the plumbing lives in one place.
    COMMANDS = {
        "store": "flatpak run io.github.kolunmi.Bazaar",
        "network": "nmtui",
        "audio": "pavucontrol",
        "bluetooth": "blueman",
        "display": "wdisplays",
        "monitor": "flatpak run io.missioncenter.MissionCenter",
        "files": "thunar",
        "storage": "gnome-disk-utility",
        "logs": "journalctl -b",
        "browser": "flatpak run org.mozilla.firefox",
        "antimicrox": "flatpak run io.github.antimicrox.antimicrox",
        "lact": "flatpak run io.github.ilya_zlobintsev.LACT",
        "easyeffects": "flatpak run com.github.wwmm.easyeffects",
        "retroarch": "flatpak run org.libretro.RetroArch",
        "kodi": "flatpak run tv.kodi.Kodi",
        "spotify": "flatpak run com.spotify.Client",
        "qbittorrent": "flatpak run org.qbittorrent.qBittorrent",
    }

    # A tile is never narrower than this, so the columns follow the width.
    TILE_WIDTH = 260

    def __init__(self, app):
        super().__init__(application=app, title="Shani Console")
        self.set_default_size(1160, 820)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        self.add_css_class("shani-glass")
        self.overlay = Adw.ToastOverlay()
        self.set_content(self.overlay)
        self.columns = 0
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.content.set_margin_top(28)
        self.content.set_margin_bottom(28)
        self.content.set_margin_start(28)
        self.content.set_margin_end(28)
        self.page = Gtk.ScrolledWindow()
        self.page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.page.set_child(self.content)
        self.overlay.set_child(self.page)
        self.rebuild()
        self.nav = GamepadNav(self) if HAVE_EVDEV else None
        self.probe_logind()
        self.refresh_status()
        # GTK4 has no "size-allocate" signal, no size-allocate vfunc and no
        # readable width property, so the layout's width is polled. It is one
        # integer comparison twice a second, and the only thing a width change
        # does is rebuild the grid.
        self._width_poll = GLib.timeout_add(400, self._poll_width)

    # ------------------------------------------------------------- layout

    def _poll_width(self):
        """Follow the width: the columns are the content width over the
        tile's minimum width, so the layout is the same on a phone-sized
        window and on a television."""
        width = self.content.get_width()
        if width > 0:
            columns = max(2, min(5, int(width // self.TILE_WIDTH)))
            if columns != self.columns:
                self.columns = columns
                self.rebuild()
        return True

    def rebuild(self):
        for child in list(self.content.get_children()) if hasattr(self.content, "get_children") else []:
            pass
        while True:
            child = self.content.get_first_child()
            if child is None:
                break
            self.content.remove(child)

        self.content.append(self._header())

        for title, entries in self.SECTIONS:
            self.content.append(self._section(title, entries))

        self.content.append(self._power_bar())

    def _header(self):
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)

        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title = Gtk.Label(label="Shani Console")
        title.add_css_class("title-1")
        title.set_halign(Gtk.Align.START)
        subtitle = Gtk.Label(label="Maintenance desktop")
        subtitle.add_css_class("dim-label")
        subtitle.set_halign(Gtk.Align.START)
        titles.append(title)
        titles.append(subtitle)
        header.append(titles)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        header.append(spacer)

        self.status_chip = Gtk.Label(label="Checking for updates…")
        self.status_chip.add_css_class("shani-chip-label")
        self.status_chip.add_css_class("shani-chip-quiet")
        header.append(self.status_chip)
        return header

    def _section(self, title, entries):
        """A titled group of tiles.

        Sections, not one long grid: the console's actions are not all equal,
        and someone looking for "GPU control" should not have to scan past
        file managers and logs to find it.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        label = Gtk.Label(label=title)
        label.add_css_class("title-3")
        label.set_halign(Gtk.Align.START)
        box.append(label)

        grid = Gtk.Grid(column_spacing=16, row_spacing=16)
        grid.set_row_homogeneous(True)
        grid.set_column_homogeneous(True)
        columns = self._columns_for(len(entries))
        for i, entry in enumerate(entries):
            grid.attach(self._tile(*entry), i % columns, i // columns, 1, 1)
        box.append(grid)
        return box

    def _columns_for(self, count):
        """How many columns a section of this many tiles gets.

        The window's own column count, never more than the section has tiles:
        a three-tile section is three tiles wide, not three tiles and an
        empty slot. The last row of a section may be short — that is how every
        desktop grid behaves, and forcing an even split would make the tiles
        twice as wide as they need to be.
        """
        limit = self.columns or 3
        return max(1, min(limit, count))

    def _tile(self, icon, name, sub, action, tone):
        btn = Gtk.Button()
        btn.add_css_class("shani-tile")
        if tone == "primary":
            btn.add_css_class("shani-tile-primary")
        elif tone == "danger":
            btn.add_css_class("shani-tile-danger")
        btn.set_size_request(-1, 128)

        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        chip = Gtk.Box()
        chip.add_css_class("shani-chip")
        # A vertical box stretches its children across the cross axis, so the
        # chip has to be told to keep its natural size and sit in the middle.
        chip.set_halign(Gtk.Align.CENTER)
        img = Gtk.Image.new_from_icon_name(icon)
        img.set_pixel_size(26)
        chip.append(img)
        column.append(chip)

        title = Gtk.Label(label=name)
        title.add_css_class("heading")
        title.set_justify(Gtk.Justification.CENTER)
        column.append(title)

        description = Gtk.Label(label=sub)
        description.add_css_class("dim-label")
        description.set_wrap(True)
        description.set_justify(Gtk.Justification.CENTER)
        column.append(description)

        btn.set_child(column)
        btn.connect("clicked", lambda _b, a=action: self._run(a))
        return btn

    def _run(self, action):
        if action == "switch_to_game_mode":
            self.switch_to_game_mode()
        elif action == "updates":
            self.open_updates()
        elif action == "performance":
            self.open_performance()
        elif action == "reset":
            self.open_reset()
        elif action == "network":
            self.open_wifi()
        else:
            command = self.COMMANDS.get(action)
            if command:
                spawn(command, terminal=command in ("nmtui", "journalctl -b"))

    # ------------------------------------------------------------ power bar

    def _power_bar(self):
        """Every power state a console owner expects, in one row.

        Flat buttons, grouped: sleep and lock on the left, the two that end
        the session in the middle, the ones that leave the desktop on the
        right. The destructive pair is the only coloured thing in the row.
        """
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.set_halign(Gtk.Align.CENTER)

        self.hibernate_button = self._power_button(bar, "Hibernate",
                                                  "systemctl hibernate")
        self.firmware_button = self._power_button(bar, "UEFI setup",
                                                  "systemctl reboot --firmware-setup")
        # Both stay insensitive until logind says the machine can do them.
        self.hibernate_button.set_sensitive(False)
        self.firmware_button.set_sensitive(False)
        self._power_button(bar, "Sleep", "systemctl suspend")
        self._power_button(bar, "Lock", "swaylock")

        bar.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        self._power_button(bar, "Power off", "systemctl poweroff")
        self._power_button(bar, "Reboot", "systemctl reboot")
        bar.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))

        logout = Gtk.Button(label="Log out")
        logout.add_css_class("flat")
        logout.connect("clicked", lambda _b: spawn("swaymsg exit"))
        bar.append(logout)

        close = Gtk.Button(label="Close")
        close.add_css_class("flat")
        close.connect("clicked", lambda _b: self.close())
        bar.append(close)
        return bar

    def _power_button(self, parent, label, cmd):
        btn = Gtk.Button(label=label)
        btn.add_css_class("flat")
        if label in ("Power off", "Reboot"):
            btn.add_css_class("destructive-action")
        btn.connect("clicked", lambda _b, c=cmd: self.power_action(c))
        parent.append(btn)
        return btn

    def toast(self, text):
        self.overlay.add_toast(Adw.Toast.new(text))

    # --------------------------------------------------------------- actions

    def open_updates(self):
        UpdatesWindow(self).present()

    def open_reset(self):
        ResetWindow(self).present()

    def open_performance(self):
        PerformanceWindow(self).present()

    def open_wifi(self):
        WifiWindow(self.get_application(), parent=self).present()

    def power_action(self, cmd):
        """Run a power action and say what happened.

        Suspend, hibernate, power off and reboot all go through systemd-logind
        and polkit, which lets an active local session do them without a
        password (see shani-settings' 99-shani.rules). Hibernate is the one
        that can legitimately fail — the machine needs a swap area at least as
        large as RAM — so the failure is reported instead of swallowed.
        """

        def done(rc, out):
            if cmd == "swaylock":
                return
            if rc == 0:
                self.toast(f"{cmd.split()[-1]}…")
            else:
                detail = (out or "").strip().splitlines()
                self.toast(detail[-1] if detail else f"{cmd} failed")

        if cmd == "swaylock":
            spawn(cmd)
            return

        run_async(cmd.split(), done)

    def switch_to_game_mode(self):
        """Hand the session back to Steam.

        gamescope-session-select writes the persistent session choice and
        restarts greetd, so the screen goes away — the window this ran in does
        not survive it, and there is nothing to report afterwards. polkit lets
        the active console session do it without a password
        (50-shani-gamescope.rules).
        """

        def done(rc, out):
            problem = pkexec_message(rc, out)
            if problem is not None:
                self.toast(problem)

        run_async(["pkexec", SESSION_SELECT, "steam"], done)

    def probe_logind(self):
        """Ask logind what it can actually do.

        Hibernate needs a swap area at least as large as RAM and a kernel with
        hibernation compiled in; "Reboot to firmware setup" needs the firmware
        to support it. logind knows both answers, and offering a button that
        cannot work is worse than not offering it — so the two buttons that
        depend on it are only enabled when logind says yes. This is the same
        probe the ShaniOS desktop shell makes (shani-shell's
        Services/Power.qml).
        """

        def capability(method, apply_result):
            def done(rc, out):
                apply_result(rc == 0 and 's "yes"' in out)
            run_async(
                ["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                 "org.freedesktop.login1.Manager", method],
                done,
            )

        capability("CanHibernate",
                   lambda ok: self.hibernate_button.set_sensitive(ok))
        capability("CanRebootToFirmwareSetup",
                   lambda ok: self.firmware_button.set_sensitive(ok))

    def refresh_status(self):
        """The chip in the header: what the release channel says.

        This is the same read-only call the Updates window makes
        (shani-deploy --status --check --json), so the header and the
        updates page can never disagree.
        """

        def done(rc, out):
            if rc != 0:
                self.status_chip.set_text("Status unavailable")
                return
            try:
                st = json.loads(out)
            except json.JSONDecodeError:
                self.status_chip.set_text("Status unavailable")
                return
            self.status_chip.remove_css_class("shani-chip-alert")
            if st.get("update_available"):
                latest = (st.get("remote") or {}).get("latest") or "a new image"
                self.status_chip.set_text(f"Update available — {latest}")
                self.status_chip.add_css_class("shani-chip-alert")
            elif st.get("reboot_needed"):
                self.status_chip.set_text("Restart pending")
                self.status_chip.add_css_class("shani-chip-alert")
            else:
                self.status_chip.set_text("Up to date")

        run_async([DEPLOY, "--status", "--check", "--json"], done)


class ControlApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="dev.shani.gamescope-control")
        # Gtk.Application parses argv before do_activate runs and rejects
        # anything it does not know, so --wifi has to be registered here -
        # otherwise the process dies with "Unknown option --wifi" and no
        # window at all.
        self.add_main_option("wifi", 0, GLib.OptionFlags.NONE,
                             GLib.OptionArg.NONE,
                             "Open the Wi-Fi dialog on its own", None)

    def do_startup(self):
        install_glass_css()
        Adw.Application.do_startup(self)

    def do_activate(self):
        if "--wifi" in sys.argv:
            # `shani-gamescope-control --wifi`: the dialog on its own, which
            # is what the panel's network chip and the Network tile launch.
            WifiWindow(self).present()
            return
        ControlWindow(self).present()


if __name__ == "__main__":
    ControlApp().run(sys.argv)
