class UpdatesWindow(Adw.Window):
    """Updates: read the deploy state, install an update, roll back.

    The read-only half (``--status --check --json``) needs no privileges, so
    the page is populated before anything is installed. The installing half is
    the deploy script itself, run through pkexec (the console user's own
    password), with its own output streamed into the log view.
    """

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        gamepad.remote_keys(self)   # a TV remote: Back closes, OK on a field types
        self.set_title("Updates")
        self.set_default_size(640, 620)
        self.add_css_class("shani-glass")
        self.busy = False

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        self.banner = Adw.Banner(title="", button_label="")
        self.banner.set_button_label("Check")
        self.banner.set_revealed(False)
        self.banner.connect("button-clicked", lambda _b: self.refresh())
        content.append(self.banner)

        status = Adw.PreferencesGroup(title="System status")
        self.rows = {}
        for key, label in (
            ("version", "Installed version"),
            ("channel", "Update channel"),
            ("slot", "Running slot"),
            ("remote", "Latest release"),
            ("reboot", "Reboot required"),
        ):
            row = Adw.ActionRow(title=label)
            row.set_subtitle("checking…")
            self.rows[key] = row
            status.add(row)
        content.append(status)

        actions = Adw.PreferencesGroup(title="Actions")

        row = Adw.ActionRow(
            title="Check for updates",
            subtitle="Ask the release channel what the newest image is",
        )
        self.check_button = Gtk.Button(label="Check")
        self.check_button.set_valign(Gtk.Align.CENTER)
        self.check_button.connect("clicked", lambda _b: self.refresh())
        row.add_suffix(self.check_button)
        actions.add(row)

        row = Adw.ActionRow(
            title="Install update",
            subtitle="Download, verify and install the newest image, then reboot",
        )
        self.install_button = Gtk.Button(label="Install")
        self.install_button.set_valign(Gtk.Align.CENTER)
        self.install_button.add_css_class("suggested-action")
        self.install_button.connect("clicked", lambda _b: self.start_update())
        row.add_suffix(self.install_button)
        actions.add(row)

        row = Adw.ActionRow(
            title="Go back to the previous system",
            subtitle="Switch to the other slot — the current one stays installed",
        )
        self.rollback_button = Gtk.Button(label="Roll back")
        self.rollback_button.set_valign(Gtk.Align.CENTER)
        self.rollback_button.connect("clicked", lambda _b: self.confirm_rollback())
        row.add_suffix(self.rollback_button)
        actions.add(row)

        content.append(actions)

        content.append(section_label("Output"))
        scroll, self.text_view = output_view()
        self.buffer = self.text_view.get_buffer()
        content.append(scroll)

        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page.set_child(content)
        outer.append(page)
        self.set_content(outer)

        self.refresh()

    # ------------------------------------------------------------------ read

    def refresh(self):
        if self.busy:
            return
        self.check_button.set_sensitive(False)
        self.check_button.set_label("Checking…")
        run_async(
            [DEPLOY, "--status", "--check", "--json"],
            self._status_done,
        )

    def _status_done(self, rc, out):
        self.check_button.set_sensitive(True)
        self.check_button.set_label("Check")
        if rc != 0:
            self.set_status("version", "shani-deploy did not answer")
            self.set_status("channel", "—")
            self.set_status("slot", "—")
            self.set_status("remote", "—")
            self.set_status("reboot", "—")
            self.append("shani-deploy --status --check --json failed:\n" + out)
            self.banner.set_title("Could not read the update status")
            self.banner.set_revealed(True)
            return
        try:
            st = json.loads(out)
        except json.JSONDecodeError as exc:
            self.append("shani-deploy answered with something that is not JSON:\n" + out)
            self.banner.set_title("Could not read the update status")
            self.banner.set_revealed(True)
            return

        self.set_status("version", st.get("version") or "unknown")
        self.set_status("channel", st.get("channel") or "unknown")
        slot = st.get("booted_slot") or st.get("current_slot") or "unknown"
        self.set_status("slot", f"@{slot}" if not str(slot).startswith("@") else str(slot))
        remote = st.get("remote") or {}
        latest = remote.get("latest") or "unknown"
        self.set_status("remote", latest)
        self.set_status("reboot", "yes — restart to start the new system"
                        if st.get("reboot_needed") else "no")

        if st.get("update_available"):
            self.banner.set_title(f"Update available: {latest}")
            self.banner.set_revealed(True)
            self.install_button.set_sensitive(True)
        else:
            self.banner.set_title("This system is up to date")
            self.banner.set_revealed(True)
            self.install_button.set_sensitive(True)

    def set_status(self, key, value):
        row = self.rows.get(key)
        if row:
            row.set_subtitle(str(value))

    # ----------------------------------------------------------------- write

    def append(self, text):
        if not text:
            return
        self.buffer.insert(self.buffer.get_end_iter(), text.rstrip("\n") + "\n")
        # scroll_to_iter is the VIEW's method; the buffer only holds text.
        self.text_view.scroll_to_iter(self.buffer.get_end_iter(), 0.0, False, 0.0, 1.0)

    def set_busy(self, busy):
        self.busy = busy
        self.check_button.set_sensitive(not busy)
        self.install_button.set_sensitive(not busy)
        self.rollback_button.set_sensitive(not busy)

    def start_update(self):
        if self.busy:
            return
        self.set_busy(True)
        self.append("── installing the update ──")
        run_async(
            ["pkexec", DEPLOY],
            self._update_done,
            on_line=self.append,
        )

    def _update_done(self, rc, out):
        self.set_busy(False)
        problem = pkexec_message(rc, out)
        if problem is None:
            self.append("── update finished. Restart to start the new system. ──")
        else:
            self.append(f"── {problem} ──")
        self.refresh()

    def confirm_rollback(self):
        dialog = Adw.AlertDialog(
            heading="Go back to the previous system?",
            body="Shanios will start from the other slot after a restart. "
                 "The current system stays installed, and your files and "
                 "settings are not affected.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("rollback", "Roll Back")
        dialog.set_response_appearance("rollback", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def responded(_d, response):
            if response != "rollback":
                return
            self.set_busy(True)
            self.append("── rolling back ──")
            run_async(["pkexec", DEPLOY, "--rollback"], self._update_done, on_line=self.append)

        dialog.connect("response", responded)
        dialog.present(self)


class PasswordWindow(Adw.Window):
    """The console's first password.

    The console account logs in without one (greetd's initial_session) and is
    created with its password locked, so nothing running as the console user
    can become root. Updates, factory reset and the lock screen need a
    password. It is never typed in this window: the session can only ASK for
    a prompt at the next boot, which runs as root before any user process
    exists (gamescope-console-password.service), so code running as the
    console user can neither read nor answer it. Once a password exists,
    changing it is `passwd` in a terminal, which asks for the current one.
    """

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        gamepad.remote_keys(self)   # a TV remote: Back closes, OK on a field types
        self.parent_window = parent
        self.set_title("Password")
        self.set_default_size(620, 560)
        self.add_css_class("shani-glass")

        has = parent.has_password
        page = Adw.StatusPage(
            icon_name="security-high-symbolic" if has else "dialog-password-symbolic",
            title="This console is protected" if has else "Protect this console",
            description=(
                "Updates, factory reset and the lock screen ask for your "
                "password. Steam still starts without it."
                if has else
                "Steam keeps starting without a password. Updates, factory "
                "reset and the lock screen will ask for it.\n\n"
                "The console restarts and asks for the password before "
                "anything else runs, so no app can see it. Connect a "
                "keyboard first."),
        )
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_halign(Gtk.Align.CENTER)

        if has:
            button = Gtk.Button(label="Change password…")
            button.connect("clicked", lambda _b: spawn("passwd", terminal=True))
        else:
            button = Gtk.Button(label="Restart and set password")
            button.add_css_class("suggested-action")
            button.connect("clicked", lambda _b: self.request())
        button.add_css_class("pill")
        self.button = button
        box.append(button)

        self.status = Gtk.Label(wrap=True, justify=Gtk.Justification.CENTER)
        self.status.add_css_class("dim-label")
        box.append(self.status)
        page.set_child(box)

        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(page)
        self.set_content(view)
        button.grab_focus()

    def request(self):
        self.button.set_sensitive(False)

        def done(rc, out):
            problem = pkexec_message(rc, out)
            if problem is not None:
                self.status.set_text(problem)
                self.button.set_sensitive(True)
                return
            self.status.set_text("Restarting…")
            run_async(["systemctl", "reboot"], self._rebooted)

        run_async(["pkexec", CONSOLE_PASSWORD, "--request"], done)

    def _rebooted(self, rc, out):
        if rc != 0:
            detail = (out or "").strip().splitlines()
            self.status.set_text("Restart the console to set the password. " +
                                 (detail[-1] if detail else ""))
            self.button.set_sensitive(True)


class ResetWindow(Adw.Window):
    """Factory reset: show what would go, then do it.

    ``shani-reset`` wipes the persistent state under /data (accounts, host
    settings, service state) and leaves the OS slots, the boot entries and
    /home alone. The dialog says so, offers a dry run first, and requires the
    word RESET before the destructive button unlocks, on top of the
    administrator password pkexec asks for.
    """

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        gamepad.remote_keys(self)   # a TV remote: Back closes, OK on a field types
        self.set_title("Factory reset")
        self.set_default_size(640, 600)
        self.add_css_class("shani-glass")
        self.busy = False

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        warn = Adw.PreferencesGroup()
        row = Adw.ActionRow(
            title="Everything in /data is erased",
            subtitle="User accounts, host name, network and Bluetooth settings, "
                     "service state, and cached downloads. The OS slots, the boot "
                     "entries and your files in /home are NOT touched.",
        )
        row.set_subtitle_selectable(True)
        warn.add(row)
        content.append(warn)

        gate = Adw.PreferencesGroup(title="Confirm")
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Type RESET to unlock")
        self.entry.set_valign(Gtk.Align.CENTER)
        self.entry.set_hexpand(True)
        self.entry.connect("changed", lambda _e: self._sync_buttons())
        row = Adw.ActionRow(title="Type RESET")
        row.add_suffix(self.entry)
        gate.add(row)

        self.preview_button = Gtk.Button(label="Preview")
        self.preview_button.set_valign(Gtk.Align.CENTER)
        self.preview_button.connect("clicked", lambda _b: self.preview())
        row = Adw.ActionRow(title="Preview", subtitle="Show what a reset would remove")
        row.add_suffix(self.preview_button)
        gate.add(row)

        self.reset_button = Gtk.Button(label="Reset")
        self.reset_button.set_valign(Gtk.Align.CENTER)
        self.reset_button.add_css_class("destructive-action")
        self.reset_button.set_sensitive(False)
        self.reset_button.connect("clicked", lambda _b: self.confirm_reset())
        row = Adw.ActionRow(title="Factory reset", subtitle="Erase /data and restart")
        row.add_suffix(self.reset_button)
        gate.add(row)

        content.append(gate)

        content.append(section_label("Output"))
        scroll, self.text_view = output_view()
        self.buffer = self.text_view.get_buffer()
        content.append(scroll)

        page = Gtk.ScrolledWindow()
        page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page.set_child(content)
        outer.append(page)
        self.set_content(outer)

    def append(self, text):
        if not text:
            return
        self.buffer.insert(self.buffer.get_end_iter(), text.rstrip("\n") + "\n")
        # scroll_to_iter is the VIEW's method; the buffer only holds text.
        self.text_view.scroll_to_iter(self.buffer.get_end_iter(), 0.0, False, 0.0, 1.0)

    def _sync_buttons(self):
        armed = self.entry.get_text().strip() == "RESET"
        self.reset_button.set_sensitive(armed and not self.busy)
        self.preview_button.set_sensitive(not self.busy)

    def set_busy(self, busy):
        self.busy = busy
        self._sync_buttons()

    def preview(self):
        self.set_busy(True)
        self.append("── preview ──")
        run_async(["pkexec", RESET, "--dry-run"], self._preview_done, on_line=self.append)

    def _preview_done(self, rc, out):
        self.set_busy(False)
        problem = pkexec_message(rc, out)
        if problem is not None:
            self.append(f"── {problem} ──")

    def confirm_reset(self):
        dialog = Adw.AlertDialog(
            heading="Erase everything and restart?",
            body="This removes every account and every system setting stored "
                 "on this machine. Your files in /home are kept. The machine "
                 "restarts when it is done.",
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("reset", "Erase and restart")
        dialog.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def responded(_d, response):
            if response != "reset":
                return
            self.set_busy(True)
            self.append("── factory reset ──")
            run_async(["pkexec", RESET, "--yes"], self._reset_done, on_line=self.append)

        dialog.connect("response", responded)
        dialog.present(self)

    def _reset_done(self, rc, out):
        self.set_busy(False)
        problem = pkexec_message(rc, out)
        if problem is None:
            self.append("── done, restarting ──")
        else:
            self.append(f"── {problem} ──")


class PerformanceWindow(Adw.Window):
    """power-profiles-daemon: power saver, balanced, performance.

    The performance profile is what a gaming console runs on: it raises the
    CPU's sustained power limit, which is the difference between a laptop that
    throttles after ten minutes and one that does not.
    """

    MODES = (
        ("power-saver", "Power saver", "Lowest power, quiet fans"),
        ("balanced", "Balanced", "The default: enough power, sane temperatures"),
        ("performance", "Performance", "Sustained maximum power for gaming"),
    )

    def __init__(self, parent):
        super().__init__(transient_for=parent, modal=True)
        gamepad.remote_keys(self)   # a TV remote: Back closes, OK on a field types
        self.set_title("Performance")
        self.set_default_size(520, 320)
        self.add_css_class("shani-glass")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.append(Adw.HeaderBar())

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(14)
        content.set_margin_bottom(14)
        content.set_margin_start(18)
        content.set_margin_end(18)

        group = Adw.PreferencesGroup(title="Power profile")
        self.buttons = {}
        first = None
        for mode, label, sub in self.MODES:
            btn = Gtk.CheckButton(label=label)
            btn.set_subtitle(sub) if hasattr(btn, "set_subtitle") else None
            btn.set_valign(Gtk.Align.CENTER)
            if first is None:
                first = btn
            else:
                btn.set_group(first)
            btn.connect("toggled", self._toggled, mode)
            self.buttons[mode] = btn
            row = Adw.ActionRow(title=label, subtitle=sub)
            row.add_prefix(btn)
            group.add(row)
        content.append(group)

        self.status = Gtk.Label(label="")
        self.status.add_css_class("dim-label")
        self.status.set_halign(Gtk.Align.START)
        content.append(self.status)

        outer.append(content)
        self.set_content(outer)
        self.refresh()

    def refresh(self):
        def done(rc, out):
            current = out.strip()
            if rc != 0 or not current:
                self.status.set_text("power-profiles-daemon did not answer")
                return
            self.status.set_text(f"Current profile: {current}")
            btn = self.buttons.get(current)
            if btn and not btn.get_active():
                btn.set_active(True)

        run_async([POWERPROFILESCTL, "get"], done)

    def _toggled(self, btn, mode):
        if not btn.get_active():
            return
        run_async(
            [POWERPROFILESCTL, "set", mode],
            lambda rc, out: self.status.set_text(
                f"Current profile: {mode}" if rc == 0 else f"Could not set {mode}"
            ),
        )


class ControlWindow(Adw.ApplicationWindow):
    """The console's maintenance UI.

    The design rules it follows, because a console is read from across a room
    and driven with a gamepad:

      * one primary action per view (here: back to the game), everything else
        is a peer;
      * a strict type scale — title-1 for the name, title-3 for a section,
        heading for a tile's name, dim-label for its one-line description;
      * an 8-pt spacing scale, so every gap is a multiple of the same unit;
      * every tile has the same anatomy: icon chip, name, one line of
        description. Nothing else;
      * colour carries meaning, not decoration: the accent marks the primary
        action, the warning colour marks the update state and the destructive
        colour marks the reset. Nothing else is coloured;
      * a home, not a window: full screen in desktop mode, shelves of large
        cards a controller moves between by position, the time and battery at
        the top and what each button does at the bottom.
    """

    # (icon, name, one-line description, action, tone)
    # tone: None (neutral), "primary" (the accent), "danger" (destructive)
    SECTIONS = (
        ("Play", (
            ("input-gaming-symbolic", "Return to game mode", "Switch to Steam Big Picture",
             "switch_to_game_mode", "primary"),
            ("software-update-available-symbolic", "Updates", "Install the newest ShaniOS",
             "updates", None),
            ("system-software-install-symbolic", "Store", "Flatpak app store",
             "store", None),
        )),
        ("System", (
            ("network-wireless-symbolic", "Network", "Wi-Fi and Ethernet", "network", None),
            ("audio-volume-high-symbolic", "Audio", "Volume and devices", "audio", None),
            ("bluetooth-active-symbolic", "Bluetooth", "Controllers and audio", "bluetooth", None),
            ("video-display-symbolic", "Display", "Resolution and scale", "display", None),
            ("power-profile-performance-symbolic", "Performance", "Power profile for gaming", "performance", None),
            ("utilities-system-monitor-symbolic", "System", "CPU, memory, processes", "monitor", None),
            ("folder-symbolic", "Files", "Browse the system", "files", None),
            ("drive-harddisk-symbolic", "Storage", "Disks and partitions", "storage", None),
            ("text-x-generic-symbolic", "Logs", "Boot and system logs", "logs", None),
            ("web-browser-symbolic", "Browser", "Firefox", "browser", None),
        )),
        ("Gaming", (
            ("input-gaming-symbolic", "Controllers", "Map a pad to keys and mouse", "antimicrox", None),
            ("applications-engineering-symbolic", "GPU control", "Fans, clocks, overclocking", "lact", None),
            ("audio-headphones-symbolic", "Audio effects", "Headset surround and EQ", "easyeffects", None),
            ("applications-games-symbolic", "Emulation", "RetroArch and its cores", "retroarch", None),
        )),
        # Kodi is the media center AND the Jellyfin client: the optional *arr
        # stack runs a Jellyfin server, and Kodi's add-on is how a console
        # talks to it.
        ("Media", (
            ("video-x-generic-symbolic", "Kodi", "Movies, TV and music", "kodi", None),
            ("audio-x-generic-symbolic", "Music", "Spotify", "spotify", None),
            ("folder-download-symbolic", "Downloads", "Torrents and transfers", "qbittorrent", None),
        )),
        ("Maintain", (
            ("dialog-password-symbolic", "Password", "For updates, reset and the lock",
             "password", None),
            ("edit-delete-symbolic", "Factory reset", "Erase this machine", "reset", "danger"),
        )),
    )

    # The action names above are resolved to a command here, so a tile's row
    # reads as data and the plumbing lives in one place.
    COMMANDS = {
        "store": "flatpak run io.github.kolunmi.Bazaar",
        "monitor": "flatpak run io.missioncenter.MissionCenter",
        "files": "thunar",
        "storage": "gnome-disk-utility",
        "logs": "journalctl -b",
        "browser": "flatpak run org.mozilla.firefox",
        "antimicrox": "flatpak run io.github.antimicrox.antimicrox",
        "lact": "flatpak run io.github.ilya_zlobintsev.LACT",
        "easyeffects": "flatpak run com.github.wwmm.easyeffects",
        "retroarch": "flatpak run org.libretro.RetroArch",
        "kodi": "flatpak run tv.kodi.Kodi",
        "spotify": "flatpak run com.spotify.Client",
        "qbittorrent": "flatpak run org.qbittorrent.qBittorrent",
    }

    # Settings with a native panel (usr/lib/shani-desktop-gamescope/panels.py).
    PANELS = {
        "network": panels.NetworkPanel,
        "bluetooth": panels.BluetoothPanel,
        "audio": panels.AudioPanel,
        "display": panels.DisplayPanel,
    }

    # The power shelf: (icon, name, description, action, tone). "power:" runs
    # the command through power_action; the rest are _run's own actions.
    POWER = (
        ("weather-clear-night-symbolic", "Sleep", "Suspend; any button wakes it", "power:systemctl suspend", None),
        ("system-lock-screen-symbolic", "Lock", "Ask for the password", "power:swaylock", None),
        ("system-reboot-symbolic", "Restart", "Start again", "power:systemctl reboot", None),
        ("system-shutdown-symbolic", "Power off", "Turn the console off", "power:systemctl poweroff", "danger"),
        ("media-playback-pause-symbolic", "Hibernate", "Save everything and power off",
         "power:systemctl hibernate", None),
        ("application-x-firmware-symbolic", "Firmware setup", "Restart into the UEFI",
         "power:systemctl reboot --firmware-setup", None),
        ("system-log-out-symbolic", "Log out", "Back to the start of the session", "logout", None),
    )

    def __init__(self, app):
        super().__init__(application=app, title="Shani Console")
        self.set_default_size(1280, 800)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.PREFER_DARK)
        self.add_css_class("shani-home")
        # the controller moves between shelves by where things are on screen
        # (gamepad.Navigator), the way a console's home does; and B never
        # closes the home itself, only what is open over it
        self.shelves = True
        self.home = not FROM_STEAM
        self.cards = {}
        self.overlay = Adw.ToastOverlay()
        self.set_content(self.overlay)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(self._top_bar())
        self.banner = self._password_banner()
        self.banner.set_margin_start(48)
        self.banner.set_margin_end(48)
        self.banner.set_margin_bottom(8)
        root.append(self.banner)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.content.set_margin_bottom(24)
        self.page = Gtk.ScrolledWindow(vexpand=True)
        self.page.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.page.set_child(self.content)
        root.append(self.page)
        root.append(self._hint_bar())
        self.overlay.set_child(root)
        self.rebuild()
        self.lock_button = self.cards["power:swaylock"]
        self.hibernate_button = self.cards["power:systemctl hibernate"]
        self.firmware_button = self.cards["power:systemctl reboot --firmware-setup"]
        # Both stay insensitive until logind says the machine can do them; a
        # locked account could never unlock swaylock, so Lock waits for a
        # password (refresh_password).
        for card in (self.lock_button, self.hibernate_button, self.firmware_button):
            card.set_sensitive(False)
        self.lock_button.set_tooltip_text("Set a password first (Password)")
        # The controller: D-pad/stick move, A activates (and types into text
        # fields with the on-screen keyboard), B closes the front dialog.
        self.nav = gamepad.Navigator(self)
        gamepad.watch(self.nav.press)
        # a TV remote (keys: arrows, OK, Back, Home) drives it the same way
        self.remote = gamepad.remote_keys(self)
        self.has_password = False
        self.probe_logind()
        self.refresh_status()
        self.refresh_password()
        self._tick()
        self._clock = GLib.timeout_add_seconds(15, self._tick)
        # a new app from Bazaar shows on the Apps shelf as soon as it lands
        self._app_monitor = Gio.AppInfoMonitor.get()
        self._app_monitor.connect("changed", lambda _m: GLib.idle_add(self._apps_changed))
        # Desktop mode's home: the whole screen, like the console's game mode;
        # apps open on the next workspace and the Guide button brings this back
        if os.environ.get("SWAYSOCK") and not FROM_STEAM:
            self.fullscreen()
        GLib.idle_add(self._focus_first)

    # ------------------------------------------------------------- layout

    def rebuild(self):
        """The shelves: one per section, then power."""
        self.cards = {}
        while (child := self.content.get_first_child()) is not None:
            self.content.remove(child)
        for i, (title, entries) in enumerate(self.sections()):
            self.content.append(self._shelf(title, entries, big=i == 0))
            if i == 0:
                # always there (even empty), so a first install has a place
                self.apps_shelf = self._shelf("Apps", self._apps())
                self.apps_shelf.set_visible(bool(self._apps()))
                self.content.append(self.apps_shelf)
        self.content.append(self._shelf("Power", self.POWER))

    def _apps_changed(self, _monitor=None):
        """An app was installed or removed (Bazaar, flatpak): the Apps shelf
        is made again in place, the rest of the home keeps its state."""
        for action in [a for a in self.cards if a.startswith("app:")]:
            self.cards.pop(action)
        apps = self._apps()
        fresh = self._shelf("Apps", apps)
        fresh.set_visible(bool(apps))
        self.content.insert_child_after(fresh, self.apps_shelf)
        self.content.remove(self.apps_shelf)
        self.apps_shelf = fresh
        return False

    # the console's own entries and helpers, which have tiles of their own
    NOT_APPS = ("dev.shani.gamescope-control", "shani-gamescope-control", "return-to-gamemode",
                "foot-server", "footclient")

    def _apps(self):
        """Every installed app (Flatpak), A-Z, as cards with its own icon: a
        console's library, for what desktop mode is for."""
        apps = []
        for info in Gio.AppInfo.get_all():
            if not info.should_show():
                continue
            # the owner's apps: Flatpaks (the store's, the image's), not the
            # host's own tools and settings dialogs - those have tiles
            path = info.get_filename() if hasattr(info, "get_filename") else ""
            if "/flatpak/exports/" not in (path or ""):
                continue
            app_id = info.get_id() or ""
            if any(app_id.startswith(n) for n in self.NOT_APPS):
                continue
            apps.append((info.get_icon() or "application-x-executable-symbolic",
                         info.get_display_name(), info.get_description() or "",
                         f"app:{app_id}", None))
        apps.sort(key=lambda a: a[1].casefold())
        return tuple(apps)

    def focus_candidates(self):
        """What the controller moves between (gamepad.move_by_position): the
        update chip, the banner's button while it shows, and every card."""
        extra = [self.status_button]
        if self.banner.get_visible():
            extra.append(self.banner_button)
        return extra + list(self.cards.values())

    def _focus_first(self):
        first = next(iter(self.cards.values()), None)
        if first is not None:
            first.grab_focus()
        return False

    def _top_bar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        bar.add_css_class("shani-topbar")

        mark = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        name = Gtk.Label(label="SHANI")
        name.add_css_class("shani-wordmark")
        kind = Gtk.Label(label="Console")
        kind.add_css_class("shani-wordmark-sub")
        kind.set_valign(Gtk.Align.BASELINE_CENTER if hasattr(Gtk.Align, "BASELINE_CENTER") else Gtk.Align.CENTER)
        mark.append(name)
        mark.append(kind)
        bar.append(mark)

        spacer = Gtk.Box(hexpand=True)
        bar.append(spacer)

        self.status_chip = Gtk.Label(label="Checking for updates…")
        chip_button = Gtk.Button(child=self.status_chip)
        chip_button.add_css_class("shani-chip-label")
        chip_button.set_valign(Gtk.Align.CENTER)
        chip_button.set_tooltip_text("Open Updates")
        chip_button.connect("clicked", lambda _b: self.open_updates())
        self.status_button = chip_button
        bar.append(chip_button)

        self.battery = Gtk.Label()
        self.battery.add_css_class("shani-topbar-item")
        self.battery.set_visible(False)
        bar.append(self.battery)

        self.clock = Gtk.Label()
        self.clock.add_css_class("shani-clock")
        bar.append(self.clock)
        return bar

    def _tick(self):
        """The clock and the battery, as the top of a console's screen has."""
        self.clock.set_label(GLib.DateTime.new_now_local().format("%H:%M"))
        level = None
        try:
            for supply in sorted(os.listdir("/sys/class/power_supply")):
                base = f"/sys/class/power_supply/{supply}"
                with open(f"{base}/type") as fh:
                    if fh.read().strip() != "Battery":
                        continue
                with open(f"{base}/capacity") as fh:
                    level = int(fh.read().strip())
                break
        except (OSError, ValueError):
            level = None
        self.battery.set_visible(level is not None)
        if level is not None:
            self.battery.set_label(f"{level}%")
        return True

    # what the bottom bar says, for the input last used: a remote's keys or
    # a controller's buttons
    HINTS = {
        "remote": (("OK", "Select"), ("Back", "Back"), ("Home", "Home")),
        "pad": (("A", "Select"), ("B", "Back"), ("R", "Pointer"), ("RT", "Click")),
        "pad-steam": (("A", "Select"), ("B", "Back")),
    }

    def _hint_bar(self):
        """What the buttons do here, always on screen."""
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=22)
        bar.add_css_class("shani-hintbar")
        where = Gtk.Label(label="B: back to the game" if FROM_STEAM else
                          "Home or Guide button: back here from anywhere", xalign=0, hexpand=True)
        where.add_css_class("shani-hint-dim")
        bar.append(where)
        self.hints = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=22)
        bar.append(self.hints)
        self.hint_mode = None
        self.on_input("pad")
        return bar

    def on_input(self, kind):
        """The last input was a remote's keys or a controller: the hints say
        that device's names for things (gamepad.remote_keys / Navigator)."""
        if kind == "pad" and FROM_STEAM:
            kind = "pad-steam"     # in game mode Steam has the pointer
        if kind == self.hint_mode:
            return
        self.hint_mode = kind
        while (child := self.hints.get_first_child()) is not None:
            self.hints.remove(child)
        for glyph, text in self.HINTS[kind]:
            hint = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            badge = Gtk.Label(label=glyph)
            badge.add_css_class("shani-glyph")
            hint.append(badge)
            hint.append(Gtk.Label(label=text))
            self.hints.append(hint)

    def _password_banner(self):
        """The one nudge the console gives: without a password, updates,
        factory reset and the lock screen cannot be authorised. Hidden until
        refresh_password says the console has none."""
        frame = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        frame.add_css_class("shani-banner")
        icon = Gtk.Image.new_from_icon_name("dialog-password-symbolic")
        icon.set_pixel_size(24)
        icon.set_valign(Gtk.Align.CENTER)
        frame.append(icon)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text.set_hexpand(True)
        text.set_valign(Gtk.Align.CENTER)
        title = Gtk.Label(label="Protect this console", xalign=0)
        title.add_css_class("heading")
        body = Gtk.Label(label="Set a password to install updates, reset or lock the "
                               "screen. Steam still starts without one.",
                         xalign=0, wrap=True)
        body.add_css_class("dim-label")
        text.append(title)
        text.append(body)
        frame.append(text)
        button = Gtk.Button(label="Set password")
        button.add_css_class("pill")
        button.add_css_class("suggested-action")
        button.set_valign(Gtk.Align.CENTER)
        button.connect("clicked", lambda _b: self.open_password())
        self.banner_button = button
        frame.append(button)
        frame.set_visible(False)
        return frame

    def _shelf(self, title, entries, big=False):
        """A titled row of cards that scrolls sideways under the controller.

        Shelves, not one long grid: the console's actions are not all equal,
        and someone looking for "GPU control" should not have to scan past
        file managers and logs to find it. The first shelf's cards are larger:
        it holds the one primary action.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        label = Gtk.Label(label=title, xalign=0)
        label.add_css_class("shani-shelf-title")
        box.append(label)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        row.add_css_class("shani-shelf-row")
        for entry in entries:
            row.append(self._card(*entry, big=big))
        scroller = Gtk.ScrolledWindow()
        # no scrollbar: the focused card is scrolled into view
        scroller.set_policy(Gtk.PolicyType.EXTERNAL, Gtk.PolicyType.NEVER)
        scroller.set_propagate_natural_height(True)
        scroller.set_child(row)
        box.append(scroller)
        return box

    def _card(self, icon, name, sub, action, tone, big=False):
        btn = Gtk.Button()
        btn.add_css_class("shani-card")
        if big:
            btn.add_css_class("shani-card-big")
        if tone == "primary":
            btn.add_css_class("shani-card-primary")
        elif tone == "danger":
            btn.add_css_class("shani-card-danger")

        column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        column.set_valign(Gtk.Align.CENTER)
        if isinstance(icon, Gio.Icon):
            img = Gtk.Image.new_from_gicon(icon)       # an app's own, coloured icon
        else:
            img = Gtk.Image.new_from_icon_name(icon)
        img.set_pixel_size(56 if big else 44)
        img.add_css_class("shani-card-icon")
        column.append(img)

        title = Gtk.Label(label=name)
        title.add_css_class("shani-card-title")
        title.set_justify(Gtk.Justification.CENTER)
        column.append(title)

        description = Gtk.Label(label=sub)
        description.add_css_class("shani-card-sub")
        description.set_wrap(True)
        description.set_lines(2)
        description.set_ellipsize(3)  # Pango.EllipsizeMode.END: two lines at most
        description.set_max_width_chars(24)
        description.set_justify(Gtk.Justification.CENTER)
        column.append(description)

        btn.set_child(column)
        btn.connect("clicked", lambda _b, a=action: self._run(a))
        self.cards[action] = btn
        return btn

    def sections(self):
        """SECTIONS, with game mode's first tiles when Steam opened this."""
        if not FROM_STEAM:
            return self.SECTIONS
        (title, entries), *rest = self.SECTIONS
        return ((title, GAME_MODE_TILES + entries[1:]), *rest)

    def _run(self, action):
        if action.startswith("app:"):
            info = Gio.DesktopAppInfo.new(action[len("app:"):])
            if info is not None:
                try:
                    info.launch([], None)
                except GLib.Error as exc:
                    self.toast(exc.message)
        elif action.startswith("power:"):
            self.power_action(action[len("power:"):])
        elif action == "logout":
            spawn("swaymsg exit")
        elif action == "switch_to_game_mode":
            self.switch_to_game_mode()
        elif action == "close":
            self.get_application().quit()
        elif action == "switch_to_desktop":
            self.switch_to_desktop()
        elif action == "updates":
            self.open_updates()
        elif action == "performance":
            self.open_performance()
        elif action == "reset":
            self.open_reset()
        elif action == "password":
            self.open_password()
        elif action in self.PANELS:
            self.PANELS[action](self).present()
        else:
            command = self.COMMANDS.get(action)
            if command:
                spawn(command, terminal=command == "journalctl -b")

    def toast(self, text):
        self.overlay.add_toast(Adw.Toast.new(text))

    # --------------------------------------------------------------- actions

    def open_updates(self):
        UpdatesWindow(self).present()

    def open_password(self):
        PasswordWindow(self).present()

    def refresh_password(self):
        """Ask whether the console has a password; Lock depends on it."""

        def done(rc, out):
            has = rc == 0 and (out or "").strip() == "set"
            self.has_password = has
            self.banner.set_visible(not has)
            self.lock_button.set_sensitive(has)
            self.lock_button.set_tooltip_text(None if has else
                                              "Set a password first (Password)")

        run_async(["pkexec", CONSOLE_PASSWORD, "--status"], done)

    def open_reset(self):
        ResetWindow(self).present()

    def open_performance(self):
        PerformanceWindow(self).present()

    def power_action(self, cmd):
        """Run a power action and say what happened.

        Suspend, hibernate, power off and reboot all go through systemd-logind
        and polkit, which lets an active local session do them without a
        password (see shani-settings' 99-shani.rules). Hibernate is the one
        that can legitimately fail — the machine needs a swap area at least as
        large as RAM — so the failure is reported instead of swallowed.
        """

        def done(rc, out):
            if cmd == "swaylock":
                return
            if rc == 0:
                self.toast(f"{cmd.split()[-1]}…")
            else:
                detail = (out or "").strip().splitlines()
                self.toast(detail[-1] if detail else f"{cmd} failed")

        if cmd == "swaylock":
            spawn(cmd)
            return

        run_async(cmd.split(), done)

    def switch_to_game_mode(self):
        """Hand the session back to Steam.

        gamescope-session-select writes the persistent session choice and
        restarts greetd, so the screen goes away — the window this ran in does
        not survive it, and there is nothing to report afterwards. polkit lets
        the active console session do it without a password
        (50-shani-gamescope.rules).
        """

        def done(rc, out):
            problem = pkexec_message(rc, out)
            if problem is not None:
                self.toast(problem)

        run_async(["pkexec", SESSION_SELECT, "steam"], done)

    def switch_to_desktop(self):
        """From game mode: the desktop session, the same way back as there is
        forward (gamescope-session-select restarts greetd into sway)."""

        def done(rc, out):
            problem = pkexec_message(rc, out)
            if problem is not None:
                self.toast(problem)

        run_async(["pkexec", SESSION_SELECT, "desktop"], done)

    def probe_logind(self):
        """Ask logind what it can actually do.

        Hibernate needs a swap area at least as large as RAM and a kernel with
        hibernation compiled in; "Reboot to firmware setup" needs the firmware
        to support it. logind knows both answers, and offering a button that
        cannot work is worse than not offering it — so the two buttons that
        depend on it are only enabled when logind says yes. This is the same
        probe the ShaniOS desktop shell makes (shani-shell's
        Services/Power.qml).
        """

        def capability(method, apply_result):
            def done(rc, out):
                apply_result(rc == 0 and 's "yes"' in out)
            run_async(
                ["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                 "org.freedesktop.login1.Manager", method],
                done,
            )

        capability("CanHibernate",
                   lambda ok: self.hibernate_button.set_sensitive(ok))
        capability("CanRebootToFirmwareSetup",
                   lambda ok: self.firmware_button.set_sensitive(ok))

    def refresh_status(self):
        """The chip in the header: what the release channel says.

        This is the same read-only call the Updates window makes
        (shani-deploy --status --check --json), so the header and the
        updates page can never disagree.
        """

        def done(rc, out):
            if rc != 0:
                self.status_chip.set_text("Status unavailable")
                return
            try:
                st = json.loads(out)
            except json.JSONDecodeError:
                self.status_chip.set_text("Status unavailable")
                return
            self.status_button.remove_css_class("shani-chip-alert")
            if st.get("update_available"):
                latest = (st.get("remote") or {}).get("latest") or "a new image"
                self.status_chip.set_text(f"Update available — {latest}")
                self.status_button.add_css_class("shani-chip-alert")
            elif st.get("reboot_needed"):
                self.status_chip.set_text("Restart pending")
                self.status_button.add_css_class("shani-chip-alert")
            else:
                self.status_chip.set_text("Up to date")

        run_async([DEPLOY, "--status", "--check", "--json"], done)


class ControlApp(Adw.Application):
    """`shani-gamescope-control [--open ACTION]`: ACTION is a tile's action
    (network, bluetooth, audio, display, updates, password, ...), opened over
    the Control Center — what waybar's status icons use."""

    def __init__(self):
        super().__init__(application_id="dev.shani.gamescope-control",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.add_main_option("open", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "Open a page (network, bluetooth, audio, display, ...)", "ACTION")
        # what an older Waybar config launches: the same as --open network
        self.add_main_option("wifi", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
                             "Open the network page", None)
        self.window = None

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        self.activate()
        if options.get("wifi") and not options.get("open"):
            options["open"] = "network"
        if options.get("open"):
            action = options["open"]
            GLib.idle_add(lambda: self.window._run(action) and False)
        return 0

    def do_startup(self):
        install_glass_css()
        Adw.Application.do_startup(self)

    def do_activate(self):
        if self.window is None:
            self.window = ControlWindow(self)
        # desktop mode: the home lives on the first workspace; activating it
        # (the Guide button, Super+Esc, Waybar) brings that workspace up
        if os.environ.get("SWAYSOCK") and not FROM_STEAM:
            subprocess.Popen(["swaymsg", "-q", "workspace", "number", "1"])
        self.window.present()


if __name__ == "__main__":
    ControlApp().run(sys.argv)
