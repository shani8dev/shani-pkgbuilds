#!/usr/bin/env python3
"""Shani Control Center — the gamescope maintenance desktop's big-button UI.

Runs in the sway session. Big buttons for what a console owner does between
games: update the system, watch the hardware, drive the power state, and (with
a typed confirmation) reset the machine.

The update flow uses the exact contract Shani Cassini uses:
``shani-deploy --status --check --json`` for the read-only state and
``shani-deploy`` for the deploy itself, so this UI and Cassini can never
disagree about what the machine thinks its state is.
"""
import json
import os
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

# The native settings panels (Network, Bluetooth, Audio, Display) and the
# controller support (gamepad.py: navigation, on-screen keyboard) live next to
# the console's other private helpers.
sys.path.insert(0, "/usr/lib/shani-desktop-gamescope")
import gamepad  # noqa: E402
import panels  # noqa: E402


# Absolute paths, so the polkit grant that backs them is a path grant and not
# a PATH lookup (polkit matches the program as it was invoked).
DEPLOY = "/usr/local/bin/shani-deploy"
RESET = "/usr/local/bin/shani-reset"
SESSION_SELECT = "/usr/bin/gamescope-session-select"
POWERPROFILESCTL = "/usr/bin/powerprofilesctl"
CONSOLE_PASSWORD = "/usr/lib/shani-desktop-gamescope/console-password"

# Opened from game mode (the "Control Center" entry in Steam's library, through
# the console's launcher): Steam is still running behind this window, so the
# primary action is to go back to it - closing - and desktop mode is one tile
# away, since Steam's own "Switch to Desktop" has nothing it can call here.
FROM_STEAM = os.environ.get("SHANI_FROM_STEAM") == "1"
GAME_MODE_TILES = (
    ("input-gaming-symbolic", "Back to the game", "Close the Control Center",
     "close", "primary"),
    ("computer-symbolic", "Desktop mode", "Apps, files and settings with a pointer",
     "switch_to_desktop", None),
)

# The privileged operations go through polkit (pkexec) — the same path Shani
# Cassini uses, and the one shani-settings' 99-shani.rules governs:
# shani-deploy is AUTH_SELF (the user's own password), shani-reset is
# AUTH_ADMIN (wheel + an administrator credential), and the session switch is
# YES for an active local session (the console's own rule,
# 50-shani-gamescope.rules).
#
# pkexec's exit codes: 126 = the authentication dialog was dismissed, 127 =
# the caller is not authorized.
PKEXEC_CANCELLED = 126
PKEXEC_DENIED = 127


def pkexec_message(rc, out):
    """A message for a failed privileged call, or None when it succeeded."""
    if rc == 0:
        return None
    if rc == PKEXEC_CANCELLED:
        return "Authorization was cancelled"
    if rc == PKEXEC_DENIED:
        return ("Not authorized. The console needs a password for this — "
                "set one in Control Center → Password, then try again.")
    detail = (out or "").strip().splitlines()
    return detail[-1] if detail else f"Failed (exit {rc})"


def spawn(cmd, terminal=False):
    """Start a command, or a terminal running it.

    A missing binary is a warning, not a traceback: the console's own actions
    all have their packages installed, but a user who removed one should see
    "foot is not installed" in the journal rather than a Python exception in
    the middle of a click handler.
    """
    try:
        if terminal:
            subprocess.Popen(["foot", "-e", "bash", "-lc", cmd])
        else:
            subprocess.Popen(["bash", "-lc", cmd])
    except OSError as exc:
        print(f"shani-gamescope-control: {cmd.split()[0]}: {exc}", file=sys.stderr)


def run_async(argv, on_done, on_line=None):
    """Run argv off the GTK thread.

    on_done(rc, output) is called on the GTK main loop when the process
    exits; on_line(line) is called for every output line as it arrives (only
    when on_line is given — otherwise the output is collected and handed over
    in one piece).
    """

    def worker():
        try:
            proc = subprocess.Popen(
                argv,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                errors="replace",
            )
        except OSError as exc:
            GLib.idle_add(on_done, 127, str(exc))
            return
        lines = []
        if on_line is None:
            lines = proc.stdout.read().splitlines()
        else:
            for line in proc.stdout:
                line = line.rstrip("\n")
                lines.append(line)
                GLib.idle_add(on_line, line)
        proc.wait()
        GLib.idle_add(on_done, proc.returncode, "\n".join(lines))

    threading.Thread(target=worker, daemon=True).start()


def output_view():
    """A read-only monospace log view, returned as (scrolled_window, view).

    The view is returned, not just its buffer: scrolling to the end is the
    view's job (scroll_to_iter), and the buffer has no such method.
    """
    view = Gtk.TextView()
    view.set_editable(False)
    view.set_monospace(True)
    view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
    view.set_left_margin(8)
    view.set_right_margin(8)
    view.set_top_margin(6)
    view.set_bottom_margin(6)
    scroll = Gtk.ScrolledWindow()
    scroll.set_child(view)
    scroll.set_min_content_height(170)
    scroll.set_max_content_height(280)
    scroll.set_vexpand(True)
    return scroll, view


def section_label(text):
    label = Gtk.Label(label=text)
    label.add_css_class("title-3")
    label.set_halign(Gtk.Align.START)
    return label


def install_glass_css():
    """Make the windows translucent, so the blurred wallpaper reads through.

    sway has no compositor-level blur, so the frosted look is made the way it
    can be made on vanilla sway: the wallpaper behind the windows is blurred
    (shani-sway-blur), and the windows themselves are translucent. Adwaita's
    own colours are named colours, so alpha() over them keeps the window
    following the light/dark scheme instead of hard-coding a tone.
    """
