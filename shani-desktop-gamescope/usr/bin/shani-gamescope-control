    button.shani-tile:focus {
      border-color: alpha(@accent_color, 0.8);
    }
    button.shani-tile-primary {
      background-color: alpha(@accent_bg_color, 0.22);
      border-color: alpha(@accent_color, 0.45);
    }
    button.shani-tile-primary:hover {
      background-color: alpha(@accent_bg_color, 0.32);
    }
    button.shani-tile-danger {
      background-color: alpha(@error_bg_color, 0.16);
