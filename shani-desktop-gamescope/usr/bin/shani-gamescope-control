    button.shani-tile:hover {
      background-color: alpha(@accent_bg_color, 0.26);
      border-color: alpha(@accent_color, 0.55);
    }
    button.shani-tile:active {
      background-color: alpha(@accent_bg_color, 0.38);
    }
    button.shani-tile:focus-visible {
      outline: 3px solid alpha(@accent_color, 0.9);
      outline-offset: 2px;
