#!/usr/bin/env python3
"""shani-sway-blur — the console's glass: blur the wallpaper behind windows.

sway has no compositor-level blur. The two ways to get one are both out of
reach here: swayfx (the sway fork that renders blur) is AUR-only, and niri's
blur belongs to niri. So this does what swayblur does — watch sway's IPC for
windows and swap the wallpaper for a blurred copy while one is open — in a
few dozen lines, and without any of swayblur's dependencies (python-i3ipc,
ImageMagick, swww):

  * the sharp and blurred wallpapers are rendered at build time and shipped
    with the package, so nothing is rendered at runtime and the console needs
    no image library at all;
  * sway's IPC is spoken directly, so there is no Python wrapper to depend
    on either.

Sway's IPC is NOT the i3ipc protocol that i3ipc's Python module speaks: the
header is 14 bytes (the magic "i3-ipc", a 4-byte payload length and a 4-byte
PAYLOAD TYPE, both native endian), a subscribe request is a plain array of
event names, and every reply and event carries its own type. Getting that
wrong is silent: sway simply never answers.

The background is set with sway's own `output ... bg` command, which is why
the sway config does NOT start swaybg as well: two things setting the
background would fight, and the layer-shell surface swaybg draws would cover
the image sway sets.
"""
import json
import os
import socket
import struct
import subprocess
import sys

SHARP = "/usr/share/backgrounds/shani/shani.jpg"
BLURRED = "/usr/share/backgrounds/shani/shani-blur.jpg"

MAGIC = b"i3-ipc"
HEADER_SIZE = 14  # magic + length + type

# sway's ipc_command_type (include/ipc.h)
IPC_COMMAND = 0
IPC_SUBSCRIBE = 2
IPC_GET_TREE = 4
IPC_EVENT_WINDOW = (1 << 31) | 3
IPC_EVENT_WORKSPACE = (1 << 31) | 0


def send(sock, payload_type, payload):
    data = json.dumps(payload).encode("utf-8")
    sock.sendall(MAGIC + struct.pack("=II", len(data), payload_type) + data)


def receive(sock):
    """One (type, payload) message, or (None, None) when the socket closed."""
    header = b""
    while len(header) < HEADER_SIZE:
        chunk = sock.recv(HEADER_SIZE - len(header))
        if not chunk:
            return None, None
        header += chunk
    length, payload_type = struct.unpack("=II", header[len(MAGIC):HEADER_SIZE])
    body = b""
    while len(body) < length:
        chunk = sock.recv(length - len(body))
        if not chunk:
            return None, None
        body += chunk
    try:
        return payload_type, json.loads(body)
    except json.JSONDecodeError:
        return payload_type, None


def count_windows(tree):
    """How many windows are on screen right now.

    A window in sway's tree is a leaf that carries a "pid" (every view has
    one; containers do not). The "window_properties" key that i3's tree uses
    is sway's XWayland-only extension, so a native Wayland window has no
    such key at all.

    Only visible windows are counted: sway's tree covers every workspace,
    and a window on another workspace is not on screen, so the wallpaper
    behind an empty workspace stays sharp.
    """
    count = 0
    stack = [tree]
    while stack:
        node = stack.pop()
        if not isinstance(node, dict):
            continue
        if node.get("pid") is not None and node.get("visible"):
            count += 1
        stack.extend(node.get("nodes") or [])
    return count


def set_background(path):
    try:
        subprocess.run(
            ["swaymsg", "output", "*", "bg", path, "fill"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        pass


def run_swaybg():
    """The fallback owner of the wallpaper.

    swaybg is a layer-shell client: it draws the background in the background
    layer, which sits ON TOP of the image sway itself sets. So there must
    never be two owners. When this script cannot do the job, it becomes the
    only owner by running swaybg itself instead of leaving both running.
    """
    args = ["swaybg"]
    if os.path.exists(SHARP):
        args += ["-i", SHARP, "-m", "fill"]
    else:
        args += ["-c", "#0e1116"]
    try:
        subprocess.run(args, check=False)
    except OSError:
        pass


def main():
    sock_path = os.environ.get("SWAYSOCK")
    if not sock_path:
        print("shani-sway-blur: SWAYSOCK is not set; drawing the wallpaper", file=sys.stderr)
        run_swaybg()
        return 0
    if not (os.path.exists(SHARP) and os.path.exists(BLURRED)):
        print("shani-sway-blur: no wallpaper pair; drawing the wallpaper", file=sys.stderr)
        run_swaybg()
        return 0

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(sock_path)
    except OSError as exc:
        print(f"shani-sway-blur: cannot talk to sway ({exc})", file=sys.stderr)
        run_swaybg()
        return 1

    # The sharp copy until a window says otherwise.
    set_background(SHARP)
    blurred = False

    try:
        # Both: a window changes what is on screen, and so does a workspace
        # change (the wallpaper behind an empty workspace is sharp again).
        send(sock, IPC_SUBSCRIBE, ["window", "workspace"])
        while True:
            payload_type, payload = receive(sock)
            if payload_type is None:
                break
            if payload_type not in (IPC_EVENT_WINDOW, IPC_EVENT_WORKSPACE):
                continue
            if not isinstance(payload, dict):
                continue
            # A window event. Ask for the tree and count what is on screen.
            send(sock, IPC_GET_TREE, [])
            tree = None
            while tree is None:
                reply_type, reply = receive(sock)
                if reply_type is None:
                    break
                # The tree is the reply that carries "nodes"; a window event
                # that arrives while the reply is on its way does not, so the
                # events in between are read and dropped.
                if reply_type == IPC_GET_TREE and isinstance(reply, dict):
                    tree = reply
            if tree is None:
                continue
            want = count_windows(tree) > 0
            if want != blurred:
                blurred = want
                set_background(BLURRED if want else SHARP)
    except (OSError, KeyboardInterrupt):
        pass
    finally:
        sock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
