#!/bin/bash
# The console user's first password.
#
# The `gamescope` account boots straight into Steam through greetd's
# initial_session, which needs no password, so the account is created with a
# LOCKED password: nothing running as the console user can become root (sudo
# and polkit both want a password, and `passwd` wants the current one).
#
# The first password is typed only on a trusted path: at boot, before greetd
# starts any user process, through systemd's password agent (Plymouth or the
# text console). Code running in the console session can only ASK for that
# prompt (--request); it can never answer it or set a password itself.
#
#   --status    (pkexec, console user)  prints "set" or "unset"
#   --request   (pkexec, console user)  ask for the prompt at the next boot
#   --boot      (gamescope-console-password.service, root)  the prompt
#
# Once a password exists this refuses; changing it is `passwd`, which asks
# for the current one.
set -euo pipefail

USER_NAME=gamescope
REQUEST=/var/lib/shani-gamescope/password-requested

[[ $EUID -eq 0 ]] || { echo "Must run as root." >&2; exit 1; }

state=$(passwd -S "$USER_NAME" | awk '{print $2}')
has_password=false
[[ $state == P ]] && has_password=true

from_console_user() {
    [[ -n ${PKEXEC_UID:-} && $PKEXEC_UID == "$(id -u "$USER_NAME")" ]] ||
        { echo "Only the console user can do this." >&2; exit 1; }
}

case ${1:-} in
--status)
    from_console_user
    $has_password && echo set || echo unset
    ;;
--request)
    from_console_user
    if $has_password; then
        echo "The console already has a password. Change it with 'passwd' in a terminal." >&2
        exit 3
    fi
    install -d -m 700 "${REQUEST%/*}"
    : > "$REQUEST"
    echo "Restart the console to set the password."
    ;;
--boot)
    # Never from a session: pkexec sets PKEXEC_UID.
    [[ -z ${PKEXEC_UID:-} ]] || { echo "Runs at boot only." >&2; exit 1; }
    [[ -e $REQUEST ]] || exit 0
    rm -f "$REQUEST"          # one prompt per request, whatever happens
    $has_password && exit 0
    ask() { systemd-ask-password --timeout=120 --id=shani-gamescope-password "$1" || true; }
    for _try in 1 2 3; do
        first=$(ask "Console password (at least 4 characters, empty to skip):")
        [[ -z $first ]] && { echo "Skipped."; exit 0; }
        if (( ${#first} < 4 )) || [[ $first == *:* ]]; then
            echo "At least 4 characters, no ':'."; continue
        fi
        second=$(ask "Repeat the console password:")
        [[ $first == "$second" ]] || { echo "The two passwords differ."; continue; }
        printf '%s:%s\n' "$USER_NAME" "$first" | chpasswd
        echo "Console password set."
        exit 0
    done
    echo "No password set."
    ;;
*)
    echo "usage: ${0##*/} --status | --request | --boot" >&2
    exit 64
    ;;
esac
