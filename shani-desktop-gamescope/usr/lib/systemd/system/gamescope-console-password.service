# The console password prompt, shown at boot only when the owner asked for it
# from the Control Center (Password). It runs as root before greetd starts the
# console session, so no user process exists that could read or answer it;
# the password goes through systemd's own password agents (Plymouth or the
# text console). See /usr/lib/shani-desktop-gamescope/console-password.
[Unit]
Description=Set the console password
After=gamescope-session-user.service plymouth-start.service systemd-vconsole-setup.service
Before=greetd.service display-manager.service
ConditionPathExists=/var/lib/shani-gamescope/password-requested

[Service]
Type=oneshot
ExecStart=/usr/lib/shani-desktop-gamescope/console-password --boot
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
