# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=shani-desktop-niri
pkgver=1.0
pkgrel=26
pkgdesc="Shani OS AI desktop: niri + shani-shell (Chronoa Island, sidebar, dock, Lens) with a Quickshell greeter"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-desktop-niri"
license=('GPL-3.0-only')
depends=(
	# --- compositor + shell ---
	niri
	# bar, launcher, notifications, Chronoa panel and the greetd greeter;
	# niri.service's drop-in starts it (usr/lib/systemd/user/niri.service.d)
	shani-shell
	xwayland-satellite
	# the shell's "what to do with a file": convert pictures, fit a form's
	# size limit (jpeg:extent), shrink a PDF; without them those actions hide
	imagemagick
	# --- login: greetd runs a bare niri hosting shani-shell's Quickshell greeter ---
	greetd
	# --- portals: niri-portals.conf names each interface ---
	# gtk for Access and Notification (what a sandboxed app's permission prompt
	# and portal notifications go through). xdg-desktop-portal-gnome is gone:
	# its Settings/Wallpaper/Screenshot backends are never selected under niri
	# (UseIn=gnome) and the shell writes gsettings itself.
	xdg-desktop-portal-gtk
	# ScreenCast for a wlroots-style compositor: gnome's backend needs mutter,
	# and gtk's has no ScreenCast at all, so a browser's "share screen" had
	# nothing to talk to under niri. portal-wlr speaks zwlr-screencopy, which
	# niri implements; niri-portals.conf names it for ScreenCast.
	xdg-desktop-portal-wlr
	# the keyring (Secret Service): oo7, not gnome-keyring - Rust, no GNOME libraries,
	# moves existing gnome-keyring keyrings over itself, and can unlock from a
	# systemd credential (its unit's ImportCredential=). PAM: etc/pam.d/shani-greetd;
	# started for every user by usr/lib/systemd/user/default.target.wants;
	# Flatpaks' Secret portal: etc/xdg-desktop-portal/niri-portals.conf
	oo7
	# --- keybinds in etc/niri/config.kdl ---
	foot
	# Terminal=true apps and "open in a terminal" from any app: the freedesktop way,
	# with foot as niri's default (etc/xdg/niri-xdg-terminals.list)
	xdg-terminal-exec
	xdg-user-dirs
	xdg-utils
	# --- clipboard: history (spawned by the niri config) and persistence ---
	cliphist
	wl-clip-persist
	# --- input methods: fcitx5, the one IBus alternative that speaks niri's
	#     input-method-v2 (etc/xdg/fcitx5/profile: English + Hindi phonetic) ---
	shani-input-fcitx5
	# --- the apps and services GNOME's metapackage brings natively, which the
	#     niri desktop otherwise lacks (the rest are Flatpaks, flatpak-packages.txt) ---
	# files: the shell's own Files opens folders, and is the Open/Save dialog of
	# sandboxed apps too (shani-shell's file-chooser portal, chosen in
	# niri-portals.conf - so no nautilus); Quick Look previews (not sushi),
	# Archives opens archives (not file-roller) and Disk Usage (not baobab) -
	# etc/skel/.config/mimeapps.list makes them the defaults. gvfs: trash,
	# phones, shares, cameras. Files also writes and formats USB drives and opens
	# disk images (udisks2, which gvfs brings - not gnome-disk-utility)
	gvfs
	gvfs-mtp
	gvfs-smb
	gvfs-gphoto2
	gvfs-afc
	gvfs-nfs
	gvfs-wsdd
	gvfs-dnssd
	ffmpegthumbnailer
	gst-thumbnailers
	webp-pixbuf-loader
	# torrents: qBittorrent - plain Qt 6 (no KDE frameworks), sharing the Qt the
	# shell already loads; not the Fragments Flatpak (GTK, the GNOME runtime)
	qbittorrent
	# calendars Chronoa reads (eds_calendar), and the screen keyboard's
	# word prediction
	evolution-data-server
	hunspell-en_us
	# --- the shell's tiles and Lens; optional in shani-shell, standard here ---
	# user pictures the login screen can read (Settings > Your account sets them)
	accountsservice
	sound-theme-freedesktop
	noise-suppression-for-voice
	swh-plugins                 # SC4: the sound chain's compressor (night mode)
	# Settings > Look > Adaptive palette (colours from the wallpaper,
	# WallpaperStyle/Theme): without it the setting only says it is missing
	matugen
	# the look: GTK 3 apps like GTK 4 ones, Papirus icons, the fonts
	adw-gtk-theme
	papirus-icon-theme
	ttf-jetbrains-mono
	inter-font
	# the camera: libcamera's cam/qcam for stills and the viewfinder, PipeWire
	# (its libcamera plugin + GStreamer's pipewiresrc) for video
	libcamera-tools
	power-profiles-daemon
	polkit
	gsettings-desktop-schemas
	wf-recorder
	wlsunset
	grim
	slurp
	tesseract
	tesseract-data-eng
	# Indian-language OCR data is NOT baked in: the setup wizard downloads
	# each chosen language's traineddata into the user's directory
	# (~/.local/share/shani-chronoa/tessdata, pinned by sha256), so shipping
	# 12 packs here would make every user pay for languages they never pick -
	# and the wizard would download its own copy anyway.
	zbar
	udisks2
	unicode-emoji
	noto-fonts-emoji            # emoji in colour: the launcher and the keyboard's emoji panel
	wl-mirror
	# launcher: fast file and content search, PDF previews
	poppler
	# annotate a screenshot from its notification
	satty
	# (the screen reader, orca, comes with shani-accessibility, as on every profile)
)
install="$pkgname.install"
source=()
md5sums=()

package() {
    # Copy local etc and usr directories
    cp -r "$startdir/etc" "$pkgdir/"
    cp -r "$startdir/usr" "$pkgdir/"
}
