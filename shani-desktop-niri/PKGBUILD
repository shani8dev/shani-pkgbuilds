# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=shani-desktop-niri
pkgver=1.0
pkgrel=3
pkgdesc="Shani OS AI desktop: niri + shani-shell (Chronoa Island, sidebar, dock, Lens) with a Quickshell greeter"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-desktop-niri"
license=('GPL-3.0-only')
depends=(
	# --- compositor + shell ---
	niri
	# bar, launcher, notifications, Chronoa panel and the greetd greeter;
	# niri.service's drop-in starts it (usr/lib/systemd/user/niri.service.d)
	shani-shell
	xwayland-satellite
	# --- login: greetd runs a bare niri hosting shani-shell's Quickshell greeter ---
	greetd
	# --- portals: niri-portals.conf asks for gnome first, gtk as fallback ---
	xdg-desktop-portal-gnome
	xdg-desktop-portal-gtk
	gnome-keyring
	# --- keybinds in etc/niri/config.kdl ---
	foot
	wireplumber
	brightnessctl
	xdg-user-dirs
	xdg-utils
	# --- clipboard: history (spawned by the niri config) and persistence ---
	wl-clipboard
	cliphist
	wl-clip-persist
	# --- input methods: fcitx5, the one IBus alternative that speaks niri's
	#     input-method-v2 (etc/xdg/fcitx5/profile: English + Hindi phonetic) ---
	shani-input-fcitx5
	# --- the apps and services GNOME's metapackage brings natively, which the
	#     niri desktop otherwise lacks (the rest are Flatpaks, flatpak-packages.txt) ---
	# files: the manager (also the portal's file chooser), quick preview,
	# trash/phones/shares/cameras (gvfs), archives, disks, disk usage, thumbnails
	nautilus
	sushi
	gvfs
	gvfs-mtp
	gvfs-smb
	gvfs-gphoto2
	gvfs-afc
	gvfs-nfs
	gvfs-wsdd
	gvfs-dnssd
	file-roller
	gnome-disk-utility
	baobab
	ffmpegthumbnailer
	gst-thumbnailers
	webp-pixbuf-loader
	# software and firmware updates for apps (Flatpak) and devices (fwupd)
	gnome-software
	gnome-firmware
	# the shell's "Advanced connection settings", printers, GPU switching
	nm-connection-editor
	system-config-printer
	switcheroo-control
	xdg-user-dirs-gtk
	# calendars Chronoa reads (eds_calendar), spelling, high-contrast themes
	evolution-data-server
	hunspell-en_us
	gnome-themes-extra
	# --- the shell's tiles and Lens; optional in shani-shell, standard here ---
	networkmanager
	bluez
	bluez-utils
	# user pictures the login screen can read (Settings > Your account sets them)
	accountsservice
	sound-theme-freedesktop
	noise-suppression-for-voice
	swh-plugins                 # SC4: the sound chain's compressor (night mode)
	# the look: GTK 3 apps like GTK 4 ones, Papirus icons, the fonts
	adw-gtk-theme
	papirus-icon-theme
	ttf-jetbrains-mono
	inter-font
	# the camera: libcamera's cam/qcam for stills and the viewfinder, PipeWire
	# (its libcamera plugin + GStreamer's pipewiresrc) for video
	libcamera-tools
	pipewire-libcamera
	gst-plugin-pipewire
	gst-plugins-good
	gst-plugins-base
	upower
	power-profiles-daemon
	polkit
	gsettings-desktop-schemas
	wf-recorder
	wlsunset
	grim
	slurp
	tesseract
	tesseract-data-eng
	zbar
	udisks2
	unicode-emoji
	wl-mirror
	# launcher: fast file and content search, PDF previews
	fd
	ripgrep
	poppler
	# annotate a screenshot from its notification
	satty
	# accessibility: the screen reader
	orca
)
install="$pkgname.install"
source=()
md5sums=()

package() {
    # Copy local etc and usr directories
    cp -r "$startdir/etc" "$pkgdir/"
    cp -r "$startdir/usr" "$pkgdir/"
}
