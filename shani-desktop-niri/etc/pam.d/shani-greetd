#%PAM-1.0
# greetd's sign-in for the niri desktop (/etc/greetd/shani-niri.toml names this
# service): greetd's own stack, plus the keyring (oo7, the Secret Service) —
# unlocked with the login password (and created at the first login), so apps
# never ask for it again. pam_oo7 keeps the password from auth to the session,
# then hands it to oo7-daemon over its socket; on a password change it
# re-encrypts the keyring with the new one.
auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
# Fingerprint, only when asked for at the greeter ("Use fingerprint", or Enter on
# an empty password): greetd runs one conversation, and fprintd holds it until a
# finger or its timeout. The greeter leaves a flag; this takes it. It can only
# choose this path - the finger is still checked - and a miss ends the attempt.
#
# The greeter itself starts with no sign-in, but greetd still calls
# pam_setcred for it, which replays this auth stack's credential step. There,
# pam_exec never runs its program and answers IGNORE, and pam_deny answers a
# credential error: a jump on IGNORE (default=2) or a pam_deny made setcred
# fail, greetd exit and a new install show no setup screen at all (2026-11-15).
# So IGNORE continues (ignore=ignore), a missing fprintd is skipped
# (module_unknown=ignore), and the stop is pam_exec /usr/bin/false - it fails
# a sign-in exactly as pam_deny did and is ignored by setcred.
# The password first after a restart: with no session of this account open yet
# (greeter-signed-in), the fingerprint, the face and the key are jumped over
# (default=5: the five lines below) onto the password, which also unlocks the
# keyring - a finger or a face cannot, so every app would ask for it. In
# setcred pam_exec answers IGNORE: ignore=ignore continues, as above.
auth       [success=ignore ignore=ignore default=5]  pam_exec.so quiet /usr/lib/shani-desktop-niri/greeter-signed-in
auth       [success=ignore ignore=ignore default=2]  pam_exec.so quiet /usr/lib/shani-desktop-niri/greeter-fingerprint
-auth      [success=done module_unknown=ignore ignore=ignore default=die]  pam_fprintd.so max-tries=3 timeout=20
auth       requisite    pam_exec.so quiet /usr/bin/false
# Face (linux-hello, an IR camera), when installed and its daemon is up: a few
# seconds, then the password. Skipped at once when it is not.
-auth      sufficient   pam_linux_hello.so timeout=3000 quiet
# A security key (pam-u2f), registered in Settings > Your account: touched, it signs
# in. No key plugged in, or none registered (nouserok), falls through to the
# password at once. After the fingerprint block, so its default=2 jump (over
# pam_fprintd and the false stop, onto pam_linux_hello) is unchanged.
-auth      sufficient   pam_u2f.so cue [cue_prompt=Touch your security key] nouserok
auth       include      system-local-login
auth       optional     pam_oo7.so
account    include      system-local-login
password   include      system-local-login
password   optional     pam_oo7.so
session    include      system-local-login
session    optional     pam_oo7.so auto_start
