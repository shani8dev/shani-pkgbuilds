# ---------------------------------------------------------------------
text/html=com.vivaldi.Vivaldi.desktop;
application/xhtml_xml=com.vivaldi.Vivaldi.desktop;
application/xhtml+xml=com.vivaldi.Vivaldi.desktop;

# Web URL Schemes (browser-only; app-specific schemes left unset)
x-scheme-handler/ftp=com.vivaldi.Vivaldi.desktop;
x-scheme-handler/http=com.vivaldi.Vivaldi.desktop;
x-scheme-handler/https=com.vivaldi.Vivaldi.desktop;
x-scheme-handler/tel=dev.shani.Link.Dial.desktop;
x-scheme-handler/about=com.vivaldi.Vivaldi.desktop;
x-scheme-handler/chrome=com.vivaldi.Vivaldi.desktop;
x-scheme-handler/unknown=com.vivaldi.Vivaldi.desktop;

# Web File Extensions
application/x-extension-htm=com.vivaldi.Vivaldi.desktop;
application/x-extension-html=com.vivaldi.Vivaldi.desktop;
application/x-extension-shtml=com.vivaldi.Vivaldi.desktop;
application/x-extension-xht=com.vivaldi.Vivaldi.desktop;
application/x-extension-xhtml=com.vivaldi.Vivaldi.desktop;

# Web Archive Formats
application/x-mimearchive=com.vivaldi.Vivaldi.desktop;
application/mhtml=com.vivaldi.Vivaldi.desktop;
application/x-mhtml=com.vivaldi.Vivaldi.desktop;

# WebApps & Progressive Web Apps
application/x-web-app-manifest+json=com.vivaldi.Vivaldi.desktop;
application/manifest+json=com.vivaldi.Vivaldi.desktop;


