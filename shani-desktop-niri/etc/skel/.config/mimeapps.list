# Default apps for every new account (copied from /etc/skel). The shell's own
# apps come first where they handle the type - Text Editor, Media Player, Image
# Viewer, Document Viewer, Archives (dev.shani.*, written by `shani app --write-desktop`) -
# with the Flatpak after it, so it is the fallback and is under "Open with":
# OnlyOffice and Vivaldi
# keep their types. Folders open in the shell's Files (also the Open/Save dialog
# of sandboxed apps: no Nautilus); every archive libarchive reads opens in
# Archives (File Roller is no longer installed).
[Default Applications]
inode/directory=dev.shani.Files.desktop;
# ---------------------------------------------------------------------
# Text Files (Default: the shell's own Text Editor - dev.shani.TextEditor)
# ---------------------------------------------------------------------
text/plain=dev.shani.TextEditor.desktop;
text/markdown=dev.shani.TextEditor.desktop;
text/vnd.trolltech.linguist=dev.shani.TextEditor.desktop;
text/xml=dev.shani.TextEditor.desktop;
application/xml=dev.shani.TextEditor.desktop;
application/json=dev.shani.TextEditor.desktop;
application/x-shellscript=dev.shani.TextEditor.desktop;
text/x-shellscript=dev.shani.TextEditor.desktop;
text/x-python=dev.shani.TextEditor.desktop;
text/x-csrc=dev.shani.TextEditor.desktop;
text/x-chdr=dev.shani.TextEditor.desktop;
text/x-c++=dev.shani.TextEditor.desktop;
text/x-java=dev.shani.TextEditor.desktop;
text/x-ruby=dev.shani.TextEditor.desktop;
text/x-perl=dev.shani.TextEditor.desktop;
text/x-makefile=dev.shani.TextEditor.desktop;
text/x-patch=dev.shani.TextEditor.desktop;
text/x-diff=dev.shani.TextEditor.desktop;

# --- LaTeX, TeX & Scientific Documents ---
application/x-latex=dev.shani.TextEditor.desktop;
application/x-tex=dev.shani.TextEditor.desktop;
application/x-bibtex=dev.shani.TextEditor.desktop;
application/x-texinfo=dev.shani.TextEditor.desktop;


# ---------------------------------------------------------------------
# Calendar (Default: the shell's Calendar - .ics invitations are added to it)
# ---------------------------------------------------------------------
text/calendar=dev.shani.Calendar.desktop;
application/x-vcalendar=dev.shani.Calendar.desktop;
application/x-extension-ics=dev.shani.Calendar.desktop;


# ---------------------------------------------------------------------
# Contacts (Default: Gnome Contacts)
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
