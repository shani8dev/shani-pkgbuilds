post_install() {
    post_upgrade
}

post_upgrade() {
    # greetd aliases itself to display-manager.service, so this is the login screen
    systemctl enable greetd.service
    # the graphics cards (the shell starts an app on the other one through
    # switcheroo-control) and the power modes (the quick-settings tile), as the
    # GNOME and Plasma desktops enable them
    systemctl enable switcheroo-control.service
    systemctl enable power-profiles-daemon.service

    # foot's own package owns /etc/xdg/foot/foot.ini; we ship our themed
    # default as a template to avoid that file conflict, and seed it here.
    # A person's own ~/.config/foot/foot.ini still takes precedence (foot
    # reads user config first), so this only sets the system default.
    if [[ -f /usr/share/shani-desktop-niri/foot.ini ]]; then
        install -Dm644 /usr/share/shani-desktop-niri/foot.ini /etc/xdg/foot/foot.ini
    fi
    # the foot server for every user: footclient windows open in about 90 ms
    # (a foot process of its own: 330 ms) and cost 7 MB each, not 12. Socket
    # activated, so nothing runs until the first terminal; part of the
    # graphical session, so it stops with it
    systemctl --global enable foot-server.socket
}

pre_remove() {
    # `|| true`: it may already be disabled, or replaced by another desktop's DM
    systemctl disable greetd.service || true
    systemctl --global disable foot-server.socket || true
}
