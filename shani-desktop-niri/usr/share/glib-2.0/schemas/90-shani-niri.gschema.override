# The niri desktop's look before anyone opens Settings — the same values
# shani-shell's Settings start with (Settings > Personalisation changes them per
# person). Compiled by pacman's glib2 hook.
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='orange'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
cursor-size=24
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
font-hinting='slight'
font-antialiasing='grayscale'

[org.gnome.desktop.wm.preferences]
# maximize and close on every titlebar; no minimize: niri ignores an app's
# minimize request (the dock and Super+M minimize instead)
button-layout='appmenu:maximize,close'
