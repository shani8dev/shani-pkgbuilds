[Effect-blur]
# Enable blur effect for windows/panels
enabled=true
# KWin 6 keys only — Plasma 5's radius/deviation/brightness/contrast are ignored
# BlurStrength: 0-255, higher = more blur. 30-50 is a good balance for glass effect.
BlurStrength=40
NoiseStrength=0
Saturation=105

[Effect-backgroundcontrast]
# Subtle contrast boost for better text readability on blurred backgrounds
enabled=true
contrast=0.15
intensity=1.1
saturation=1.05

[Effect-wobblywindows]
Drag=85
Stiffness=10
WobblynessLevel=1

[Effect-magiclamp]
enabled=true
duration=350
direction=0

[Effect-overview]
enabled=true
blurEnabled=true
borderWidth=0
borderColor=0,0,0,180
scale=0.12
grid=true
showDesktops=true

[Effect-windowaperture]
enabled=true
radius=120
borderWidth=2
borderColor=255,127,80,60

[Effect-slide]
enabled=true

[Effect-fade]
enabled=true

[Effect-diminactive]
enabled=true

[Plugins]
blurEnabled=true
wobblywindowsEnabled=true
magiclampEnabled=true
overviewEnabled=true
windowapertureEnabled=true
slideEnabled=true
fadeEnabled=true
diminactiveEnabled=true

[ElectricBorders]
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerTiling=true
ElectricBorderCornerRatio=0.25

[TabBox]
LayoutName=org.kde.breeze

[Windows]
BorderlessMaximizedWindows=true
FocusPolicy=0
RaiseOnClick=false
RollOverDesktops=false
Placement=Smart

[Xwayland]
Scale=1

[org.kde.kdecoration2]
BorderSize=Normal
BorderSizeAuto=false
ButtonsOnLeft=XAI
ButtonsOnRight=
library=org.kde.breeze
theme=Breeze

[DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[WindowSwitcher]
LayoutName=org.kde.breeze.desktop