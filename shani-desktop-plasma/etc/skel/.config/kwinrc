[Effect-blur]
# Enable blur effect for windows/panels
# KWin 6 keys only — Plasma 5's radius/deviation/brightness/contrast are ignored
# BlurStrength: 1-15 ONLY (KWin indexes a 15-entry table with it; a larger
# value reads past it and crashes KWin as soon as blur renders). 15 = strongest.
BlurStrength=15
NoiseStrength=0
Saturation=105

[Effect-wobblywindows]
Drag=85
Stiffness=10
WobblynessLevel=1

[Effect-magiclamp]
AnimationDuration=350

[Plugins]
blurEnabled=true
wobblywindowsEnabled=true
magiclampEnabled=true
overviewEnabled=true
windowapertureEnabled=true
slideEnabled=true
fadeEnabled=true
diminactiveEnabled=true

[ElectricBorders]
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerTiling=true
ElectricBorderCornerRatio=0.25

[TabBox]
LayoutName=org.kde.breeze

[Windows]
BorderlessMaximizedWindows=true
FocusPolicy=0
RaiseOnClick=false
RollOverDesktops=false
Placement=Smart

[Xwayland]
Scale=1

[org.kde.kdecoration2]
BorderSize=Normal
BorderSizeAuto=false
ButtonsOnLeft=XIA
# every KWin button: on all desktops, keep above/below, shade, help, and the
# window menu (drawn as the app's icon)
ButtonsOnRight=SFBLHM
# Saturn decoration (build-aurorae.py): Aurorae v2, the C++ engine
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__Saturn-Dark

[DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[WindowSwitcher]
LayoutName=org.kde.breeze.desktop