[Desktop Entry]
Type=Application
Name=Shani Theme Sync
Comment=Keeps Kvantum, GTK app style, Konsole and Yakuake in sync with the active Saturn color scheme, including automatic light/dark switches
Exec=/usr/lib/shani/shani-theme-sync.sh --watch
OnlyShowIn=KDE;
NoDisplay=true
X-KDE-autostart-phase=1
