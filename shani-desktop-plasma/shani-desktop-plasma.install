FONT_DIRS=("/usr/share/fonts/TTF" "/usr/share/fonts/OTF" "/usr/share/fonts/misc")
ICON_DIRS=("/usr/share/icons/hicolor" "/usr/share/icons/Saturn")
GLIB_SCHEMA_DIR="/usr/share/glib-2.0/schemas"

update_fonts() {
    for dir in "${FONT_DIRS[@]}"; do
        [[ -d "$dir" ]] || continue
        mkfontscale "$dir" 2>/dev/null
        mkfontdir   "$dir" 2>/dev/null
    done
    fc-cache -s 2>/dev/null
}

update_gtk() {
    [[ -d "$GLIB_SCHEMA_DIR" ]] && glib-compile-schemas "$GLIB_SCHEMA_DIR" 2>/dev/null
    for dir in "${ICON_DIRS[@]}"; do
        [[ -d "$dir" ]] && gtk-update-icon-cache -ftq "$dir" 2>/dev/null
    done
    command -v dconf                  &>/dev/null && dconf update 2>/dev/null
    command -v update-desktop-database &>/dev/null && update-desktop-database --quiet 2>/dev/null
    command -v update-mime-database    &>/dev/null && update-mime-database /usr/share/mime 2>/dev/null
}

update_kde() {
    command -v kbuildsycoca6 &>/dev/null && kbuildsycoca6 --noincremental 2>/dev/null
}

# Brand the Plasma Login Manager greeter (plasmalogin). The greeter runs as
# its own system user and reads Plasma appearance defaults from
# /var/lib/plasmalogin/.config/kdedefaults/ - without these it shows stock
# Breeze regardless of the installed theme. "Apply Plasma Settings" in the
# KCM is supposed to write these but does not cover all keys reliably.
provision_plasmalogin() {
    getent passwd plasmalogin >/dev/null 2>&1 || return 0

    local d=/var/lib/plasmalogin/.config/kdedefaults
    install -d -m 755 -o plasmalogin -g plasmalogin "$d"

    cat > "$d/kdeglobals" <<'EOF'
[General]
ColorScheme=SaturnDark

[Icons]
Theme=breeze-dark

[KDE]
widgetStyle=kvantum
LookAndFeelPackage=Saturn-Dark
EOF

    # Kvantum ignores kdedefaults/: it reads $XDG_CONFIG_HOME/Kvantum/kvantum.kvconfig
    local k=/var/lib/plasmalogin/.config/Kvantum
    install -d -m 755 -o plasmalogin -g plasmalogin "$k"
    cat > "$k/kvantum.kvconfig" <<'EOF'
[General]
theme=SaturnDark
EOF
    chown plasmalogin:plasmalogin "$k/kvantum.kvconfig"
    rm -f "$d/kvantum.kvconfig"

    cat > "$d/plasmarc" <<'EOF'
[Theme]
name=Saturn-Dark
EOF

    cat > "$d/kcminputrc" <<'EOF'
[Mouse]
cursorTheme=Saturn
EOF

    chown plasmalogin:plasmalogin "$d"/kdeglobals "$d"/plasmarc "$d"/kcminputrc
}

post_install() {
    post_upgrade
}

post_upgrade() {
	systemctl enable plasmalogin.service
	systemctl enable plasma-setup.service
	systemctl enable switcheroo-control.service
	systemctl enable power-profiles-daemon.service
	echo "Performing misc postinstall operations..."
	update_fonts
	update_gtk
	update_kde
	provision_plasmalogin
}
