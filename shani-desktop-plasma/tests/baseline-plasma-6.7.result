# Baseline: shani-desktop-plasma Saturn theming on Plasma 6.7
#
# PURPOSE: the package builds fine even when the theme renders wrong, so
# there is no build-time signal for a theming regression. This file is the
# known-good state to diff a future run against. Any RESULT line that is not
# PASS is the regression. DETAIL lines carry per-shot pixel margins and are
# informational only - do not diff them, the counts vary run to run.
#
# Regenerate with (one container, all three looks, ~2.6G install):
#   docker run --rm -v "$PWD:/pkg:ro" -v "$PWD/out:/out" archlinux:latest bash -c '
#     pacman -Sy --noconfirm
#     pacman -S --noconfirm --needed --overwrite "*" plasma-desktop \
#       plasma-workspace kwin-x11 kvantum kde-gtk-config breeze-gtk dolphin \
#       konsole yakuake fish gtk3-demos gtk4-demos wmctrl xorg-server-xvfb \
#       xdotool imagemagick discover plasma-systemmonitor kate kcalc
#     for L in Saturn-Dark Saturn Saturn-Twilight; do
#       SCREEN=1920x1080 bash /pkg/tests/plasma-session.sh "$L" "/out/$L"
#     done' | grep -E '^(RESULT|DETAIL)' > out/all.result
#   diff <(grep '^RESULT' tests/baseline-plasma-6.7.result) <(grep '^RESULT' out/all.result)
#
# CAPTURED: 2026-09-26, all three looks, 39 RESULT lines, 0 failures
# PLASMA:   plasma-workspace 6.7.5-1 (Arch extra; confirmed with pacman -Si)
# EXITS:    HARNESS_EXIT=0 for Saturn-Dark, Saturn and Saturn-Twilight
#
# All three yakuake-*.log files are 0 bytes: the 'Could not find \'\'' warning
# (empty inherited Command) is gone, and each shell resolution assertion passes.

