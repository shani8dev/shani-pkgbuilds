# Saturn (ShaniOS) Kvantum theme
# Derived from MacTahoe KDE theme (c) Vince Liuice, GPL-3.0
[%General]
theme=Saturn
author=Shani OS Team; original MacTahoe by Vince Liuice
comment=Saturn (ShaniOS) light theme with translucency; derived from MacTahoe (c) Vince Liuice

x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=true
joined_inactive_tabs=false
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=4
spread_menuitems=false
transient_scrollbar=false
splitter_width=1
slider_width=6
slider_handle_width=34
slider_handle_length=34
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=true
blurring=true
popup_blurring=true
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=true
groupbox_top_label=false
inline_spin_indicators=true
submenu_overlap=0
tooltip_delay=-1
button_contents_shift=false
animate_states=true
dark_titlebar=true
hide_combo_checkboxes=false
layout_margin=4
no_window_pattern=false
reduce_window_opacity=12
respect_DE=true
spin_button_width=24
submenu_delay=250
transient_groove=false
tree_branch_line=true
no_inactiveness=false
reduce_menu_opacity=12
click_behavior=0
contrast=1.00
dialog_button_layout=0
intensity=1.00
saturation=1.00
scrollable_menu=true
shadowless_popup=false
drag_from_buttons=false
menu_blur_radius=2
tooltip_blur_radius=2

[GeneralColors]
window.color=#f5f5f5
inactive.window.color=#f5f5f5
base.color=#ffffff
inactive.base.color=#ffffff
alt.base.color=#fafafa
inactive.alt.base.color=#fafafa
button.color=#ffffff
light.color=#ffffff
mid.light.color=#eeeeee
dark.color=#bbbbbb
mid.color=#dddddd
highlight.color=#ff7f50
inactive.highlight.color=#ff7f50
text.color=#333333
inactive.text.color=#666666
window.text.color=#333333
inactive.window.text.color=#666666
button.text.color=#333333
disabled.text.color=#33333374
tooltip.base.color=#f5f5f5
tooltip.text.color=#333333
highlight.text.color=#ffffff
inactive.highlight.text.color=#343434
link.color=#ff7f50
link.visited.color=#452886
progress.indicator.text.color=#ffffff

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=100
lxqtmainmenu_iconsize=16
middle_click_scroll=false
no_selection_tint=true
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_view=true
opaque_colors=false
scroll_jump_workaround=false
centered_forms=false
kinetic_scrolling=false
noninteger_translucency=false
transparent_arrow_button=true
blur_only_active_window=false
style_vertical_toolbars=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
text.normal.color=#333333
text.focus.color=#242424
text.press.color=#242424
text.toggle.color=#ffffff
text.normal.inactive.color=#33333374
text.toggle.inactive.color=#ffffff74
text.shadow=false
text.margin=6
text.iconspacing=6
frame.expansion=12
min_width=28
min_height=28

[Window]
frame=false
interior=true
interior.element=window

[WindowTranslucent]
interior=true
interior.element=window
interior.x.patternsize=48
interior.y.patternsize=48

[Dialog]
inherits=Window

[Menu]
frame=true
frame.element=menu
interior=true
interior.element=menu
text.margin=0

[MenuItem]
frame=true
frame.element=menuitem
interior=true
interior.element=menuitem
indicator.element=arrow
text.normal.color=#333333
text.focus.color=#242424
text.press.color=#242424
text.toggle.color=#ffffff
text.normal.inactive.color=#33333374

[MenuBar]
frame=true
frame.element=menubar
interior=true
interior.element=menubar
text.normal.color=#333333
text.focus.color=#242424
text.press.color=#242424
text.toggle.color=#ffffff
text.normal.inactive.color=#33333374
frame.expansion=0
text.bold=false

[ToolTip]
frame=true
frame.element=tooltip
interior=true
interior.element=tooltip
text.margin=4

[MenuBarItem]
inherits=MenuBar
frame=true
frame.element=menubaritem
interior=true
interior.element=menubaritem
text.normal.color=#333333
text.focus.color=#242424
text.press.color=#242424
text.toggle.color=#ffffff
text.normal.inactive.color=#33333374

# --- Remaining sections preserved manually ---
# Run: python3 build-kvantum.py --regenerate-svg to update SVG opacities
