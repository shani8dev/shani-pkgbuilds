[Wallpaper]
defaultWallpaperTheme=Saturn
defaultFileSuffix=.png
defaultWidth=1920
defaultHeight=1080

[AdaptiveTransparency]
enabled=true

# KWin's background-contrast behind blurred shell surfaces: keeps text
# legible on busy wallpapers without making the glass opaque.
[ContrastEffect]
enabled=true
contrast=0.2
intensity=0.6
saturation=1.7
