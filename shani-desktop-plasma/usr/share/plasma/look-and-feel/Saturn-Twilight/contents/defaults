[kdeglobals][KDE]
widgetStyle=kvantum
DefaultLightLookAndFeel=Saturn-Light
DefaultDarkLookAndFeel=Saturn
# Twilight is a deliberate fixed mood - do not auto-flip it day/night
AutomaticLookAndFeel=false
LookAndFeelPackage=Saturn-Twilight

[kdeglobals][General]
ColorScheme=SaturnTwilight
SingleClick=false
ShowDeleteCommand=true
ShowPreview=false
Font=Noto Sans,10,-1,5,50,0,0,0,0,0

[kdeglobals][Icons]
Theme=Saturn

[kvantum.kvconfig][General]
theme=SaturnTwilight

[plasmarc][Theme]
name=breeze-dark

[kscreenlockerrc][Greeter]
WallpaperPlugin=org.kde.image

[kscreenlockerrc][Greeter][Wallpaper][org.kde.image][General]
Image=file:///usr/share/wallpapers/Saturn/contents/images_twilight/1920x1080.png

[Wallpaper]
Image=file:///usr/share/wallpapers/Saturn/contents/images_twilight/1920x1080.png

[kcminputrc][Mouse]
cursorTheme=Saturn

[KSplash]
Theme=Saturn-Twilight

[kwinrc][NightColor]
Active=true
NightTemperature=4300

[kwinrc][Plugins]
overviewEnabled=true
coverswitchEnabled=true
translucencyEnabled=true
backgroundblurEnabled=true
backgroundcontrastEnabled=true
blurEnabled=true
wobblywindowsEnabled=true
magiclampEnabled=true
desktopgridEnabled=true

[kwinrc][Effect-blur]
enabled=true
radius=10
deviation=20
brightness=1.05
contrast=1.05
saturation=1.05
noise=0.015

[kwinrc][Effect-translucency]
enabled=true
blurEnabled=true
noise=0.015
brightness=1.0
contrast=1.05
saturation=1.05

[kwinrc][Effect-backgroundblur]
enabled=true
radius=14
deviation=28
brightness=1.08
contrast=1.08
saturation=1.05
noise=0.015

[kwinrc][Effect-backgroundcontrast]
enabled=true
contrast=1.25
intensity=0.35
saturation=1.15

[kwinrc][Plugins]
overviewEnabled=true
coverswitchEnabled=true
translucencyEnabled=true
backgroundblurEnabled=true
backgroundcontrastEnabled=true
blurEnabled=true
wobblywindowsEnabled=true
magiclampEnabled=true
desktopgridEnabled=true

[kwinrc][ElectricBorders]
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerTiling=true
ElectricBorderCornerRatio=0.25

[kwinrc][Windows]
BorderlessMaximizedWindows=true
FocusPolicy=0
RaiseOnClick=false
RollOverDesktops=false
Placement=Smart

[kwinrc][DesktopSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][WindowSwitcher]
LayoutName=org.kde.breeze.desktop

[kwinrc][org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=Saturn
BorderSize=None
BorderSizeAuto=false
ButtonsOnLeft=XIA
ButtonsOnRight=

[ElectricBorders]
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerTiling=true
ElectricBorderCornerRatio=0.25

[.gtkrc-2.0]
gtk-theme-name=Breeze-Dark

[gtk-3.0/settings.ini][Settings]
gtk-theme-name=Breeze-Dark
gtk-application-prefer-dark-theme=true
gtk-font-name=Noto Sans, 10
gtk-icon-theme-name=Saturn
gtk-cursor-theme-name=Saturn
gtk-cursor-theme-size=24
gtk-decoration-layout=icon:minimize,maximize,close
gtk-overlay-scrolling=false
gtk-primary-button-warps-slider=false
gtk-enable-event-sounds=true
gtk-enable-input-feedback-sounds=true

[gtk-4.0/settings.ini][Settings]
gtk-theme-name=Breeze-Dark
gtk-application-prefer-dark-theme=true
gtk-font-name=Noto Sans, 10
gtk-icon-theme-name=Saturn
gtk-cursor-theme-name=Saturn
gtk-cursor-theme-size=24
gtk-decoration-layout=icon:minimize,maximize,close
gtk-overlay-scrolling=false
gtk-primary-button-warps-slider=false
gtk-enable-event-sounds=true
