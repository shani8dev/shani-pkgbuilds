# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=shani-fonts
pkgver=1.3
pkgrel=5
pkgdesc="Fonts for Shani OS"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-fonts"
source=(90-indian-fonts.conf
        70-noto-cjk.conf
        75-noto-color-emoji.conf)
sha256sums=('SKIP'
        'SKIP'
        'SKIP')
depends=(
    noto-fonts
    noto-fonts-cjk
    noto-fonts-emoji
    # Nerd Font glyphs as a fontconfig fallback for monospace fonts (GTK
    # terminals): the starship prompt, eza icons and the tmux status bar
    ttf-nerd-fonts-symbols-mono
    # Terminal font (20 MiB; JetBrains Mono Nerd is 232 MiB). Qt (Konsole,
    # Yakuake) does no fallback for BMP private-use glyphs, so the Konsole
    # profile needs a Nerd-patched font, not just the symbols fallback
    otf-firamono-nerd
)
license=('GPL-3.0-only')
package() {
	mkdir -p "$pkgdir"/etc/fonts/conf.d
	install -D -m644 90-indian-fonts.conf "$pkgdir"/etc/fonts/conf.d/90-indian-fonts.conf
	install -D -m644 70-noto-cjk.conf "$pkgdir"/etc/fonts/conf.d/70-noto-cjk.conf
	install -D -m644 75-noto-color-emoji.conf "$pkgdir"/etc/fonts/conf.d/75-noto-color-emoji.conf
}
