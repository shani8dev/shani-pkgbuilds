# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>

pkgname=shani-keyring
pkgver=20241020
pkgrel=5
pkgdesc='Shani PGP keyring'
arch=('any')
url='https://github.com/shani8dev/shani-keyring/'
license=('GPL-3.0-or-later')
# bash and gnupg MUST be installed before this package. The generated .INSTALL
# scriptlet is exec'd with the bash shebang and calls `pacman-key --populate
# shani`, which needs gpg. shani-keyring is listed FIRST in
# image_profiles/*/Packages-Base; with no depends=(), pacstrap tried to
# install it before bash existed, so the scriptlet's execv failed and the
# shani key was never populated into the built image's pacman keyring
# (downstream phases then reported "error: shani: key ... is unknown").
depends=('bash' 'gnupg')
install=$pkgname.install
source=('https://raw.githubusercontent.com/shani8dev/shani-keyring/main/shani.gpg'
        'https://raw.githubusercontent.com/shani8dev/shani-keyring/main/shani-revoked'
        'https://raw.githubusercontent.com/shani8dev/shani-keyring/main/shani-trusted')
# These fetch from a mutable `main` branch — unlike a git+ VCS source pinned
# to a commit, SKIP here would mean this trust-root package (it's what makes
# the [shani] repo trusted system-wide) has no integrity check at all, and a
# future rebuild would silently pick up whatever's on that branch at build
# time. Pinned to the content as of 2026-08-21; bump these deliberately via
# `updpkgsums` (with a pkgver/pkgrel bump) if the upstream keyring changes —
# never restore SKIP.
sha256sums=('e7fe040d2be0beb9ac53645276df0001eb997431cc4497c844c707af896a0e22'
            'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'
            'fb4f108d4fe0209ac70a8f4aac11376ddfe6d2ff15fa96a8e7942620ab82f28d')
validpgpkeys=('7B927BFFD4A9EAAA8B666B77DE217F3DA8014792') # Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>

package() {
    install -d "$pkgdir/usr/share/pacman/keyrings"

    # Installing the Shani keyring files
    for f in shani.gpg shani-trusted shani-revoked; do
        install -m644 "$srcdir/$f" "$pkgdir/usr/share/pacman/keyrings/"
    done
}

