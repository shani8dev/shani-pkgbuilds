# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>
pkgname=shani-peripherals
pkgver=1.0
pkgrel=9
pkgdesc="peripheral devices and tools for Shani OS"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-peripherals"
depends=(
	fprintd
	linuxconsole
	lirc
	gpsd
	opensc
	ccid
	pam_pkcs11
	libnfc
	acsccid
	libfido2
	pam-u2f
	pam-krb5
	libdvdcss
	bolt
	android-udev
	game-devices-udev
	iio-sensor-proxy
	libratbag
	geoclue
	# NUT, not apcupsd, is the UPS daemon. apcupsd has had no upstream
	# release since 3.14.14 (2016/2017) while NUT is at 2.8.5 with its data
	# model published as IETF RFC 9271, 170+ manufacturers, serial/USB/SNMP/
	# IPMI, and an `apcupsd-ups` driver that still reaches apcupsd hardware.
	# shani-settings ships the baseline config and generates the monitor
	# credential in its install hook. apcupsd stays available as an optdepend
	# for anyone who wants its single-file model.
	nut
	apcupsd
	usbmuxd
	upower

	# User-facing CLIs for the hardware-auth stack above. The docs used to
	# tell users to `nix-env -iA nixpkgs.yubikey-manager` (and the same for
	# pcsc-tools and oath-toolkit) because these were not shipped. All three
	# are in the official Arch repos, so there is no reason to make a user
	# install a second package manager to read their own security key. They sit
	# here rather than in shani-core because they are peripheral tools, and
	# because they are only useful alongside the readers and PAM modules this
	# package already pulls in.
	yubikey-manager
	pcsc-tools
	oath-toolkit
)
license=('GPL-3.0-only')
install="$pkgname.install"
