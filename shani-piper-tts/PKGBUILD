# Maintainer: Shrinivas Kumbhar <shrinivasvkumbhar@gmail.com>
# shani-piper-tts: the Piper neural TTS engine (prebuilt), wrapped as
# /usr/bin/piper-tts so Shani Chronoa finds it with shutil.which().
# Adapted from AUR piper-tts-bin 2023.11.14-2; the tarball digest matches
# the one shani-chronoa's provisioner pins (voices.py:_PIPER).
pkgname=shani-piper-tts
pkgver=2023.11.14
pkgrel=2
pkgdesc="Piper neural text-to-speech engine (prebuilt) for ShaniOS"
arch=('x86_64')
url="https://github.com/rhasspy/piper"
license=('MIT')
depends=('gcc-libs' 'glibc')
provides=('piper-tts')
conflicts=('piper-tts-bin' 'piper-tts-git')
source=("piper_linux_x86_64.tar.gz::https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz"
        "piper-tts.sh")
sha256sums=('a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992'
            '79fef77f228423f8f6f54fe1be7d726c96b2c9f1ac849a9386fdd85886463aa9')

package() {
  install -d -m755 "$pkgdir"/opt "$pkgdir"/usr/bin
  mv "$srcdir"/piper "$pkgdir"/opt/piper-tts
  install -Dm755 "$srcdir"/piper-tts.sh "$pkgdir"/usr/bin/piper-tts
}
