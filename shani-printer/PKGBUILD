pkgname=shani-printer
pkgver=1.2
pkgrel=8
pkgdesc="Printer support tools and drivers for Shani OS"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-printer"
depends=(
    # Core printing stack
    cups
    cups-filters
    cups-pdf
    cups-browsed
    cups-pk-helper
    ipp-usb
    ghostscript
    gsfonts
    a2ps
    # Foomatic database (legacy & wide coverage)
    foomatic-db
    foomatic-db-engine
    foomatic-db-ppds
    foomatic-db-gutenprint-ppds
    # Generic / open-source drivers
    gutenprint
    splix
    # Vendor-supported drivers not in official repos
    hplip-minimal
    #epson-inkjet-printer-escpr
    foo2zjs-nightly
    brlaser
    cnijfilter2
)
license=('GPL-3.0-only')
install="$pkgname.install"

