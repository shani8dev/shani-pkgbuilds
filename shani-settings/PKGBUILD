# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>

pkgname=shani-settings
pkgver=0.0.5
pkgrel=44
arch=('any')
url="https://github.com/shani8dev/$pkgname"
license=('GPL-3.0-only')
pkgdesc="Shani OS settings"

_commit='592715ed053de5f8a48d7e77116a8b78b8f5c774'
source=("shani-settings.tar.gz::https://github.com/shani8dev/$pkgname/archive/${_commit}.tar.gz")
sha256sums=('SKIP')

depends=(
  'btrfsmaintenance'
  'systemd-oomd-defaults'
  'zram-generator'
  'ananicy-cpp'
  'gamemode'
  'irqbalance'
  'plymouth'
  'bash-completion'
  'fish'
  'zsh'
  'zsh-autosuggestions'
  'zsh-completions'
  'zsh-syntax-highlighting'
  'zsh-history-substring-search'
  'starship'
  'fzf'
  'mcfly'
  # referenced by the shipped shell/git configs (usr/share/shani/shell,
  # etc/gitconfig): delta is git's pager, so it must be present
  'git-delta'
  'bat'
  'eza'
  'fd'
  'zoxide'
  'samba'
)
makedepends=('polkit')
backup=(etc/sudoers.d/{editor,insults,pwfeedback} etc/gitconfig etc/tmux.conf)
install="$pkgname.install"

package() {
  install -d "$pkgdir/etc" "$pkgdir/usr"

  # Copy configuration files
  cp -r "$srcdir/$pkgname-${_commit}/etc" "$pkgdir/"
  cp -r "$srcdir/$pkgname-${_commit}/usr" "$pkgdir/"

  # Permissions for security-sensitive configs (Lynis AUTH + FILE-7524).
  # Directory modes are set on the directories ONLY: a recursive
  # `chmod 750 -R` here used to run after the per-file modes and reset every
  # sudoers drop-in to 0750 (executable; `visudo -c`: "bad permissions,
  # should be mode 0440") and every polkit rule to 0750.
  chmod 750 "$pkgdir/etc/sudoers.d"
  chmod 0440 "$pkgdir"/etc/sudoers.d/*
  # rules.d itself is owned by Arch's polkit package as 755 root:root;
  # a different mode/owner here is a pacman "permissions differ" conflict.
  chmod 755 "$pkgdir/usr/share/polkit-1/rules.d"
  chmod 0644 "$pkgdir"/usr/share/polkit-1/rules.d/*

  # Fix skel directory permissions — git does not preserve them
  chmod 700 "$pkgdir/etc/skel/.ssh"
  chmod 700 "$pkgdir/etc/skel/.gnupg"
  mkdir -p "$pkgdir/var/lib/samba/usershare"
  chmod 1770 "$pkgdir/var/lib/samba/usershare"

}
