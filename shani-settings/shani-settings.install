post_install() {
	post_upgrade
}

# Post upgrade
add_users_to_sambashare() {
	_l="/etc/login.defs"
	_p="/etc/passwd"
	## get min UID limit ##
	l=$(grep "^UID_MIN" $_l)
	## get max UID limit ##
	l1=$(grep "^UID_MAX" $_l)
	## print users with UID in range and a valid login shell ##
	users=$(awk -F':' -v "min=${l##UID_MIN}" -v "max=${l1##UID_MAX}" \
		'{ if ( $3 >= min && $3 <= max && $7 != "/sbin/nologin" ) print $0 }' \
		"$_p" | cut -d: -f1)
	for i in $users; do
		echo "Adding user '$i' to group 'sambashare'"
		usermod -a -G sambashare "$i"
	done
}

add_samba_group() {
	getent group "sambashare" &>/dev/null || groupadd -r sambashare
	add_users_to_sambashare
	chgrp sambashare var/lib/samba/usershare
}

post_install() {
	post_upgrade
}

# ---------------------------------------------------------------------------
# Network UPS Tools
#
# Nothing under /etc/nut is ours to ship. The four configs live in
# /usr/share/shani/nut/ as templates and are installed from here, because
# `nut` owns /etc/nut/{nut,ups,upsd,upsmon}.conf and shani-peripherals
# depends on `nut` - so a package that shipped them collided with it on
# every profile and pacstrap refused the whole transaction with "conflicting
# files". Pacman has no primitive for taking over *some* files of another
# package: replaces=(nut) would take its binaries too. So `nut` keeps
# ownership and we write the content here, which is the same decision already
# made below for upsd.users and the MONITOR line.
#
# Taking a file over is not the same as owning it. Each template is written
# only while the file on disk is provably not the admin's:
#
#  - content already equals our template            -> nothing to do
#  - content equals what we last installed           -> ours, so refresh it,
#                                                      which is how a fixed
#                                                      baseline reaches an
#                                                      existing install
#  - file absent, or still byte-identical to `nut`'s -> take it over
#  - anything else                                  -> the admin's; leave it,
#                                                      and say so
#
# The manifest is what makes the second case possible. Without it, every file
# we had ever written would look "modified" against `nut` forever, and a
# corrected baseline could never reach an existing install again.
install_nut_baseline() {
	local tdir=/usr/share/shani/nut
	local manifest=/var/lib/shani-settings/nut-baseline.sha256
	local -a files=(nut.conf ups.conf upsd.conf upsmon.conf)
	local f want have recorded stock took=0 skipped=0

	[ -d "$tdir" ] || {
		echo "shani-settings: $tdir is missing; cannot install the NUT baseline"
		return 1
	}
	mkdir -p "$(dirname "$manifest")" || return 1

	# `pacman -Qkk` lists absent files too, so ask for the reason explicitly
	# rather than testing for the path appearing in the output at all.
	stock=$(pacman -Qkk nut 2>/dev/null)

	tmp=$(mktemp) || return 1
	for f in "${files[@]}"; do
		want=$(sha256sum "$tdir/$f" | cut -d' ' -f1)
		if [ -e "/etc/nut/$f" ]; then
			have=$(sha256sum "/etc/nut/$f" | cut -d' ' -f1)
		else
			have=
		fi
		recorded=$(awk -v k="$f" '$2 == k { print $1 }' "$manifest" 2>/dev/null)

		if [ "$have" = "$want" ]; then
			printf '%s  %s\n' "$want" "$f" >>"$tmp"
			continue
		fi

		recorded=$(awk -v k="$f" '$2 == k { print $1 }' "$manifest" 2>/dev/null)

		if [ ! -e "/etc/nut/$f" ]; then
			# Gone, whoever removed it. A file that is not there is nobody's
			# edit, and NUT is broken without it, so put it back and say so.
			# (Deleting one to disable NUT is not a supported flow here -
			# ups.conf ships with no device section and ALLOW_NO_DEVICE keeps
			# the stack inert, so there is nothing to disable.)
			echo "shani-settings: /etc/nut/$f was missing; restoring it"
		elif [ -z "$recorded" ]; then
			# We have never written this one. It is ours to take only if it
			# is still exactly what nut shipped; anything else is the admin's.
			if grep -qF "warning: nut: /etc/nut/$f (Modification detected)" <<<"$stock"; then
				echo "shani-settings: /etc/nut/$f was modified; leaving it as-is"
				skipped=$((skipped + 1))
				continue
			fi
		elif [ "$have" != "$recorded" ]; then
			# We wrote this file before and what is on disk is not what we
			# wrote, so the admin has edited it - and that is the end of it.
			# Do not consult pacman, which by now reports every file here as
			# "Modification detected" precisely because we took it over, and
			# would otherwise authorise clobbering all of them.
			echo "shani-settings: /etc/nut/$f was modified; leaving it as-is"
			skipped=$((skipped + 1))
			continue
		fi

		install -Dm644 "$tdir/$f" "/etc/nut/$f" || {
			rm -f "$tmp"
			return 1
		}
		printf '%s  %s\n' "$want" "$f" >>"$tmp"
		took=$((took + 1))
	done

	mv -f "$tmp" "$manifest" || return 1
	[ "$took" = 0 ] && [ "$skipped" = 0 ] && return 0
	echo "shani-settings: NUT baseline installed ($took updated, $skipped left alone)"
	return 0
}

# ---------------------------------------------------------------------------
# Network UPS Tools
#
# Three things have to happen for NUT to be usable on a Shanios install, and
# none of them can be a shipped file:
#
#  0. the four configs, laid down from /usr/share/shani/nut/ because `nut`
#     owns those paths - see install_nut_baseline above.
#
#  1. upsd.users and upsmon.conf's MONITOR line must share a monitor password,
#     and it must NOT be a static fleet-wide value. `upsmon master` permits a
#     forced shutdown of the UPS, so a known password on a loopback upsd is a
#     local power-off primitive — every install would ship one credential that
#     turns off every other machine's UPS. Generated once per install instead.
#  2. ups.conf has no device section (deliberately — see the file), so nothing
#     is monitoring anything yet. The units still need to be up: ALLOW_NO_DEVICE
#     is what lets upsd start with nothing to serve, so a UPS plugged in later
#     is picked up without anyone re-enabling anything.
#
# Idempotent by marker: the MONITOR insert is bracketed by BEGIN/END comments in
# the shipped upsmon.conf, and a populated bracket means "the hook already ran".
# post_install calls post_upgrade, so the package's first install and every
# upgrade both land here, and neither regenerates a credential that already
# exists.
add_nut_monitor_user() {
	# Already configured? Then leave it exactly as it is.
	if grep -qE '^[[:space:]]*MONITOR[[:space:]]' /etc/nut/upsmon.conf 2>/dev/null; then
		return 0
	fi

	local pin
	# /dev/urandom + base64, not $RANDOM: 32 random bytes, and not a value an
	# attacker can narrow by knowing roughly when the install happened.
	pin=$(head -c 32 /dev/urandom | base64 | tr -d '\n=+/' | cut -c1-24)
	if [ ${#pin} -lt 16 ]; then
		echo "shani-settings: could not generate a NUT monitor credential; UPS monitoring needs one"
		return 1
	fi

	# 0640, not world-readable: this file holds the credential that can force a
	# UPS power-down. root:nut would be tighter still, but the `nut` user is not
	# guaranteed to exist before the package's own files are in place.
	cat > /etc/nut/upsd.users <<EOF
[monuser]
	password = $pin
	upsmon master
EOF
	chmod 0640 /etc/nut/upsd.users

	# The UPS name is whatever the device section in ups.conf is called; with no
	# device configured there is none yet, so the hook writes the conventional
	# one and the user renames it with the section if they name theirs.
	local upsname=myups
	if grep -qE '^\[' /etc/nut/ups.conf 2>/dev/null; then
		upsname=$(grep -m1 -oE '^\[[^]]+\]' /etc/nut/ups.conf | tr -d '[]')
	fi

	# Insert inside the shipped markers, leaving the comments above them intact.
	python3 - /etc/nut/upsmon.conf "$upsname" "$pin" <<'PY' || return 1
import sys, pathlib
conf, name, pin = sys.argv[1], sys.argv[2], sys.argv[3]
p = pathlib.Path(conf)
text = p.read_text(encoding="utf-8")
line = f"MONITOR {name}@localhost 1 monuser {pin} master"
begin = "# BEGIN shani-settings MONITOR (generated by the install hook; do not edit by hand)"
end = "# END shani-settings MONITOR"
if begin not in text or end not in text:
    sys.exit("markers not found in upsmon.conf")
p.write_text(text.replace(end, line + "\n" + end, 1), encoding="utf-8")
PY

	echo "shani-settings: configured a NUT monitor user for '$upsname' (upsmon.conf + upsd.users)"
}

post_upgrade() {
	echo "Attempting to enable services..."
	systemctl enable btrfs-balance.timer
	systemctl enable btrfs-defrag.timer
	systemctl enable btrfs-scrub.timer
	systemctl enable btrfs-trim.timer
	systemctl enable systemd-oomd
	systemctl enable systemd-timesyncd
	systemctl enable ananicy-cpp
	systemctl enable irqbalance
	systemctl --global enable gamemoded
	plymouth-set-default-theme bgrt
	add_samba_group

	# NUT: lay down the baseline config, then generate the monitor credential
	# and bring the stack up. All three stages are in the hook rather than in
	# shipped files, for the reasons in their comments.
	install_nut_baseline
	add_nut_monitor_user
	systemctl enable nut-server.service
	systemctl enable nut-monitor.service
	systemctl enable nut-logger.service
	systemctl enable nut-driver.target
}
