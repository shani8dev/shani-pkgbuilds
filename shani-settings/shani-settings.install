post_install() {
	post_upgrade
}

# Post upgrade
add_users_to_sambashare() {
	_l="/etc/login.defs"
	_p="/etc/passwd"
	## get min UID limit ##
	l=$(grep "^UID_MIN" $_l)
	## get max UID limit ##
	l1=$(grep "^UID_MAX" $_l)
	## print users with UID in range and a valid login shell ##
	users=$(awk -F':' -v "min=${l##UID_MIN}" -v "max=${l1##UID_MAX}" \
		'{ if ( $3 >= min && $3 <= max && $7 != "/sbin/nologin" ) print $0 }' \
		"$_p" | cut -d: -f1)
	for i in $users; do
		echo "Adding user '$i' to group 'sambashare'"
		usermod -a -G sambashare "$i"
	done
}

add_samba_group() {
	getent group "sambashare" &>/dev/null || groupadd -r sambashare
	add_users_to_sambashare
	chgrp sambashare var/lib/samba/usershare
}

post_install() {
	post_upgrade
}

# ---------------------------------------------------------------------------
# Network UPS Tools
#
# Two things have to happen for NUT to be usable on a Shanios install, and
# neither can be a shipped file:
#
#  1. upsd.users and upsmon.conf's MONITOR line must share a monitor password,
#     and it must NOT be a static fleet-wide value. `upsmon master` permits a
#     forced shutdown of the UPS, so a known password on a loopback upsd is a
#     local power-off primitive — every install would ship one credential that
#     turns off every other machine's UPS. Generated once per install instead.
#  2. ups.conf has no device section (deliberately — see the file), so nothing
#     is monitoring anything yet. The units still need to be up: ALLOW_NO_DEVICE
#     is what lets upsd start with nothing to serve, so a UPS plugged in later
#     is picked up without anyone re-enabling anything.
#
# Idempotent by marker: the MONITOR insert is bracketed by BEGIN/END comments in
# the shipped upsmon.conf, and a populated bracket means "the hook already ran".
# post_install calls post_upgrade, so the package's first install and every
# upgrade both land here, and neither regenerates a credential that already
# exists.
add_nut_monitor_user() {
	# Already configured? Then leave it exactly as it is.
	if grep -qE '^[[:space:]]*MONITOR[[:space:]]' /etc/nut/upsmon.conf 2>/dev/null; then
		return 0
	fi

	local pin
	# /dev/urandom + base64, not $RANDOM: 32 random bytes, and not a value an
	# attacker can narrow by knowing roughly when the install happened.
	pin=$(head -c 32 /dev/urandom | base64 | tr -d '\n=+/' | cut -c1-24)
	if [ ${#pin} -lt 16 ]; then
		echo "shani-settings: could not generate a NUT monitor credential; UPS monitoring needs one"
		return 1
	fi

	# 0640, not world-readable: this file holds the credential that can force a
	# UPS power-down. root:nut would be tighter still, but the `nut` user is not
	# guaranteed to exist before the package's own files are in place.
	cat > /etc/nut/upsd.users <<EOF
[monuser]
	password = $pin
	upsmon master
EOF
	chmod 0640 /etc/nut/upsd.users

	# The UPS name is whatever the device section in ups.conf is called; with no
	# device configured there is none yet, so the hook writes the conventional
	# one and the user renames it with the section if they name theirs.
	local upsname=myups
	if grep -qE '^\[' /etc/nut/ups.conf 2>/dev/null; then
		upsname=$(grep -m1 -oE '^\[[^]]+\]' /etc/nut/ups.conf | tr -d '[]')
	fi

	# Insert inside the shipped markers, leaving the comments above them intact.
	python3 - /etc/nut/upsmon.conf "$upsname" "$pin" <<'PY' || return 1
import sys, pathlib
conf, name, pin = sys.argv[1], sys.argv[2], sys.argv[3]
p = pathlib.Path(conf)
text = p.read_text(encoding="utf-8")
line = f"MONITOR {name}@localhost 1 monuser {pin} master"
begin = "# BEGIN shani-settings MONITOR (generated by the install hook; do not edit by hand)"
end = "# END shani-settings MONITOR"
if begin not in text or end not in text:
    sys.exit("markers not found in upsmon.conf")
p.write_text(text.replace(end, line + "\n" + end, 1), encoding="utf-8")
PY

	echo "shani-settings: configured a NUT monitor user for '$upsname' (upsmon.conf + upsd.users)"
}

post_upgrade() {
	echo "Attempting to enable services..."
	systemctl enable btrfs-balance.timer
	systemctl enable btrfs-defrag.timer
	systemctl enable btrfs-scrub.timer
	systemctl enable btrfs-trim.timer
	systemctl enable systemd-oomd
	systemctl enable systemd-timesyncd
	systemctl enable ananicy-cpp
	systemctl enable irqbalance
	systemctl --global enable gamemoded
	plymouth-set-default-theme bgrt
	add_samba_group

	# NUT: generate the monitor credential and bring the stack up. Both halves
	# are in the hook, not in a shipped file, for the reasons in its comment.
	add_nut_monitor_user
	systemctl enable nut-server.service
	systemctl enable nut-monitor.service
	systemctl enable nut-logger.service
	systemctl enable nut-driver.target
}
