pkgbase = shani-shell
	pkgdesc = Shani shell - the AI desktop shell: bar, Chronoa Island, sidebar, dock, launcher, Lens, lock screen, polkit agent, greetd greeter and first-boot setup
	pkgver = 0.1.0
	pkgrel = 2
	url = https://github.com/shani8dev/shani-shell
	install = shani-shell.install
	arch = any
	license = GPL-3.0-only
	makedepends = git
	depends = quickshell
	depends = python
	depends = python-gobject
	depends = glib2
	depends = adwaita-icon-theme
	depends = inter-font
	depends = noto-fonts
	depends = ttf-dejavu
	depends = libnotify
	depends = wtype
	depends = libxkbcommon
	depends = xkeyboard-config
	depends = pipewire
	optdepends = shani-chronoa: the assistant behind the Island, the panel and Lens; its speech model for voice typing
	optdepends = niri: the compositor the shell is built and tested on
	optdepends = networkmanager: Wi-Fi, hotspot and VPN tiles
	optdepends = bluez: the Bluetooth tile and device list
	optdepends = upower: battery in the bar and on the lock screen
	optdepends = power-profiles-daemon: the power mode tile
	optdepends = brightnessctl: the brightness slider and the flashlight tile
	optdepends = wf-recorder: the screen record tile
	optdepends = ffmpeg: the call record tile (mic and speakers into one file)
	optdepends = speech-dispatcher: read aloud (select to speak); espeak-ng is used without it
	optdepends = espeak-ng: read aloud when speech-dispatcher is not installed
	optdepends = gnome-network-displays: the cast tile, if the Flatpak org.gnome.NetworkDisplays is not installed
	optdepends = wlsunset: the night light tile
	optdepends = iio-sensor-proxy: the auto-rotate tile (only shown with an accelerometer)
	optdepends = cliphist: clipboard history (launcher "c", the clipboard tile)
	optdepends = wl-clipboard: copying from clipboard history and the color picker
	optdepends = grim: Lens and screenshots
	optdepends = slurp: selecting a region for Lens
	optdepends = tesseract: Lens reads text (add tesseract-data-<lang> for each language)
	optdepends = tesseract-data-eng: English for Lens
	optdepends = zbar: Lens decodes QR codes and barcodes
	optdepends = gsettings-desktop-schemas: the dark style tile
	optdepends = polkit: the authentication agent
	optdepends = udisks2: removable drives in the sidebar (mount, eject)
	optdepends = unicode-emoji: emoji in the launcher (":")
	optdepends = fcitx5: input methods (Devanagari phonetic and more) shown in the bar
	optdepends = wl-mirror: mirroring a screen from the Display tile
	optdepends = shani-deploy: update status in the sidebar
	optdepends = whisper-cpp: voice typing on the screen keyboard without Chronoa (with a ggml model)
	optdepends = fd: faster file search in the launcher
	optdepends = ripgrep: faster search inside files (without localsearch)
	optdepends = localsearch: search inside files through the desktop index
	optdepends = poppler: PDF previews in the launcher (pdftoppm)
	optdepends = kdeconnect: the phone tile (battery, ring, send files and clipboard)
	optdepends = satty: annotate a screenshot from its notification
	optdepends = shani-backup: the backup tile (schedule, back up now)
	optdepends = orca: the screen reader (Accessibility tile); every shell control is labelled for it
	source = git+https://github.com/shani8dev/shani-shell.git#commit=f1f8bdc92d031b46fbc3ded375cd159e378846d9
	sha256sums = SKIP

pkgname = shani-shell
