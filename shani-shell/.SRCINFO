pkgbase = shani-shell
	pkgdesc = Shani shell - the AI desktop shell: bar, Chronoa Island, sidebar, dock, launcher, Lens, lock screen, polkit agent, greetd greeter and first-boot setup
	pkgver = 0.1.0
	pkgrel = 53
	url = https://github.com/shani8dev/shani-shell
	install = shani-shell.install
	arch = any
	license = GPL-3.0-only
	makedepends = git
	depends = quickshell
	depends = python
	depends = python-gobject
	depends = python-dbus
	depends = glib2
	depends = adwaita-icon-theme
	depends = inter-font
	depends = noto-fonts
	depends = ttf-dejavu
	depends = libnotify
	depends = libsecret
	depends = wtype
	depends = libxkbcommon
	depends = xkeyboard-config
	depends = pipewire-audio
	depends = fontconfig
	depends = qt6-multimedia
	depends = qt6-multimedia-ffmpeg
	depends = qt6-imageformats
	depends = kimageformats
	depends = libarchive
	depends = python-pymupdf
	depends = cryptsetup
	depends = poppler
	depends = e2fsprogs
	depends = openssh
	optdepends = shani-chronoa: the assistant behind the Island, the panel and Lens; its speech model for voice typing
	optdepends = mediainfo: what a video or song is made of, under its title in the Media Player
	optdepends = niri: the compositor the shell is built and tested on
	optdepends = networkmanager: Wi-Fi, hotspot and VPN tiles
	optdepends = bluez: the Bluetooth tile and device list
	optdepends = upower: battery in the bar and on the lock screen
	optdepends = power-profiles-daemon: the power mode tile
	optdepends = brightnessctl: the brightness slider and the flashlight tile
	optdepends = matugen: the adaptive palette and Aether (colours from the wallpaper)
	optdepends = geoclue: location services (auto-fill weather and night-light coordinates)
	optdepends = gpsd: a GPS receiver as the location source, ahead of GeoClue
	optdepends = wf-recorder: the screen record tile
	optdepends = ffmpeg: the call record tile (mic and speakers into one file)
	optdepends = speech-dispatcher: read aloud (select to speak); espeak-ng is used without it
	optdepends = espeak-ng: read aloud when speech-dispatcher is not installed
	optdepends = gnome-network-displays: the cast tile, if the Flatpak org.gnome.NetworkDisplays is not installed
	optdepends = wlsunset: the night light tile
	optdepends = iio-sensor-proxy: the auto-rotate tile (only shown with an accelerometer)
	optdepends = cliphist: clipboard history (launcher "c", the clipboard tile)
	optdepends = wl-clipboard: copying from clipboard history and the color picker
	optdepends = grim: Lens and screenshots
	optdepends = slurp: selecting a region for Lens
	optdepends = tesseract: Lens reads text (add tesseract-data-<lang> for each language)
	optdepends = tesseract-data-eng: English for Lens
	optdepends = zbar: Lens decodes QR codes and barcodes
	optdepends = bind: Network Tools (dig, DNS lookups)
	optdepends = iw: Network Tools (Wi-Fi scan, when NetworkManager is not there)
	optdepends = whois: Network Tools (domain whois)
	optdepends = gsettings-desktop-schemas: the dark style tile
	optdepends = polkit: the authentication agent
	optdepends = udisks2: removable drives in the sidebar (mount, eject), disk images opened as drives, USB drives written and formatted
	optdepends = sshfs: ssh:// addresses in Files > Connect to server
	optdepends = picocom: serial-port connections in Terminal
	optdepends = smartmontools: disk health and self-tests in Disks
	optdepends = sudo: validate and install sudoers drop-ins in Settings > Security
	optdepends = apparmor: AppArmor profile status and enforce/complain in Settings > Security
	optdepends = audit: auditd toggle and predefined audit profiles in Settings > Security
	optdepends = cups-browsed: discover network printers (toggle in Settings > Printers)
	optdepends = gocryptfs: encrypted folders in Files
	optdepends = gnupg: files and folders locked with a password in Files
	optdepends = rclone: cloud drives (Google Drive, OneDrive, Dropbox, Nextcloud...) in Files
	optdepends = unicode-emoji: emoji in the launcher (":") and the screen keyboard's emoji panel
	optdepends = noto-fonts-emoji: emoji drawn in colour (the launcher, the screen keyboard)
	optdepends = hunspell-en_us: word prediction and autocorrect on the screen keyboard (add hunspell-<lang> for other languages)
	optdepends = fcitx5: input methods (Devanagari phonetic and more) shown in the bar
	optdepends = wl-mirror: mirroring a screen from the Display tile
	optdepends = shani-deploy: update status in the sidebar
	optdepends = whisper-cpp: voice typing on the screen keyboard without Chronoa (with a ggml model)
	optdepends = fd: faster file search in the launcher
	optdepends = ripgrep: faster search inside files (without localsearch)
	optdepends = localsearch: search inside files through the desktop index
	optdepends = poppler: PDF previews in the launcher (pdftoppm)
	optdepends = kdeconnect: the phone tile (battery, ring, send files and clipboard)
	optdepends = satty: annotate a screenshot from its notification
	optdepends = shani-backup: the backup tile (schedule, back up now)
	optdepends = orca: the screen reader (Accessibility tile); every shell control is labelled for it
	optdepends = scrcpy: an Android phone screen in a window (control centre > Phone, launcher)
	optdepends = imagemagick: what to do with a file - convert pictures and fit a form size limit
	optdepends = ghostscript: shrink a PDF to fit a size limit, and PostScript in the Document Viewer
	optdepends = switcheroo-control: start an app on the other graphics card
	optdepends = xdg-terminal-exec: open terminal apps in the terminal you chose
	optdepends = podman: the Containers app (your containers and images)
	optdepends = distrobox: toolboxes in the Containers app
	optdepends = podlet: turn a compose file into units that start with the computer (Containers)
	optdepends = malcontent: parental controls - the launcher and dock leave out apps a standard account may not run
	optdepends = djvulibre: DjVu documents in the Document Viewer (ddjvu)
	optdepends = at-spi2-core: the menus of each app (File, Edit ...) in the window menu, read from its accessibility tree
	optdepends = swappy: mark up a screenshot before saving it
	optdepends = zenity: the snippet and compress tiles ask with a dialog
	optdepends = smbclient: Settings > Sharing lists the folders shared on the network (net usershare)
	optdepends = age: clipboard history encrypted at rest (age-encryption.org); without it the history is kept in the session keyring
	optdepends = qt6-declarative-tools: qmllint syntax check in Studio
	optdepends = pdftk: encrypt/sign PDFs in the Document Signer
	optdepends = fuse3: mounting encrypted folders and cloud drives in Files (fusermount3)
	optdepends = gjs: GNOME integration in the phone service
	optdepends = v4l-utils: the infrared remote (ir-ctl)
	optdepends = pciutils: graphics card names in Settings > About (lspci)
	optdepends = ollama: local models for the assistant
	optdepends = libpulse: volume and recording controls (pactl)
	optdepends = qrencode: QR codes in the share panel and Settings
	optdepends = sane: the Scanner app (scanimage)
	source = git+https://github.com/shani8dev/shani-shell.git#commit=ebe82d05b6daf094501a62c1e7b79971028035fb
	sha256sums = SKIP

pkgname = shani-shell
