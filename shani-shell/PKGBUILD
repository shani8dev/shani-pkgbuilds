# shani-shell PKGBUILD
# Maintainer: Shrinivas Vishnu Kumbhar <shrinivas.v.kumbhar@gmail.com>

pkgname=shani-shell
pkgver=0.1.0
pkgrel=27
pkgdesc="Shani shell - the AI desktop shell: bar, Chronoa Island, sidebar, dock, launcher, Lens, lock screen, polkit agent, greetd greeter and first-boot setup"
arch=('any')
url="https://github.com/shani8dev/shani-shell"
license=('GPL-3.0-only')
depends=(
    'quickshell'
    'python'
    'python-gobject'
    'glib2'
    # every icon is an Adwaita symbolic icon, recoloured (shell.qml's IconTheme pragma)
    'adwaita-icon-theme'
    'inter-font'
    'noto-fonts'
    'ttf-dejavu'
    # Chronoa/Lens/recorder notices
    'libnotify'
    # the screen keyboard types through the virtual-keyboard protocol, and
    # takes its layouts from xkb (libxkbcommon via ctypes, xkeyboard-config)
    'wtype'
    'libxkbcommon'
    'xkeyboard-config'
    # voice typing records with pw-record
    'pipewire'
    # the Media Player (QtMultimedia's MediaPlayer and VideoOutput, FFmpeg backend)
    'qt6-multimedia'
    'qt6-multimedia-ffmpeg'
    # Archives reads and extracts with bsdtar
    'libarchive'
)
optdepends=(
    # the Island and the conversation panel are clients of dev.shani.chronoa.Agent
    'shani-chronoa: the assistant behind the Island, the panel and Lens; its speech model for voice typing'
    # blur needs ext-background-effect-v1 or a layer-rule; niri has both
    'niri: the compositor the shell is built and tested on'
    'networkmanager: Wi-Fi, hotspot and VPN tiles'
    'bluez: the Bluetooth tile and device list'
    'upower: battery in the bar and on the lock screen'
    'power-profiles-daemon: the power mode tile'
    'brightnessctl: the brightness slider and the flashlight tile'
    'matugen: the adaptive palette and Aether (colours from the wallpaper)'
    'geoclue: location services (auto-fill weather and night-light coordinates)'
    'gpsd: a GPS receiver as the location source, ahead of GeoClue'
    'wf-recorder: the screen record tile'
    'ffmpeg: the call record tile (mic and speakers into one file)'
    'speech-dispatcher: read aloud (select to speak); espeak-ng is used without it'
    'espeak-ng: read aloud when speech-dispatcher is not installed'
    'gnome-network-displays: the cast tile, if the Flatpak org.gnome.NetworkDisplays is not installed'
    'wlsunset: the night light tile'
    'iio-sensor-proxy: the auto-rotate tile (only shown with an accelerometer)'
    'cliphist: clipboard history (launcher "c", the clipboard tile)'
    'wl-clipboard: copying from clipboard history and the color picker'
    'grim: Lens and screenshots'
    'slurp: selecting a region for Lens'
    'tesseract: Lens reads text (add tesseract-data-<lang> for each language)'
    'tesseract-data-eng: English for Lens'
    'zbar: Lens decodes QR codes and barcodes'
    'gsettings-desktop-schemas: the dark style tile'
    'polkit: the authentication agent'
    'udisks2: removable drives in the sidebar (mount, eject)'
    'unicode-emoji: emoji in the launcher (":")'
    'fcitx5: input methods (Devanagari phonetic and more) shown in the bar'
    'wl-mirror: mirroring a screen from the Display tile'
    'shani-deploy: update status in the sidebar'
    'whisper-cpp: voice typing on the screen keyboard without Chronoa (with a ggml model)'
    'fd: faster file search in the launcher'
    'ripgrep: faster search inside files (without localsearch)'
    'localsearch: search inside files through the desktop index'
    'poppler: PDF previews in the launcher (pdftoppm)'
    'kdeconnect: the phone tile (battery, ring, send files and clipboard)'
    'satty: annotate a screenshot from its notification'
    'shani-backup: the backup tile (schedule, back up now)'
    'orca: the screen reader (Accessibility tile); every shell control is labelled for it'
    'scrcpy: an Android phone screen in a window (control centre > Phone, launcher)'
    'imagemagick: what to do with a file - convert pictures and fit a form size limit'
    'ghostscript: shrink a PDF to fit a size limit'
    'switcheroo-control: start an app on the other graphics card'
    'xdg-terminal-exec: open terminal apps in the terminal you chose'
    'malcontent: parental controls - the launcher and dock leave out apps a standard account may not run'
)
makedepends=('git')
install=$pkgname.install
source=("git+https://github.com/shani8dev/shani-shell.git#commit=b0c24c4cc41dc7dcad2521fe69e37893a5552449")
# git+ pinned to a commit: the pin is the integrity anchor for a VCS source.
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname"

    # `qs -c shani` searches every XDG config dir, so /etc/xdg is the system
    # copy and ~/.config/quickshell/shani still overrides it per user.
    install -d "$pkgdir/etc/xdg/quickshell"
    cp -r shani "$pkgdir/etc/xdg/quickshell/shani"
    # the greetd greeter is a second config (`qs -c shani-greeter`); its Common/
    # is a symlink to the shell's in the repo, copied in here so the greeter
    # does not depend on the shell's directory layout
    cp -rL greeter "$pkgdir/etc/xdg/quickshell/shani-greeter"
    # first-boot setup (`qs -c shani-setup`), run by the greeter niri while the
    # machine has no account; same Common/ copy as the greeter
    cp -rL setup "$pkgdir/etc/xdg/quickshell/shani-setup"
    find "$pkgdir/etc/xdg/quickshell" -type d -exec chmod 755 {} +
    find "$pkgdir/etc/xdg/quickshell" -type f -exec chmod 644 {} +

    # the lock screen's PAM stack (Modules/Lock/LockScreen.qml: config "shani-lock")
    install -Dm644 data/pam.d/shani-lock "$pkgdir/etc/pam.d/shani-lock"
    install -Dm644 data/pam.d/shani-lock-biometric "$pkgdir/etc/pam.d/shani-lock-biometric"
    # the default pair plus the night art for the picker (assets/make-wallpapers.py
    # renders them; dark is the amber dusk, so the shipped look carries the brand)
    install -Dm644 assets/shani-dark.jpg "$pkgdir/usr/share/backgrounds/shani/shani-dark.jpg"
    install -Dm644 assets/shani-night.jpg "$pkgdir/usr/share/backgrounds/shani/shani-night.jpg"
    install -Dm644 assets/shani-light.jpg "$pkgdir/usr/share/backgrounds/shani/shani-light.jpg"

    # Everything in bridge/, by glob and not by name. The list used to be kept
    # by hand and drifted: chronoa-bridge.py imports screensaver.py from its
    # own directory, which was never listed, so the packaged bridge died at
    # import (no Island, no lock on suspend); characters.py was missing too,
    # leaving the Characters surface empty. What each one is for is in its
    # own docstring. The privileged ones (first-account.py, shani-admin.py)
    # run through pkexec under shani-desktop-niri's polkit rules.
    install -d "$pkgdir/usr/lib/$pkgname"
    install -m755 -t "$pkgdir/usr/lib/$pkgname" bridge/*.py
    # "What's new" after an update: the notification's "See everything"
    install -Dm644 data/whats-new.md "$pkgdir/usr/share/shani/whats-new.md"
    # patch the service file to use the renamed launcher (avoids a file
    # conflict with shani-chronoa, which also ships /usr/bin/shani-chronoa-bridge)
    sed -i 's/shani-chronoa-bridge/shani-shell-chronoa-bridge/g' \
        data/systemd/shani-chronoa-bridge.service
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/shani-shell-chronoa-bridge" <<SH
#!/bin/sh
exec /usr/bin/python3 /usr/lib/$pkgname/chronoa-bridge.py "\$@"
SH
    # The self-check doctor: verifies all external tools shani-shell needs
    # are installed, one per feature, with distro install commands for
    # anything missing.
    install -Dm755 bin/shani-doctor.py "$pkgdir/usr/bin/shani-doctor"
    # the agent command center (`shani`): one CLI over the shell IPC
    install -Dm755 bin/shani "$pkgdir/usr/bin/shani"
    # the shell's own apps (Text Editor, Files, Calculator, …) as desktop
    # entries, written from the same table `shani app` starts them from: the
    # launcher's app list, dock pins, "Open with" and default apps read these
    python3 bin/shani app --write-desktop "$pkgdir/usr/share/applications"

    install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
        data/systemd/shani-shell.service data/systemd/shani-chronoa-bridge.service
}
