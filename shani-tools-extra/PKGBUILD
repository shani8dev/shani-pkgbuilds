pkgname=shani-tools-extra
pkgver=1.2
pkgrel=12
pkgdesc="Extra Tools for Shani OS"
arch=('any')
url="https://github.com/shani8dev/shani-pkgbuilds/tree/main/shani-tools-extra"
depends=(
    # System info & monitoring
    inxi
    htop
    fastfetch
    tree
    dmidecode
    strace
    lsof
    ncdu
    sysstat
    smartmontools
    lm_sensors
    ddcutil
    liquidctl

    # Scheduling & logging
    cronie
    logrotate

    # Terminal utilities
    expect
    dialog
    pv
    jq
    micro
    texinfo
    tealdeer      # `tldr <cmd>` example pages
    ripgrep       # rg; was only on Plasma, pulled in transitively by KTextEditor
    man-pages     # Linux/POSIX section 2/3/7 pages (man-db alone has none)

    # Version control
    subversion
    mercurial

    # Android
    android-tools

    # Archive tools
    7zip
    arj
    unrar
    unarchiver
    unzip
    unace
    zip
    lrzip
    lzop
    elfutils

    # GPU & hardware diagnostics
    vulkan-tools
    mesa-utils
    clinfo
)
license=('GPL-3.0-only')
install="$pkgname.install"
