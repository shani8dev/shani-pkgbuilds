	# Restored after the audit was rechecked: rclone (skills/cloud_files.py
	# runs it), wireshark-cli (tshark for skills/dissect_traffic.py) and
	# caddy/cloudflared (Cassini tabs invoke them) are all really used.
	# The rest of the trim stands: iftop, bandwhich, traceroute, arpwatch,
	# aria2, socat, ngrep, gobuster - invoked nowhere in Chronoa, Cassini,
	# the shell or shani-link. zsync stays (shani-deploy needs it).
	rclone
	wireshark-cli
	caddy
	cloudflared
	ethtool
	net-tools
	nmap
	whois
	wireless_tools
	tcpdump
	vnstat
	inetutils
	usbutils
	bind
	openbsd-netcat
	curl
	wget
	nbd
	rsync
	zsync
	iperf3
	mtr
	nethogs
	restic
	tailscale
	arp-scan
)
