# Maintainer: Shrinivas Kumbhar <shrinivasvkumbhar@gmail.com>
# shani-voice-models: the offline voice stack for ShaniOS, installed where
# Shani Chronoa already looks for it on a system install:
#   /usr/share/whisper/models/ggml-base-q5_1.bin  (stt_provision._SYSTEM_DIR)
#   /usr/bin/piper-tts                            (voices.piper_binary)
#   /usr/share/piper/voices/en_US-lessac-medium.* (tts.py)
# Without this package the first utterance downloads ~230 MB from
# Hugging Face / GitHub releases, digest-verified, and voice needs the
# network at all. With it, speech in and out work offline from first boot.
#
# Sources, adapted from three AUR PKGBUILDs (piper-tts-bin,
# piper-voices-en-us, whisper.cpp-model-base-q5_1) - every digest below is
# byte-identical to the file Shani Chronoa's own provisioner pins, so the
# packaged bytes are the same bytes a first-use download would verify to.
#
# Exactly ONE piper voice ships: en_US-lessac-medium, Chronoa's default.
# Chip-wide voice selection is a later decision, not a silent default.
pkgname=shani-voice-models
pkgver=1.0
pkgrel=1
pkgdesc="Offline voice models for ShaniOS: Whisper base-q5_1, Piper TTS and the Lessac voice"
arch=('x86_64')
url="https://github.com/shani8dev/shani-chronoa"
license=('MIT')
depends=('gcc-libs' 'glibc')
provides=('piper-tts')
conflicts=('piper-tts-bin' 'piper-tts-git')
source=("piper_linux_x86_64.tar.gz::https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz"
        "en_US-lessac-medium.onnx::https://huggingface.co/rhasspy/piper-voices/resolve/c10ece1aade47bb51c153c893d14e5bf8e5b7117/en/en_US/lessac/medium/en_US-lessac-medium.onnx"
        "en_US-lessac-medium.onnx.json::https://huggingface.co/rhasspy/piper-voices/resolve/c10ece1aade47bb51c153c893d14e5bf8e5b7117/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json"
        "ggml-base-q5_1.bin::https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base-q5_1.bin"
        "piper-tts.sh")
sha256sums=('a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992'
            '5efe09e69902187827af646e1a6e9d269dee769f9877d17b16b1b46eeaaf019f'
            'efe19c417bed055f2d69908248c6ba650fa135bc868b0e6abb3da181dab690a0'
            '422f1ae452ade6f30a004d7e5c6a43195e4433bc370bf23fac9cc591f01a8898'
            '79fef77f228423f8f6f54fe1be7d726c96b2c9f1ac849a9386fdd85886463aa9')

package() {
  # Piper: prebuilt tarball, wrapped for LD_LIBRARY_PATH (upstream layout)
  install -d -m755 "$pkgdir"/opt "$pkgdir"/usr/bin
  mv "$srcdir"/piper "$pkgdir"/opt/piper-tts
  install -Dm755 "$srcdir"/piper-tts.sh "$pkgdir"/usr/bin/piper-tts

  # One voice: Chronoa's default (en_US-lessac-medium)
  install -Dm644 "$srcdir"/en_US-lessac-medium.onnx "$pkgdir"/usr/share/piper/voices/en_US-lessac-medium.onnx
  install -Dm644 "$srcdir"/en_US-lessac-medium.onnx.json "$pkgdir"/usr/share/piper/voices/en_US-lessac-medium.onnx.json

  # Whisper: the default STT model, where stt_provision looks for it system-wide
  install -Dm644 "$srcdir"/ggml-base-q5_1.bin "$pkgdir"/usr/share/whisper/models/ggml-base-q5_1.bin
}
